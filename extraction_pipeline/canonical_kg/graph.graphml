_canonical">has allowed CISA to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["has allowed CISA to"]</data></edge><edge id="oe_db91f2da5de6d0f7" source="e_45920ded90b221d6" target="e_881a3fc8b14e4814"><data key="edge_predicate_raw">has allowed CISA to</data><data key="edge_assertion_id">a_7b9b6d2600e69e02</data><data key="edge_source_id">S53</data><data key="edge_source_url">https://www.cisa.gov/stakeholder-specific-vulnerability-categorization-ssvc</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Implementing SSVC has allowed CISA to better prioritize its vulnerability response and vulnerability messaging to the public</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">has allowed CISA to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["has allowed CISA to"]</data></edge><edge id="oe_f38650eb6d03e02c" source="e_f6498126c94c6f96" target="e_74fdbfd8a09b762c"><data key="edge_predicate_raw">decide on vulnerability response actions consistent with</data><data key="edge_assertion_id">a_2f4be1a01ac1d3aa</data><data key="edge_source_id">S53</data><data key="edge_source_url">https://www.cisa.gov/stakeholder-specific-vulnerability-categorization-ssvc</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Furthermore, the SSVC is a vulnerability prioritization methodology that helps an analyst decide on vulnerability response actions consistent with priorities agreed with the analyst’s leadership</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">decide on vulnerability response actions consistent with</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["decide on vulnerability response actions consistent with"]</data></edge><edge id="oe_4ed04d7f31d82e59" source="e_6f7684418f21aa11" target="e_bff69c3f6cee6d2b"><data key="edge_predicate_raw">Uses</data><data key="edge_assertion_id">a_fcba1b85b35f3d22</data><data key="edge_source_id">S53</data><data key="edge_source_url">https://www.cisa.gov/stakeholder-specific-vulnerability-categorization-ssvc</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">How CISA Uses SSVC</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">use</data><data key="edge_domain">Organization</data><data key="edge_range">Mention</data><data key="edge_derived_from">["use", "uses", "do use", "Uses"]</data></edge><edge id="oe_ff3008b7b1cb1035" source="e_6f7684418f21aa11" target="e_f71a4f75f05a5cfe"><data key="edge_predicate_raw">uses</data><data key="edge_assertion_id">a_536335f0c2033656</data><data key="edge_source_id">S53</data><data key="edge_source_url">https://www.cisa.gov/stakeholder-specific-vulnerability-categorization-ssvc</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">CISA uses its own SSVC decision tree model to prioritize relevant vulnerabilities into four possible decisions:</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">use</data><data key="edge_domain">Organization</data><data key="edge_range">Mention</data><data key="edge_derived_from">["use", "uses", "do use", "Uses"]</data></edge><edge id="oe_56c82aa3ef756dbb" source="e_4f99a70924824209" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">continue to track</data>