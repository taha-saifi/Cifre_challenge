w">be produce severity more accurate for</data><data key="edge_assertion_id">a_6f4967c93a34dac9</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers of CVSS should supplement the Base Score with Temporal and Environmental Scores specific to their use of the vulnerable product to produce a severity more accurate for their organizational environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be produce severity more accurate for</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be produce severity more accurate for"]</data></edge><edge id="oe_56ee4fb6383ec605" source="e_f7f0082982beecc7" target="e_5686e5c631b8054e"><data key="edge_predicate_raw">use CVSS information as</data><data key="edge_assertion_id">a_0eae21f5dc360eeb</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers may use CVSS information as input to an organizational vulnerability management process that also considers factors that are not part of CVSS in order to rank the threats to their technology infrastructure and make informed remediation decisions</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">use CVSS information as</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["use CVSS information as"]</data></edge><edge id="oe_205a96a12309b6b5" source="e_f7f0082982beecc7" target="e_0becd7248453c60e"><data key="edge_predicate_raw">use</data><data key="edge_assertion_id">a_35262039a941f69b</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers may use CVSS information as input to an organizational vulnerability management process that also considers factors that are not part of CVSS in order to rank the threats to their technology infrastructure and make informed remediation decisions</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">use</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["use", "uses", "do use", "Uses"]</data></edge><edge id="oe_10210f61adb28ee3" source="e_8e874df517877380" target="e_3cf72a85fc7edc64"><data key="edge_predicate_raw">are part of</data><data key="edge_assertion_id">a_9f05e07bd9cf6baf</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers may use CVSS information as input to an organizational vulnerability management process that also considers factors that are not part of CVSS in order to rank the threats to their technology infrastructure and make informed remediation decisions</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">are part of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are part of", "is part of"]</data></edge><edge id="oe_dbf4b065550f3