"edge_assertion_id">a_b40072f484160d28</data><data key="edge_source_id">S17</data><data key="edge_source_url">https://diesec.com/2026/08/top-5-cybersecurity-news-stories-august-21-2026/</data><data key="edge_chunk_id">S17_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Affected versions include SharePoint Server Subscription Edition, SharePoint Server 2019, and SharePoint Enterprise Server 2016</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">include</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["include", "includes"]</data></edge><edge id="oe_c64a11055776e963" source="e_0f1f7e6a36f6f4e2" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">are facing</data><data key="edge_assertion_id">a_fd6cdf72763325ab</data><data key="edge_source_id">S17</data><data key="edge_source_url">https://diesec.com/2026/08/top-5-cybersecurity-news-stories-august-21-2026/</data><data key="edge_chunk_id">S17_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Organisations that had not applied the July patches on the assumption that “no active exploits” meant “no urgency” are now facing a vulnerability that requires no credentials, no user interaction, and no exploit chain beyond a forged token</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are facing</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are facing"]</data></edge><edge id="oe_37e3fdb61d81a830" source="e_0d68f6f8abf7f70b" target="e_b20537ab7d2c35cc"><data key="edge_predicate_raw">has become</data><data key="edge_assertion_id">a_6f51d821143fb36d</data><data key="edge_source_id">S17</data><data key="edge_so