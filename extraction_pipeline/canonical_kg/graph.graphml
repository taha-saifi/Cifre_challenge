id">S54_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">CISA recommends remediating Track vulnerabilities within standard</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">recommends</data><data key="edge_domain">Organization</data><data key="edge_range">Mention</data><data key="edge_derived_from">["recommends"]</data></edge><edge id="oe_2a11ba07e6a7fa68" source="e_6f7684418f21aa11" target="e_e0f417f29d579b9b"><data key="edge_predicate_raw">recommends</data><data key="edge_assertion_id">a_4b4eb7c1f1ed1687</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">CISA recommends remediating Track* vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">recommends</data><data key="edge_domain">Organization</data><data key="edge_range">Mention</data><data key="edge_derived_from">["recommends"]</data></edge><edge id="oe_94fcbb880209a88c" source="e_75568361ea1785e9" target="e_98d7c6bf277bf090"><data key="edge_predicate_raw">requires attention from</data><data key="edge_assertion_id">a_d86ebded6b376e3f</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Attend The vulnerability requires attention from the organization's internal,</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">requires attention from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["requires attention from"]</data></edge><edge id="oe_5877d69a9274d555" source="e_14268cc67503c40c" target="e_90670029cbbcc810"><data key="edge_predicate_raw">include</data><data key="edge_assertion_id">a_f68f737514603bd4</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Necessary actions may include requesting</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">include</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["include", "includes"]</data></edge><edge id="oe_9d976853ff8379a4" source="e_4ece8bfd662b28e6" target="e_98d7c6bf277bf090"><data key="edge_predicate_raw">requires attention from</data><data key="edge_assertion_id">a_3735ef66cf34fdea</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Act The vulnerability requires attention from the organization's internal,</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">requires attention from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["requires attention from"]</data></edge><edge id="oe_e8aaec1c080a6a8c" source="e_b7927de46cff526a" target="e_6549425c283cdd04"><data key="edge_predicate_raw">meet to determine</data><data key="edge_assertion_id">a_469ae28c9bdbe6d8</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">groups would meet to determine the overall response and then execute agreed</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">meet to determine</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["meet to determine"]</data></edge><edge id="oe_1f8cb4a8ce9b29d6" source="e_b7927de46cff526a" target="e_24d374622b46aa64"><data key="edge_predicate_raw">meet</data><data key="edge_assertion_id">a_e46876f0f0939c62</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">groups would meet to determine the overall response and then execute agreed</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">meet</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["meet"]</data></edge><edge id="oe_3e7fe5645b99a2e7" source="e_6f7684418f21aa11" target="e_c2d8486eaa292765"><data key="edge_predicate_raw">recommends</data><data key="edge_assertion_id">a_2888d590c3664dfe</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">CISA recommends remediating Act vulnerabilities as soon as</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">recommends</data><data key="edge_domain">Organization</data><data key="edge_range">Mention</data><data key="edge_derived_from">["recommends"]</data></edge><edge id="oe_a55e29a533b82865" source="e_4f99a70924824209" target="e_93d265501db78408"><data key="edge_predicate_raw">determine</data><data key="edge_assertion_id">a_900a4dad851a83a5</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">An organization can determine a vulnerability's scope by</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">determine</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["determine", "determines"]</data></edge><edge id="oe_e12c89433688fa32" source="e_e7af4632d6017fc9" target="e_0cb921fff571300d"><data key="edge_predicate_raw">is analyzed as</data><data key="edge_assertion_id">a_822cbff4332ed8f4</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">presence across multiple related systems—is analyzed as one or multiple vulnerabilities will also help an organization</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is analyzed as</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is analyzed as"]</data></edge><edge id="oe_e74b04fc3438d351" source="e_9da0a3af79887332" target="e_4f99a70924824209"><data key="edge_predicate_raw">help</data><data key="edge_assertion_id">a_6ee90b18c5fb04b2</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">presence across multiple related systems—is analyzed as one or multiple vulnerabilities will also help an organization</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">help</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["help"]</data></edge><edge id="oe_f058786be462a63c" source="e_dbd1ba0cc63988dc" target="e_4dac9c64efc512d2"><data key="edge_predicate_raw">be scoring</data><data key="edge_assertion_id">a_1420a20472e8a768</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">CISA uses the following decision points and associated values for making vulnerability scoring decisions (outlined in</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be scored</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be scored", "be scoring"]</data></edge><edge id="oe_336ffca829a75984" source="e_6f7684418f21aa11" target="e_53b26aeaa91aed80"><data key="edge_predicate_raw">uses following decision points for</data><data key="edge_assertion_id">a_540dc79253c0d2a8</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">CISA uses the following decision points and associated values for making vulnerability scoring decisions (outlined in</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">uses following decision points for</data><data key="edge_domain">Organization</data><data key="edge_range">Mention</data><data key="edge_derived_from">["uses following decision points for"]</data></edge><edge id="oe_69f5605224da7c47" source="e_6f7684418f21aa11" target="e_6778b077854c432e"><data key="edge_predicate_raw">uses</data><data key="edge_assertion_id">a_96480b432c3657f9</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">CISA uses the following decision points and associated values for making vulnerability scoring decisions (outlined in</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">use</data><data key="edge_domain">Organization</data><data key="edge_range">Mention</data><data key="edge_derived_from">["use", "uses", "do use", "Uses"]</data></edge><edge id="oe_385a0d8379888b57" source="e_6f7684418f21aa11" target="e_185c2031cf035006"><data key="edge_predicate_raw">identifies value Instead of declaring decision point as</data><data key="edge_assertion_id">a_989181c25add9b34</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Instead of declaring a decision point as “unknown,” CISA identifies the value that is the most reasonable assumption</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">uncertain</data><data key="edge_predicate_canonical">identifies value Instead of declaring decision point as</data><data key="edge_domain">Organization</data><data key="edge_range">Mention</data><data key="edge_derived_from">["identifies value Instead of declaring decision point as"]</data></edge><edge id="oe_768c196938ddac61" source="e_6f7684418f21aa11" target="e_47869b8b12d1452e"><data key="edge_predicate_raw">identifies</data><data key="edge_assertion_id">a_29119de33ff19fc2</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Instead of declaring a decision point as “unknown,” CISA identifies the value that is the most reasonable assumption</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">uncertain</data><data key="edge_predicate_canonical">identifies</data><data key="edge_domain">Organization</data><data key="edge_range">Mention</data><data key="edge_derived_from">["identifies", "identify"]</data></edge><edge id="oe_796c4c15958c3830" source="e_f06be94522d51d45" target="e_1e8fc3121cd402ea"><data key="edge_predicate_raw">change</data><data key="edge_assertion_id">a_6f6960cbca882c4b</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Such an approach requires reliable historical evidence and future events may change these</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">change</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["change", "changes"]</data></edge><edge id="oe_24cfefb9abcdd9f0" source="e_92ebed9c81e58271" target="e_1e8fc3121cd402ea"><data key="edge_predicate_raw">change</data><data key="edge_assertion_id">a_8d7bcd2810adb14c</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Such an approach requires reliable historical evidence and future events may change these</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">change</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["change", "changes"]</data></edge><edge id="oe_85c4d6f31b48a798" source="e_6a16eec4a6620da9" target="e_7f5400296a550f83"><data key="edge_predicate_raw">determines</data><data key="edge_assertion_id">a_a8310ea98043c867</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">This measure determines the present state of exploitation of the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">determine</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["determine", "determines"]</data></edge><edge id="oe_ece06c1f3f8a03b2" source="e_ad16450d4d7b98f8" target="e_3cdaf77104cba27b"><data key="edge_predicate_raw">acknowledges</data><data key="edge_assertion_id">a_545562122588de1a</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">measure feasibility or ease of adversary development of future exploit code; rather, it acknowledges available</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">acknowledges</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["acknowledges"]</data></edge><edge id="oe_dd67569076b5aaf9" source="e_5e998a68dfa7d58d" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">changes over</data><data key="edge_assertion_id">a_7631b04f2259ac0a</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">As the current state of exploitation often changes over time, answers should be time-</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">change over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["change over", "changes over", "do change over"]</data></edge><edge id="oe_de90f2dd598ce699" source="e_35fae251eb2f23d0" target="e_50acfc6f3f4af374"><data key="edge_predicate_raw">include</data><data key="edge_assertion_id">a_3c40992100850913</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Sources that can provide public reporting of active exploitation include the vendor’s vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">include</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["include", "includes"]</data></edge><edge id="oe_0303706af7a52a10" source="e_35fae251eb2f23d0" target="e_2e00ee038b7f0c0d"><data key="edge_predicate_raw">provide public reporting of</data><data key="edge_assertion_id">a_580af07afe482a39</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Sources that can provide public reporting of active exploitation include the vendor’s vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">provide public reporting of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["provide public reporting of"]</data></edge><edge id="oe_ce25f1982b01e36b" source="e_1a9bea9d95930119" target="e_2229d527cdc7046b"><data key="edge_predicate_raw">be serving as</data><data key="edge_assertion_id">a_3c9a2cc4faf519b5</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">Wireshark serving as a PoC for packet replay attacks on ethernet or Wi-Fi</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be serving as</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be serving as"]</data></edge><edge id="oe_6a91e4364b465b2b" source="e_1a9bea9d95930119" target="e_c2bdf8cb88a2dbf7"><data key="edge_predicate_raw">be serving as</data><data key="edge_assertion_id">a_9504802146985d89</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">Wireshark serving as a PoC for packet replay attacks on ethernet or Wi-Fi</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be serving as</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be serving as"]</data></edge><edge id="oe_60f75fa39a4dff0f" source="e_b8e5aea7bbbe87ad" target="e_96706e99cf570ef8"><data key="edge_predicate_raw">is important When</data><data key="edge_assertion_id">a_aafe01821256ecb0</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">When evaluating technical impact, the definition of scope is particularly important</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is important When</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is important When"]</data></edge><edge id="oe_7a7159f3cb961f7c" source="e_dbd1ba0cc63988dc" target="e_6c2e5c0da8ae7238"><data key="edge_predicate_raw">resides</data><data key="edge_assertion_id">a_af395b37a2c25234</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">relative to the affected component where the vulnerability resides</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">resides</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["resides"]</data></edge><edge id="oe_c141c53274cc1f89" source="e_dbd1ba0cc63988dc" target="e_98419d6c0bf73fb9"><data key="edge_predicate_raw">discloses</data><data key="edge_assertion_id">a_a4beaa218dd920d0</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">If a vulnerability discloses authentication or</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">discloses</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["discloses"]</data></edge><edge id="oe_bf23b6176f2126ae" source="e_47b563a1bc34544b" target="e_bb686a7b9d06429d"><data key="edge_predicate_raw">be scored</data><data key="edge_assertion_id">a_5326642d5787ee7b</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">authorization credentials to the system, this information disclosure should also be scored as “Total” if those</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be scored</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be scored", "be scoring"]</data></edge><edge id="oe_b5af323a944b31b9" source="e_369bd17212f6a742" target="e_b949320ce0e8e557"><data key="edge_predicate_raw">be overcome</data><data key="edge_assertion_id">a_b29dd0157eaf3422</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">make enough attempts to overcome obstacles, either physical or security-based,</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be overcome</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be overcome"]</data></edge><edge id="oe_4dd9acca25d446ba" source="e_7a31e528d22c7737" target="e_fbcd10d66336c321"><data key="edge_predicate_raw">is form of</data><data key="edge_assertion_id">a_f00e6f8e4df4095f</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">A denial-of-service attack is a form of limited control over</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is form of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is form of"]</data></edge><edge id="oe_c471fc2e7c513adc" source="e_18841dde18fba216" target="e_62829ba8b29f40f6"><data key="edge_predicate_raw">cause exploitation events</data><data key="edge_assertion_id">a_97df0fb6361d24c4</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">Automatable represents the ease and speed with which a cyber threat actor can cause exploitation events</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">cause exploitation events</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["cause exploitation events"]</data></edge><edge id="oe_81207ffd2fe4df3e" source="e_18841dde18fba216" target="e_c7485b8acee88b97"><data key="edge_predicate_raw">cause exploitation events</data><data key="edge_assertion_id">a_9df292b5fb3a0261</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">Automatable represents the ease and speed with which a cyber threat actor can cause exploitation events</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">cause exploitation events</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["cause exploitation events"]</data></edge><edge id="oe_73339d6aeaca9476" source="e_537e6ab50e8f2e44" target="e_d39636d70f9668db"><data key="edge_predicate_raw">automate</data><data key="edge_assertion_id">a_c255bf4173fa0267</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">Automatable captures the answer to the question, “Can an attacker reliably automate, creating exploitation events for</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">automate</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["automate"]</data></edge><edge id="oe_84179e284ca72241" source="e_4a440f0d7f548662" target="e_a102fd490e52b376"><data key="edge_predicate_raw">need to write</data><data key="edge_assertion_id">a_1ae8c0d167503b8d</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">include attack complexity, the specific code an actor would need to write or configure themselves, and the usual</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">need to write</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["need to write"]</data></edge><edge id="oe_c8b4b6cc4582bcbc" source="e_0dd1994901856e68" target="e_3b69372d8c57f522"><data key="edge_predicate_raw">prevents vulnerability from</data><data key="edge_assertion_id">a_9111c7ff5307fa64</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">authenticated and logged in, that usually prevents a vulnerability from being wormable</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">prevents vulnerability from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["prevents vulnerability from"]</data></edge><edge id="oe_81b4e4be1fa84aba" source="e_1b6f531078fc8ef6" target="e_ca88e2447b7b3144"><data key="edge_predicate_raw">gives attacker</data><data key="edge_assertion_id">a_e7a26956d9eeb3e3</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">system has another unpatched vulnerability that remotely and easily gives an attacker a guest account or otherwise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">gives attacker</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["gives attacker"]</data></edge><edge id="oe_8925ca0b9a06fb45" source="e_1b6f531078fc8ef6" target="e_02f0f8280e1d2c2c"><data key="edge_predicate_raw">gives attacker</data><data key="edge_assertion_id">a_afac0a790f58d03b</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">system has another unpatched vulnerability that remotely and easily gives an attacker a guest account or otherwise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">gives attacker</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["gives attacker"]</data></edge><edge id="oe_681ce8d54c311954" source="e_1b6f531078fc8ef6" target="e_ce42f1740079c44d"><data key="edge_predicate_raw">gives attacker</data><data key="edge_assertion_id">a_ea61fedb664d88cf</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">system has another unpatched vulnerability that remotely and easily gives an attacker a guest account or otherwise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">gives attacker</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["gives attacker"]</data></edge><edge id="oe_8841654865f63a38" source="e_1b6f531078fc8ef6" target="e_271cee6a0797524a"><data key="edge_predicate_raw">gives attacker</data><data key="edge_assertion_id">a_891c34db8d913d36</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">system has another unpatched vulnerability that remotely and easily gives an attacker a guest account or otherwise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">gives attacker</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["gives attacker"]</data></edge><edge id="oe_35d0a266d23ae6b3" source="e_1b6f531078fc8ef6" target="e_c09d46a525f6a26e"><data key="edge_predicate_raw">gives attacker</data><data key="edge_assertion_id">a_db7bdde95fe63668</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">system has another unpatched vulnerability that remotely and easily gives an attacker a guest account or otherwise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">gives attacker</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["gives attacker"]</data></edge><edge id="oe_716c843f02ec1882" source="e_1b6f531078fc8ef6" target="e_59be95a76044f5f2"><data key="edge_predicate_raw">gives attacker</data><data key="edge_assertion_id">a_ede88ffc68949eef</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">system has another unpatched vulnerability that remotely and easily gives an attacker a guest account or otherwise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">gives attacker</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["gives attacker"]</data></edge><edge id="oe_0de0fae387e804ef" source="e_9f4bc004f1ab89c0" target="e_ab37797b297865c8"><data key="edge_predicate_raw">be make</data><data key="edge_assertion_id">a_d89470346063f2f4</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">vulnerabilities to make exploitation automatable, as discussed further below</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be make</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be make"]</data></edge><edge id="oe_17f5ae8f385a4d4c" source="e_0651ca14b1e582f2" target="e_f26720649f642157"><data key="edge_predicate_raw">does have open connectivity to</data><data key="edge_assertion_id">a_5f87fe5c87c23125</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">Another example of a barrier is if the vulnerable component does not normally have open connectivity to the internet</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">does have open connectivity to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["does have open connectivity to"]</data></edge><edge id="oe_90b09b8fe01c3bbf" source="e_0651ca14b1e582f2" target="e_f26720649f642157"><data key="edge_predicate_raw">is exposed to</data><data key="edge_assertion_id">a_e32f9ab187f7cba8</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">whether the vulnerable component is commonly exposed to the internet by other operators</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is exposed to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is exposed to"]</data></edge><edge id="oe_63f2c8d6e65bbba1" source="e_0651ca14b1e582f2" target="e_f7badda21c0f35c3"><data key="edge_predicate_raw">is exposed to internet by</data><data key="edge_assertion_id">a_0c996b42b872eefa</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">whether the vulnerable component is commonly exposed to the internet by other operators</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is exposed to internet by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is exposed to internet by"]</data></edge><edge id="oe_f5aeb80e868d9965" source="e_f6498126c94c6f96" target="e_7f7f6fbf3a1e3179"><data key="edge_predicate_raw">has best understanding of</data><data key="edge_assertion_id">a_c60068af1e4ecf25</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">should capture the analyst's best understanding of plausible scenarios at the time of the analysis</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">has best understanding of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["has best understanding of"]</data></edge><edge id="oe_22715eddae59dae2" source="e_ae5954b373682db6" target="e_a7523256c9515f68"><data key="edge_predicate_raw">be perform</data><data key="edge_assertion_id">a_a5a083a1f4b606d5</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">Vulnerability B to easily get into the target network and then use Vulnerability A to perform remote code execution</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be perform</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be perform"]</data></edge><edge id="oe_c1b95f14133faa61" source="e_3068da8f4844da53" target="e_794eacf546214ced"><data key="edge_predicate_raw">be achieve</data><data key="edge_assertion_id">a_b5a47d8759080cbd</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">The use of multiple vulnerabilities to achieve an overall outcome is known as "vulnerability chaining." SSVC lets</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be achieve</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be achieve"]</data></edge><edge id="oe_f3178ecc6478ec4d" source="e_4f99a70924824209" target="e_9b76083ba3f21406"><data key="edge_predicate_raw">perform In</data><data key="edge_assertion_id">a_104122512c209dcc</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">In contrast to non-essential functions, an organization “must perform a [MEF] during a disruption to normal</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">perform In</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["perform In"]</data></edge><edge id="oe_fe33f6f4924ec41b" source="e_4f99a70924824209" target="e_206b43150a3ee04c"><data key="edge_predicate_raw">perform during</data><data key="edge_assertion_id">a_69dacb66e503106c</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">In contrast to non-essential functions, an organization “must perform a [MEF] during a disruption to normal</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">perform during</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["perform during"]</data></edge><edge id="oe_c7b007969edb91d7" source="e_4f99a70924824209" target="e_e03236cb54bb68ce"><data key="edge_predicate_raw">exists</data><data key="edge_assertion_id">a_14ed7dfbf636b029</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">operations.”3 The mission is the reason an organization exists, and MEFs are how that mission is realized</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">exists</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["exists"]</data></edge><edge id="oe_e730c1e34d8016a4" source="e_0651ca14b1e582f2" target="e_a94e337fe8f76895"><data key="edge_predicate_raw">supports MEFs</data><data key="edge_assertion_id">a_9641aa6a77ef5758</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">Support The vulnerable component only supports MEFs for two or more entities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">supports MEFs</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["supports MEFs"]</data></edge><edge id="oe_cff5743d0deeaca5" source="e_0651ca14b1e582f2" target="e_e325024986b2f6b5"><data key="edge_predicate_raw">supports MEFs for</data><data key="edge_assertion_id">a_c54bfef21e50ff6c</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">Support The vulnerable component only supports MEFs for two or more entities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">supports MEFs for</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["supports MEFs for"]</data></edge><edge id="oe_81ab0476227d237a" source="e_0651ca14b1e582f2" target="e_5808effc7934a29b"><data key="edge_predicate_raw">supports MEFs</data><data key="edge_assertion_id">a_affd9dd99a6e807a</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">Support The vulnerable component only supports MEFs for two or more entities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">supports MEFs</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["supports MEFs"]</data></edge><edge id="oe_eb465ddd8551efda" source="e_0651ca14b1e582f2" target="e_4d85ed61fba30342"><data key="edge_predicate_raw">provides</data><data key="edge_assertion_id">a_92d48f0e661b1508</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">The vulnerable component directly provides capabilities that constitute at least one MEF</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">provides</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["provides", "provide"]</data></edge><edge id="oe_2d7488881ce42de5" source="e_9cf6115194c774a5" target="e_14c6542f89e425c3"><data key="edge_predicate_raw">lead to</data><data key="edge_assertion_id">a_2baecd2a07b77251</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">for at least one entity; component failure may (but does not necessarily) lead to overall</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">lead to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["lead to"]</data></edge><edge id="oe_1b61aa909a49adb9" source="e_290d8da624d84fb0" target="e_f5282588cca580e9"><data key="edge_predicate_raw">provide</data><data key="edge_assertion_id">a_7fdb8318e65f8094</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">they directly provide essential functions, then this criticality is what is important</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">provides</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["provides", "provide"]</data></edge><edge id="oe_22076e922f75c4ea" source="e_ce11a2208473b04a" target="e_77d2c88a71e7230d"><data key="edge_predicate_raw">measures</data><data key="edge_assertion_id">a_def8e4268ec730ac</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C06</data><data key="edge_json_path">None</data><data key="edge_evidence">inspections.” This feature measures prevalence, not impact, so it does not need to account for any compensating</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">measure</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["measure", "measures"]</data></edge><edge id="oe_78aee952fa9073d1" source="e_e55bb74d763af9d6" target="e_35deb6a3ad1d7113"><data key="edge_predicate_raw">be described in</data><data key="edge_assertion_id">a_c09628fb503e70b3</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C06</data><data key="edge_json_path">None</data><data key="edge_evidence">aspects described in material</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be described in</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be described in"]</data></edge><edge id="oe_0a5e3f992d7ca152" source="e_1308a3232dd8ae09" target="e_5f480ecafea35c10"><data key="edge_predicate_raw">be leading to</data><data key="edge_assertion_id">a_fc67f09206652568</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C06</data><data key="edge_json_path">None</data><data key="edge_evidence">environmental damage leading to small</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be leading to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be leading to"]</data></edge><edge id="oe_30c3b1da60c58308" source="e_34cf20183f45e324" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">remediates</data><data key="edge_assertion_id">a_ee9c9d644ebde51f</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">Type Fix An official patch that remediates the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">remediates</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["remediates"]</data></edge><edge id="oe_917d25f23dff5277" source="e_7b4f67c17e442588" target="e_d5bfbcb5ba84f908"><data key="edge_predicate_raw">is worse than</data><data key="edge_assertion_id">a_5f9fc938b3904dc9</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">high is worse than low</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is worse than</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is worse than"]</data></edge><edge id="oe_abc8c2e6387dde84" source="e_16de2b13fd6fb2c4" target="e_1f2601d49545e1c6"><data key="edge_predicate_raw">does change priority of</data><data key="edge_assertion_id">a_5b3887b1dbb5d1df</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">Based on the CISA decision tree, the value of mitigation does not change the priority of the SSVC decision</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">does change priority of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["does change priority of"]</data></edge><edge id="oe_96853c2ff4d16d58" source="e_4676679afd99eed0" target="e_618d93742ee02dc6"><data key="edge_predicate_raw">provides likelihood of</data><data key="edge_assertion_id">a_519f5a82cb976860</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C07</data><data key="edge_json_path">None</data><data key="edge_evidence"