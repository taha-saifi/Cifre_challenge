bprint) header</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">resolves</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["resolves"]</data></edge><edge id="oe_7f56ae8d8942bc8a" source="e_8da41769d43e04b2" target="e_a808ba19b12ca174"><data key="edge_predicate_raw">is x5t out</data><data key="edge_assertion_id">a_b6012ac29e71d46e</data><data key="edge_source_id">S08</data><data key="edge_source_url">https://www.rapid7.com/blog/post/ra-microsoft-sharepoint-jwt-token-authentication-bypass-cve-2026-55040/</data><data key="edge_chunk_id">S08_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">if (!((Dictionary&lt;string, object&gt;)(object)header).TryGetValue("x5t", out object value))</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is x5t out</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is x5t out"]</data></edge><edge id="oe_e3bd4a6b83f02401" source="e_00af3570796b3644" target="e_fe22e3a9aa67dbf9"><data key="edge_predicate_raw">is SecurityKeyIdentifierClause keyIdentifierClause out</data><data key="edge_assertion_id">a_a644878f874f9b2c</data><data key="edge_source_id">S08</data><data key="edge_source_url">https://www.rapid7.com/blog/post/ra-microsoft-sharepoint-jwt-token-authentication-bypass-cve-2026-55040/</data><data key="edge_chunk_id">S08_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">protected override bool TryResolveTokenCore(SecurityKeyIdentifierClause keyIdentifierClause, out SecurityToken token)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is SecurityKeyIdentifierClause keyIdentifierClause out</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is SecurityKeyIdentifierClause keyIdentifierClause out"]</data></edge><edge id="oe_8a59c56615232234" source="e_b4ce5f620e5b18e6" target="e_5a32f80e837928a3"><data key="edge_predicate_raw">is local.LocalLoginProvider out</data><data key="edge_assertion_id">a_cd32f77156edce7f</data><data key="edge_source_id">S08</data><data key="edge_source_url">https://www.rapid7.com/blog/post/ra-microsoft-sharepoint-jwt-token-authentication-bypass-cve-2026-55040/</data><data key="edge_chunk_id">S08_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">if (TryResolveTokenCoreWithAccessProvider(local.LocalLoginProvider, keyIdentifierClause, out token)) // &lt;--- [4]</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is local.LocalLoginProvider out</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is local.LocalLoginProvider out"]</data></edge><edge id="oe_6d59d6ca0296ab24" source="e_537e6ab50e8f2e44" target="e_e5b86ea3768bb695"><data key="edge_predicate_raw">sets actor token 's x5t header to thumbprint of</data><data key="edge_assertion_id">a_d7a09a2c1cfacf19</data><data key="edge_source_id">S08</data><data key="edge_source_url">https://www.rapid7.com/blog/post/ra-microsoft-sharepoint-jwt-token-authentication-bypass-cve-2026-55040/</data><data key="edge_chunk_id">S08_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">If an attacker sets the actor token's x5t header to the thumbprint of SharePoint's STS certificate, the resolver finds a match and returns an X509SecurityToken wrapping that certificate</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">sets actor token 's x5t header to thumbprint of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["sets actor token 's x5t header to thumbprint of"]</data></edge><edge id="oe_c30e73adad883ac1" source="e_bb4cb9064eb1e9dc" target="e_b2ed8f50f54e96cb"><data key="edge_predicate_raw">accepts</data><data key="edge_assertion_id">a_f367cebd69d120fe</data><data key="edge_source_id">S08</data><data key="edge_source_url">https://www.rapid7.com/blog/post/ra-microsoft-sharepoint-jwt-token-authentication-bypass-cve-2026-55040/</data><data key="edge_chunk_id">S08_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">Weakness 3: Issuer validation accepts unregistered certificates</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">accepts</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["accepts", "accept", "accepted"]</data></edge><edge id="oe_acefb0b7cc437112" source="e_b714a5923e95ecac" target="e_b2ed8f50f54e96cb"><data key="edge_predicate_raw">accepts tokens signed by</data><data key="edge_assertion_id">a_42b17622a31739ad</data><data key="edge_source_id">S08</data><data key="edge_source_url">https://www.rapid7.com/blog/post/ra-microsoft-sharepoint-jwt-token-authentication-bypass-cve-2026-55040/</data><data key="edge_chunk_id">S08_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">This calls the ValidateIssuer(X509SecurityToken, string) overload which accepts tokens signed by unregistered certificates:</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">accepts tokens signed by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["accepts tokens signed by"]</data></edge><edge id="oe_06490357897013bc" source="e_b12b45dceecb4419" target="e_b2ed8f50f54e96cb"><data key="edge_predicate_raw">be signed by</data><data key="edge_assertion_id">a_66357d52ce2b5588</data><data key="edge_source_id">S08</data><data key="edge_source_url">https://www.rapid7.com/blog/post/ra-microsoft-sharepoint-jwt-token-authentication-bypass-cve-2026-55040/</data><data key="edge_chunk_id">S08_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">This calls the ValidateIssuer(X509SecurityToken, string) overload which accepts tokens signed by unregistered certificates:</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be signed by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be signed by"]</data></edge><edge id="oe_07b0174ac81a3bd0" source="e_8ddf64f1bb84f0d7" target="e_864e4fc9e52bbb7f"><data key="edge_predicate_raw">accepted</data><data key="edge_assertion_id">a_b282cc7ceb245070</data><data key="edge_source_id">S08</data><data key="edge_source_url">https://www.rapid7.com/blog/post/ra-microsoft-sharepoint-jwt-token-authentication-bypass-cve-2026-55040/</data><data key="edge_chunk_id">S08_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">ULS.SendTraceTag(594416645u, ..., "ValidateTokenIssuer accepted Issuer '{0}' because " +</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">accepts</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["accepts", "accept", "accepted"]</data></edge><edge id="oe_428ae749853dd637" sour