d="oe_7b5d1402b5513966" source="e_1cef96ef35b5e3d6" target="e_e163460c91338b08"><data key="edge_predicate_raw">has been updated to reflect</data><data key="edge_assertion_id">a_1117e1f1d4b7226c</data><data key="edge_source_id">S41</data><data key="edge_source_url">https://www.rapid7.com/blog/post/etr-cve-2026-63520-microsoft-sharepoint-remote-code-execution-fixed/</data><data key="edge_chunk_id">S41_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">This disclosure blog has been updated to reflect this</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">has been updated to reflect</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["has been updated to reflect"]</data></edge><edge id="oe_2018c94c7e468d3a" source="e_6f7684418f21aa11" target="e_e720fdd5cc03ee4b"><data key="edge_predicate_raw">adds CVE-2026-55040 to</data><data key="edge_assertion_id">a_2f9dcf463a982ef3</data><data key="edge_source_id">S41</data><data key="edge_source_url">https://www.rapid7.com/blog/post/etr-cve-2026-63520-microsoft-sharepoint-remote-code-execution-fixed/</data><data key="edge_chunk_id">S41_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">- August 18, 2026: CISA adds CVE-2026-55040 to its KEV catalog</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">added CVE-2026-55040 to</data><data key="edge_domain">Organization</data><data key="edge_range">Mention</data><data key="edge_derived_from">["added CVE-2026-55040 to", "adds CVE-2026-55040 to"]</data></edge><edge id="oe_84b5ecd2b7bfefb4" source="e_dc576b7e1d7a71f5" target="e_87eee21844f2b349"><data key="edge_predicate_raw">are published by</data><data key="edge_assertion_id">a_b69e40dacb1a00a4</data><data key="edge_source_id">S41</data><data key="edge_source_url">https://www.rapid7.com/blog/post/etr-cve-2026-63520-microsoft-sharepoint-remote-code-execution-fixed/</data><data key="edge_chunk_id">S41_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">- August 24, 2026: Rapid7 publishes technical details for CVE-2026-63520 ahead of schedule after technical details are published by a third-party</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are published by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are published by"]</data></edge><edge id="oe_0760f13482633e54" source="e_6f86ae8844c3ae87" target="e_82d77a759d87d5b6"><data key="edge_predicate_raw">publishes</data><data key="edge_assertion_id">a_3f35e012e097fa26</data><data key="edge_source_id">S41</data><data key="edge_source_url">https://www.rapid7.com/blog/post/etr-cve-2026-63520-microsoft-sharepoint-remote-code-execution-fixed/</data><data key="edge_chunk_id">S41_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">- August 24, 2026: Rapid7 publishes technical details for CVE-2026-63520 ahead of schedule after technical details are published by a third-party</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">publishes</data><data key="edge_domain">Organization</data><data key="edge_range">CVE</data><data key="edge_derived_from">["publishes"]</data></edge><edge id="oe_04d4037b96ac12d8" source="e_4676679afd99eed0" target="e_6222cbe778251f55"><data key="edge_predicate_raw">describes conditions beyond</data><data key="edge_assertion_id">a_27440b6cceab1bc6</data><data key="edge_source_id">S42</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-63520</data><data key="edge_chunk_id">S42_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric describes the conditions beyond the attacker’s control that must exist in order to exploit the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">describes conditions beyond</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["describes conditions beyond"]</data></edge><edge id="oe_95a9d9a39affabd1" source="e_8ed91b82735ab1f6" target="e_106a49c8576bc28c"><data key="edge_predicate_raw">exists</data><data key="edge_assertion_id">a_cc67e0ef15182cb2</data><data key="edge_source_id">S42</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-63520</data><data key="edge_chunk_id">S42_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, a successful attack may require an attacker to: gather knowledge about the environment in which the vulnerable target/component exists; prepare the target environment to improve exploit reliability; or inject themselves into the logical network path between the target and the resource requested by the victim in order to read and/or modify network communications (e.g., a man in the middle attack)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">exists</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["exists"]</data></edge><edge id="oe_b034bd4485de03d7" source="e_4676679afd99eed0" target="e_1b50c049dec6c218"><data key="edge_predicate_raw">describes level of</data><data key="edge_assertion_id">a_9ab1189dbb254912</data><data key="edge_source_id">S42</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-63520</data><data key="edge_chunk_id">S42_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric describes the level of privileges an attacker must possess before successfully exploiting the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">describes level of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["describes level of"]</data></edge><edge id="oe_f9fd074e0d06b87a" source="e_537e6ab50e8f2e44" target="e_1b50c049dec6c218"><data key="edge_predicate_raw">possess before exploiting vulnerability</data><data key="edge_assertion_id">a_8cbc759d5b90b3e1</data><data key="edge_source_id">S42</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-63520</data><data key="edge_chunk_id">S42_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric describes the level of privileges an attacker must possess before successfully exploiting the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">possess before exploiting vulnerability</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["possess before exploiting vulnerability"]</data></edge><edge id="oe_b1bf3986f33a7525" source="e_537e6ab50e8f2e44" target="e_1b50c049dec6c218"><data key="edge_predicate_raw">possess</data><data key="edge_assertion_id">a_37ea53743fde3319</data><data key="edge_source_id">S42</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-63520</data><data key="edge_chunk_id">S42_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric describes the level of privileges an attacker must possess before successfully exploiting the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">possess</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["possess"]</data></edge><edge id="oe_8cbe2cfb500d3748" source="e_537e6ab50e8f2e44" target="e_9bf6ead54114b2ce"><data key="edge_predicate_raw">is unauthorized prior to</data><data key="edge_assertion_id">a_af2dfcb5b4f46eba</data><data key="edge_source_id">S42</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-63520</data><data key="edge_chunk_id">S42_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The attacker is unauthorized prior to attack, and therefore does not require any access to settings or files to carry out an attack</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is unauthorized prior to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is unauthorized prior to"]</data></edge><edge id="oe_5e87d4cbd0bb4fa3" source="e_dbd1ba0cc63988dc" target="e_537e6ab50e8f2e44"><data key="edge_predicate_raw">be exploited at will of</data><data key="edge_assertion_id">a_3c91fa5f764a2511</data><data key="edge_source_id">S42</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-63520</data><data key="edge_chunk_id">S42_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric determines whether the vulnerability can be exploited solely at the will of the attacker, or whether a 