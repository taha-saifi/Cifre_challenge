">None</data><data key="edge_evidence">However, if the sensitive data is encrypted at rest, this attribute can be rated Low</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be rated</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be rated"]</data></edge><edge id="oe_bce7b850bcc32d5d" source="e_e163460c91338b08" target="e_761cc9bc3cf32e49"><data key="edge_predicate_raw">includes</data><data key="edge_assertion_id">a_803cb536a68cb6ab</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">This includes service accounts and credentials embedded into scripts or source code</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">include</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["include", "includes"]</data></edge><edge id="oe_c9d6e4d6863dca51" source="e_e1cfc695b1b6dfe7" target="e_7b4f67c17e442588"><data key="edge_predicate_raw">be rated</data><data key="edge_assertion_id">a_9b26f5493c3ea56d</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Devices that contain monetary transactional data and/or personally identifiable information (PII) should be rated High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be rated</data><data key="edge_domain">Ment