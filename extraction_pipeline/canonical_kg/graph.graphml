_from">["aim to compromise"]</data></edge><edge id="oe_11913f629f54f0d6" source="e_871d6c330e123e77" target="e_34f1f5edbb141db9"><data key="edge_predicate_raw">aim to compromise</data><data key="edge_assertion_id">a_05dfe22d04321130</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Known exploited vulnerabilities are a frequent attack vector for malicious cyber actors, including those backed by nation-states that aim to compromise U.S. critical infrastructure to steal sensitive information, disrupt operations, and undermine national security</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">aim to compromise</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["aim to compromise"]</data></edge><edge id="oe_35b9ba21f44c57ba" source="e_871d6c330e123e77" target="e_6db1f6088d9fe741"><data key="edge_predicate_raw">aim to compromise</data><data key="edge_assertion_id">a_695dd9be0c755889</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Known exploited vulnerabilities are a frequent attack vector for malicious cyber actors, including those backed by nation-states that aim to compromise U.S. critical infrastructure to steal sensitive information, disrupt operations, and undermine national security</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">aim to compromise</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["aim to compromise"]</data></edge><edge id="oe_5d51d06b59c0a052" source="e_d152aed168aa1b22" target="e_416e308841e8295d"><data key="edge_predicate_raw">directed agencies to remediate</data><data key="edge_assertion_id">a_52bf4bd996f66c7a</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">In 2021 CISA established the Known Exploited Vulnerabilities catalog pursuant to BOD 22-01, which directed agencies to aggressively remediate known exploited vulnerabilities (KEVs), protect federal assets, and reduce cyber incidents</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">directed agencies to remediate</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["directed agencies to remediate"]</data></edge><edge id="oe_1d5f17a57ccf0b1e" source="e_d152aed168aa1b22" target="e_6c0b102b5b5a264a"><data key="edge_predicate_raw">directed agencies to</data><data key="edge_assertion_id">a_3b560fcc0d1f04f7</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">In 2021 CISA established the Known Exploited Vulnerabilities catalog pursuant to BOD 22-01, which directed agencies to aggressively remediate known exploited vulnerabilities (KEVs), protect federal assets, and reduce cyber incidents</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">directed agencies to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["directed agencies to"]</data></edge><edge id="oe_14f10910d1b232fc" source="e_3b8e724ba04c0cda" target="e_dbeb2afe79d1dc70"><data key="edge_predicate_raw">evolves upon</data><data key="edge_assertion_id">a_5655c0071a3dbf5d</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">This Directive evolves upon CISA’s KEV Catalog and increases mission readiness across the federal government by efficiently prioritizing high-risk vulnerabilities for timely action, while deferring action against low-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">evolves upon</data><data key="edge_domain">Mention</data><data key="edge_range">Product</data><data key="edge_derived_from">["evolves upon"]</data></edge><edge id="oe_030660f0230f2970" source="e_3b8e724ba04c0cda" target="e_9c1295946a9c9f48"><data key="edge_predicate_raw">increases mission readiness across federal government by prioritizing high-risk vulnerabilities for</data><data key="edge_assertion_id">a_971b8959eb90aa90</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">This Directive evolves upon CISA’s KEV Catalog and increases mission readiness across the federal government by efficiently pri