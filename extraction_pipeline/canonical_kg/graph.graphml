id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">It is an open framework, providing transparency to the individual characteristics and methodology used to derive a score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be providing transparency to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be providing transparency to"]</data></edge><edge id="oe_7978e877228ba464" source="e_ebf85728d7cf1dba" target="e_4364e67a28b13c95"><data key="edge_predicate_raw">be used to derive</data><data key="edge_assertion_id">a_a407847c47fa53ff</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">It is an open framework, providing transparency to the individual characteristics and methodology used to derive a score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be used to derive</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be used to derive"]</data></edge><edge id="oe_7368d2ba578179c4" source="e_959f52a470454532" target="e_4364e67a28b13c95"><data key="edge_predicate_raw">be used to derive</data><data key="edge_assertion_id">a_de302587aacba32c</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">It is an open framework, providing transparency to the individual characteristics and methodology used to derive a score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be used to derive</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be used to derive"]</data></edge><edge id="oe_4276a3f71c6c15dc" source="e_e3e8cfa2e4a001b9" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">represents intrinsic characteristics of</data><data key="edge_assertion_id">a_68b8ea5690a4b035</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base metric group represents the intrinsic characteristics of a vulnerability that are constant over time and across user environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">represents intrinsic characteristics of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["represents intrinsic characteristics of"]</data></edge><edge id="oe_bd673204084a2b0d" source="e_dbd1ba0cc63988dc" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">are constant over</data><data key="edge_assertion_id">a_e1cdaaf816ca573b</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base metric group represents the intrinsic characteristics of a vulnerability that are constant over time and across user environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are constant over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are constant over"]</data></edge><edge id="oe_416cf9efd6bd48e4" source="e_dbd1ba0cc63988dc" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">are across user environments over</data><data key="edge_assertion_id">a_cc37bca4b5d575a4</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base metric group represents the intrinsic characteristics of a vulnerability that are constant over time and across user environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are across user environments over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are across user environments over"]</data></edge><edge id="oe_a445c5d0ba90b62c" source="e_dbd1ba0cc63988dc" target="e_3d75e6dbcbfb5033"><data key="edge_predicate_raw">are across</data><data key="edge_assertion_id">a_4b58cb8767a26cf5</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base metric group represents the intrinsic characteristics of a vulnerability that are constant over time and across user environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are across</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are across"]</data></edge><edge id="oe_c713a28975f79d79" source="e_be74ffef073dc8d3" target="e_0651ca14b1e582f2"><data key="edge_predicate_raw">refer thing to formally as</data><data key="edge_assertion_id">a_a32b9e36fc35ca73</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">That is, they represent characteristics of the thing that is vulnerable, which we refer to formally as the vulnerable component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">refer thing to formally as</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["refer thing to formally as"]</data></edge><edge id="oe_426a07f86e7eb49b" source="e_dbd1ba0cc63988dc" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">change over</data><data key="edge_assertion_id">a_a1bd82d80a845e92</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Temporal metric group reflects the characteristics of a vulnerability that may change over time but not across user environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">change over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["change over", "changes over", "do change over"]</data></edge><edge id="oe_5e13b8be9d4ab832" source="e_0915479bc15411b6" target="e_b5dac192ab4acd82"><data key="edge_predicate_raw">increase</data><data key="edge_assertion_id">a_8121ee2a017edbcc</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, the presence of a simple-to-use exploit kit would increase the CVSS score, while the creation of an official patch would decrease it</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">increase</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["increase"]</data></edge><edge id="oe_f63c2c0f29990ca5" source="e_dbd1ba0cc63988dc" target="e_1649d73b65b2ed56"><data key="edge_predicate_raw">are relevant to</data><data key="edge_assertion_id">a_7dd359efc5416ff8</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental metric group represents the characteristics of a vulnerability that are relevant and unique to a particular user’s environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are relevant to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are relevant to"]</data></edge><edge id="oe_a2e1a2bb021c606b" source="e_dbd1ba0cc63988dc" target="e_1649d73b65b2ed56"><data key="edge_predicate_raw">are unique to</data><data key="edge_assertion_id">a_a7b2b68a2e939916</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental metric group represents the characteristics of a vulnerability that are relevant and unique to a particular user’s environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are unique to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are unique to"]</data></edge><edge id="oe_bcd92df22ee02e41" source="e_1e8ea1b42ca055ae" target="e_ecedfcb33ae54209"><data key="edge_predicate_raw">include</data><data key="edge_assertion_id">a_49929a2d7f7e9cf3</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">Considerations include the presence of security controls which may mitigate some or all consequences of a successful attack, and the relative importance of a vulnerable system within a technology infrastructure</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">include</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["include", "includes"]</data></edge><edge id="oe_427cca1ead5df068" source="e_80b852b98e6b518c" target="e_cd0a45b2a1788da0"><data key="edge_predicate_raw">be useful when</data><data key="edge_assertion_id">a_d283bcb3c7fa03ab</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">The User Guide contains scoring rubrics for the Base Metrics that may be useful when scoring</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be useful when</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be useful when"]</data></edge><edge id="oe_252b05434fed609f" source="e_80b852b98e6b518c" target="e_f6498126c94c6f96"><data key="edge_predicate_raw">are assigned values by</data><data key="edge_assertion_id">a_d7ced59d42550a0d</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">When the Base metrics are assigned values by an analyst, the Base equation computes a score ranging from 0.0 to 10.0 as illustrated in Figure 2</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are assigned values by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are assigned values by"]</data></edge><edge id="oe_a74630251bf4ac08" source="e_4877b2bf1b130d1f" target="e_1f8b03b1f8c955c4"><data key="edge_predicate_raw">is derived from</data><data key="edge_assertion_id">a_9dac36e0b9f155db</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">The Exploitability sub-score equation is derived from the Base Exploitability metrics, while the Impact sub-score equation is derived from the Base Impact metrics</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is derived from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is derived from"]</data></edge><edge id="oe_fd6a4360916966fb" source="e_42a7aeb6884747b3" target="e_31bc17d765a1a69b"><data key="edge_predicate_raw">is derived from</data><data key="edge_assertion_id">a_75b8f4fc914a24df</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">The Exploitability sub-score equation is derived from the Base Exploitability metrics, while the Impact sub-score equation is derived from the Base Impact metrics</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is derived from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is derived from"]</data></edge><edge id="oe_e0e46f919baae796" source="e_3d4814f0d5e669ab" target="e_2a7ed2bff0cdae40"><data key="edge_predicate_raw">be reflect more</data><data key="edge_assertion_id">a_2425eb8937c15a91</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base Score can then be refined by scoring the Temporal and Environmental metrics in order to more accurately reflect the relative severity posed by a vulnerability to a user’s environment at a specific point in time</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be reflect more</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be reflect more"]</data></edge><edge id="oe_72e2be4c5e93c15c" source="e_3a9157715b31805c" target="e_2a7ed2bff0cdae40"><data key="edge_predicate_raw">be reflect more</data><data key="edge_assertion_id">a_de6869185d6c903e</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base Score can then be refined by scoring the Temporal and Environmental metrics in order to more accurately reflect the relative severity posed by a vulnerability to a user’s environment at a specific point in time</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be reflect more</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be reflect more"]</data></edge><edge id="oe_f0f9e77877e32640" source="e_d15e9e1afe2a9d2f" target="e_491a87f4c4b335f8"><data key="edge_predicate_raw">be posed by</data><data key="edge_assertion_id">a_b121b6243dc11bf4</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base Score can then be refined by scoring the Temporal and Environmental metrics in order to more accurately reflect the relative severity posed by a vulnerability to a user’s environment at a specific point in time</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be posed by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be posed by"]</data></edge><edge id="oe_6fdccdc55b9e850d" source="e_290d8da624d84fb0" target="e_a0ef75f1f1ee68c4"><data key="edge_predicate_raw">possess</data><data key="edge_assertion_id">a_552ca1215b4dd3d4</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">Generally, the Base and Temporal metrics are specified by vulnerability bulletin analysts, security product vendors, or application vendors because they typically possess the most accurate information about the characteristics of a vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">possess</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["possess"]</data></edge><edge id="oe_c3cc1b3decc7df32" source="e_be74ffef073dc8d3" target="e_0651ca14b1e582f2"><data key="edge_predicate_raw">refer thing to formally as</data><data key="edge_assertion_id">a_ddc6143e1fc6e0d7</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">As previously mentioned, the Exploitability metrics reflect the characteristics of the thing that is vulnerable, which we refer to formally as the vulnerable component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">refer thing to formally as</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["refer thing to formally as"]</data></edge><edge id="oe_f2ed13d75a16df3a" source="e_c00a4051d0530e03" target="e_7105a374c44c5518"><data key="edge_predicate_raw">reflect characteristics of thing As</data><data key="edge_assertion_id">a_579f6a321cd4dc08</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">As previously mentioned, the Exploitability metrics reflect the characteristics of the thing that is vulnerable, which we refer to formally as the vulnerable component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">reflect characteristics of thing As</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["reflect characteristics of thing As"]</data></edge><edge id="oe_92ec6bf662b4ce51" source="e_dbd1ba0cc63988dc" target="e_2676df0405400172"><data key="edge_predicate_raw">lead to</data><data key="edge_assertion_id">a_4e59ab24ff29bb43</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">Therefore, each of the Exploitability metrics listed below should be scored relative to the vulnerable component, and reflect the properties of the vulnerability that lead to a successful attack</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">lead to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["lead to"]</data></edge><edge id="oe_0406cf442d36cd6b" source="e_ad16450d4d7b98f8" target="e_80b852b98e6b518c"><data key="edge_predicate_raw">be scoring</data><data key="edge_assertion_id">a_058555d48072c882</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">When scoring Base metrics, it should be assumed that the attacker has advanced knowledge of the weaknesses of the target system, including general configuration and default defense mechanisms (e.g., built-in firewalls, rate limits, traffic policing)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be scored</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be scored", "be scoring"]</data></edge><edge id="oe_cdb00d74041d362d" source="e_dbd1ba0cc63988dc" target="e_b8ee2c28df4dc72b"><data key="edge_predicate_raw">results in</data><data key="edge_assertion_id">a_661247cda7ef1efc</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, exploiting a vulnerability that results in repeatable, deterministic success should still be considered a Low value for Attack Complexity, independent of the attacker's knowledge or capabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">result in</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["result in", "resulted in", "results in"]</data></edge><edge id="oe_234ce8ddf027cc51" source="e_d76f0b71c9538da5" target="e_fcae9732e4e96feb"><data key="edge_predicate_raw">be considered</data><data key="edge_assertion_id">a_dbd79c570074492c</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, exploiting a vulnerability that results in repeatable, deterministic success should still be considered a Low value for Attack Complexity, independent of the attacker's knowledge or capabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be considered</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be considered"]</data></edge><edge id="oe_fa213a4d164e48b6" source="e_d76f0b71c9538da5" target="e_454f93ad983bcfc4"><data key="edge_predicate_raw">be considered</data><data key="edge_assertion_id">a_3175712753929313</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, exploiting a vulnerability that results in repeatable, deterministic success should still be considered a Low value for Attack Complexity, independent of the attacker's knowledge or capabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be considered</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be considered"]</data></edge><edge id="oe_36574beeba739e7d" source="e_dbd1ba0cc63988dc" target="e_571bc10d653316b8"><data key="edge_predicate_raw">be exploited from across</data><data key="edge_assertion_id">a_5dd77c079a90b27e</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">The assumption is that the number of potential attackers for a vulnerability that could be exploited from across a network is larger than the number of potential attackers that could exploit a vulnerability requiring physical access to a device, and therefore warrants a greater Base Score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be exploited from across</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be exploited from across"]</data></edge><edge id="oe_aae49b0d752d3998" source="e_6c929bb8a42a9b8c" target="e_b4e364ab91d013d5"><data key="edge_predicate_raw">is larger than number of</data><data key="edge_assertion_id">a_7c29b4b77cb61b55</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">The assumption is that the number of potential attackers for a vulnerability that could be exploited from across a network is larger than the number of potential attackers that could exploit a vulnerability requiring physical access to a device, and therefore warrants a greater Base Score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">is larger than number of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is larger than number of"]</data></edge><edge id="oe_dba4daeb3124e887" source="e_6c929bb8a42a9b8c" target="e_1abffb155679e04c"><data key="edge_predicate_raw">warrants</data><data key="edge_assertion_id">a_64dffa10ad6dce44</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">The assumption is that the number of potential attackers for a vulnerability that could be exploited from across a network is larger than the number of potential attackers that could exploit a vulnerability requiring physical access to a device, and therefore warrants a greater Base Score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">warrants</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["warrants"]</data></edge><edge id="oe_fb07eb07d82179ce" source="e_dbd1ba0cc63988dc" target="e_99963bce824a5b88"><data key="edge_predicate_raw">be requiring</data><data key="edge_assertion_id">a_a3e7a669254d880a</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">The assumption is that the number of potential attackers for a vulnerability that could be exploited from across a network is larger than the number of potential attackers that could exploit a vulnerability requiring physical access to a device, and therefore warrants a greater Base Score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be requiring</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be requiring"]</data></edge><edge id="oe_9d87bc3257369706" source="e_9bf6ead54114b2ce" target="e_32ac150c7b7e742f"><data key="edge_predicate_raw">be launched from</data><data key="edge_assertion_id">a_81b5e22a6eccd66a</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">This can mean an attack must be launched from the same shared physical (e.g., Bluetooth or IEEE 802.11) or logical (e.g., local IP subnet) network, or from within a secure or otherwise limited administrative domain (e.g., MPLS, secure VPN to an administrative network zone)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be launched from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be launched from"]</data></edge><edge id="oe_14d8bcbf4e7f41a0" source="e_9bf6ead54114b2ce" target="e_fdc1a10ff63ad4b3"><data key="edge_predicate_raw">be launched from</data><data key="edge_assertion_id">a_a66eee96bd717df7</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">This can mean an attack must be launched from the same shared physical (e.g., Bluetooth or IEEE 802.11) or logical (e.g., local IP subnet) network, or from within a secure or otherwise limited administrative domain (e.g., MPLS, secure VPN to an administrative network zone)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be launched from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be launched from"]</data></edge><edge id="oe_33c019c5832a509e" source="e_9bf6ead54114b2ce" target="e_e85c55da35560a77"><data key="edge_predicate_raw">be launched from</data><data key="edge_assertion_id">a_be54fc63a68c18ca</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">This can mean an attack must be launched from the same shared physical (e.g., Bluetooth or IEEE 802.11) or logical (e.g., local IP subnet) network, or from within a secure or otherwise limited administrative domain (e.g., MPLS, secure VPN to an administrative network zone)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be launched from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be launched from"]</data></edge><edge id="oe_598124ed8c0ed793" source="e_9bf6ead54114b2ce" target="e_d492cfe3ad61e27e"><data key="edge_predicate_raw">be launched over</data><data key="edge_assertion_id">a_e1f1cbf19f2bf488</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">Scoring Guidance: When deciding between Network and Adjacent, if an attack can be launched over a wide area network or from outside the logically adjacent administrative network domain, use Network</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be launched over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be launched over"]</data></edge><edge id="oe_d6004173e1be9826" source="e_9bf6ead54114b2ce" target="e_e299850b57d85a43"><data key="edge_predicate_raw">be launched from outside</data><data key="edge_assertion_id">a_a153f3f570d82944</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">Scoring Guidance: When deciding between Network and Adjacent, if an attack can be launched over a wide area network or from outside the logically adjacent administrative network domain, use Network</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be launched from outside</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be launched from outside"]</data></edge><edge id="oe_3d759b97d1e51eee" source="e_4676679afd99eed0" target="e_6222cbe778251f55"><data key="edge_predicate_raw">describes conditions beyond</data><data key="edge_assertion_id">a_5650553ae884ceb3</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric describes the conditions beyond the attacker’s control that must exist in order to exploit the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">describes conditions beyond</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["describes conditions beyond"]</data></edge><edge id="oe_4c825dad9ec94b0d" source="e_4676679afd99eed0" target="e_1b50c049dec6c218"><data key="edge_predicate_raw">describes level of</data><data key="edge_assertion_id">a_1d3b0821492c9f6c</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C06</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric describes the level of privileges an attacker must possess before successfully exploiting the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">describes level of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["describes level of"]</data></edge><edge id="oe_b964185c1615bc90" source="e_537e6ab50e8f2e44" target="e_1b50c049dec6c218"><data key="edge_predicate_raw">possess before exploiting vulnerability</data><data key="edge_assertion_id">a_36930d6dbbec82a5</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C06</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric describes the level of privileges an attacker must possess before successfully exploiting the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">possess before exploiting vulnerability</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["possess before exploiting vulnerability"]</data></edge><edge id="oe_4dfdb1b9c5c82d00" source="e_537e6ab50e8f2e44" target="e_1b50c049dec6c218"><data key="edge_predicate_raw">possess</data><data key="edge_assertion_id">a_c742b971babba7b0</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C06</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric describes the level of privileges an attacker must possess before successfully exploiting the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">possess</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["possess"]</data></edge><edge id="oe_11e6a0896b71a452" source="e_06cebb65494ded95" target="e_537e6ab50e8f2e44"><data key="edge_predicate_raw">is other than</data><data key="edge_assertion_id">a_533b6b2bce4d7e24</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C06</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric captures the requirement for a human user, other than the attacker, to participate in the successful compromise of the vulnerable component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is other than</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is other than"]</data></edge><edge id="oe_85186c95841a1a8d" source="e_dbd1ba0cc63988dc" target="e_537e6ab50e8f2e44"><data key="edge_predicate_raw">be exploited at will of</data><data key="edge_assertion_id">a_8c66ff3005c30eb5</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C06</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric determines whether the vulnerability can be exploited solely at the will of the attacker, or whether a separate user (or user-initiated process) must participate in some manner</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be exploited at will of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be exploited at will of"]</data></edge><edge id="oe_7d6a271f1f36913b" source="e_d33d35b1f0e869ff" target="e_c9f7ebbebae4fbbf"><data key="edge_predicate_raw">provide</data><data key="edge_assertion_id">a_d8f3b1dd535699ff</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">The security scope of a component encompasses other components that provide functionality solely to that component, even if these other components have their own security authority</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">provides</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["provides", "provide"]</data></edge><edge id="oe_4deecb39424cd013" source="e_d4cff6070f136c90" target="e_35b2194131dcbc9a"><data key="edge_predicate_raw">constrain impacts to</data><data key="edge_assertion_id">a_d2f32d34ec718e99</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">Analysts should constrain impacts to a reasonable, final outcome which they are confident an attacker is able to achieve</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">constrain impacts to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["constrain impacts to"]</data></edge><edge id="oe_e24cb4e38671b7d1" source="e_d4cff6070f136c90" target="e_57598c70746601d2"><data key="edge_predicate_raw">constrain</data><data key="edge_assertion_id">a_56e7d59c0eb9e2a4</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">Analysts should constrain impacts to a reasonable, final outcome which they are confident an attacker is able to achieve</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">constrain</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["constrain"]</data></edge><edge id="oe_d1398652fdfc9395" source="e_5abf948c6bee4fdf" target="e_f3d00477181497a6"><data key="edge_predicate_raw">be able</data><data key="edge_assertion_id">a_ba55a813e31f2b89</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, consider a vulnerability that requires read-only permissions prior to being able to exploit the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be able</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be able"]</data></edge><edge id="oe_ece9f2c177ff3afb" source="e_dbd1ba0cc63988dc" target="e_f3d00477181497a6"><data key="edge_predicate_raw">requires read-only permissions prior to being</data><data key="edge_assertion_id">a_8d38628e3d33faa5</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, consider a vulnerability that requires read-only permissions prior to being able to exploit the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">requires read-only permissions prior to being</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["requires read-only permissions prior to being"]</data></edge><edge id="oe_53fadfb2f9235e85" source="e_8f5263a93ee3ad05" target="e_f2dca16215b933e8"><data key="edge_predicate_raw">write</data><data key="edge_assertion_id">a_94efb2a8db098f32</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">After successful exploitation, the attacker maintains the same level of read access, and gains write access</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">write</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["write"]</data></edge><edge id="oe_3ea19b32a7960841" source="e_29bb0e9d5a84c984" target="e_f2dca16215b933e8"><data key="edge_predicate_raw">write</data><data key="edge_assertion_id">a_62524b2fab530a8e</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">After successful exploitation, the attacker maintains the same level of read access, and gains write access</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">write</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["write"]</data></edge><edge id="oe_93783ea92db9c0af" source="e_384266dea333f2df" target="e_d7268769fbad72a0"><data key="edge_predicate_raw">reference</data><data key="edge_assertion_id">a_ca77f0a73175a72c</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, if an attacker starts with partial access to restricted information (Confidentiality Low) and successful exploitation of the vulnerability results in complete loss in confidentiality (Confidentiality High), then the resultant CVSS Base Score should reference the “end game” Impact metric value (Confidentiality High)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">references</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["references", "reference"]</data></edge><edge id="oe_6335b76a4a6e6e73" source="e_841d5cae83210039" target="e_c1b8569aebaf6353"><data key="edge_predicate_raw">be managed by</data><data key="edge_assertion_id">a_c72cbe7abc6e571f</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric measures the impact to the confidentiality of the information resources managed by a software component due to a successfully exploited vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be managed by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be managed by"]</data></edge><edge id="oe_ab7227b45a1fd318" source="e_fabb36a448bb30b7" target="e_eb1797b298a230c0"><data key="edge_predicate_raw">disclosed</data><data key="edge_assertion_id">a_79aac04c11b93fab</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">Alternatively, access to only some restricted information is obtained, but the disclosed information presents a direct, serious impact</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">disclosed</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["disclosed"]</data></edge><edge id="oe_aca502fb70d29c1c" source="e_d2b630e61129d09b" target="e_26e0466f06957bd3"><data key="edge_predicate_raw">be protected by</data><data key="edge_assertion_id">a_9772b6971dcd5120</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, the attacker is able to modify any/all files protected by the impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be protected by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be protected by"]</data></edge><edge id="oe_98304a48fcca86d2" source="e_332fd4a216e1c401" target="e_2228b2b192c550b5"><data key="edge_predicate_raw">be resulting from</data><data key="edge_assertion_id">a_88f7212581ae2850</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric measures the impact to the availability of the impacted component resulting from a successfully exploited vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be resulting from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be resulting from"]</data></edge><edge id="oe_4282e825329ae288" source="e_dfd2e098a96fa540" target="e_53dd9263602ab61d"><data key="edge_predicate_raw">apply to loss of</data><data key="edge_assertion_id">a_901592c1525b2cab</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">While the Confidentiality and Integrity impact metrics apply to the loss of confidentiality or integrity of data (e.g., information, files) used by the impacted component, this metric refers to the loss of availability of the impacted component itself, such as a networked service (e.g., web, database, email)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">apply to loss of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["apply to loss of"]</data></edge><edge id="oe_20223e0dd66ab10c" source="e_09f091e141fb1fa3" target="e_53dd9263602ab61d"><data key="edge_predicate_raw">apply to loss of</data><data key="edge_assertion_id">a_e396381cdec0b836</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">While the Confidentiality and Integrity impact metrics apply to the loss of confidentiality or integrity of data (e.g., information, files) used by the impacted component, this metric refers to the loss of availability of the impacted component itself, such as a networked service (e.g., web, database, email)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">apply to loss of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["apply to loss of"]</data></edge><edge id="oe_9eaf89d060a95ca3" source="e_61641163de7ce9bc" target="e_26e0466f06957bd3"><data key="edge_predicate_raw">be used by</data><data key="edge_assertion_id">a_73beaaa030087dfc</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">While the Confidentiality and Integrity impact metrics apply to the loss of confidentiality or integrity of data (e.g., information, files) used by the impacted component, this metric refers to the loss of availability of the impacted component itself, such as a networked service (e.g., web, database, email)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be used by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be used by"]</data></edge><edge id="oe_dca5c5fecd99c9b1" source="e_e56e3d4771ca46d9" target="e_841d5cae83210039"><data key="edge_predicate_raw">refers to accessibility of</data><data key="edge_assertion_id">a_f8c56d5b53583497</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">refers to accessibility of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["refers to accessibility of"]</data></edge><edge id="oe_c668d281a54d4ef6" source="e_e56e3d4771ca46d9" target="e_bf0bee0969a73481"><data key="edge_predicate_raw">refers to accessibility of</data><data key="edge_assertion_id">a_7b79497c82cd662c</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">refers to accessibility of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["refers to accessibility of"]</data></edge><edge id="oe_ca50c756d8aeb222" source="e_e56e3d4771ca46d9" target="e_d37e8eb9896152d1"><data key="edge_predicate_raw">refers to accessibility of</data><data key="edge_assertion_id">a_009532a9f8f69777</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">refers to accessibility of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["refers to accessibility of"]</data></edge><edge id="oe_ac368b210e6e63af" source="e_22e800482ee5b5fd" target="e_4058f076b2d4719d"><data key="edge_predicate_raw">consume</data><data key="edge_assertion_id">a_e72c45d3fc5bb67c</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">consume</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["consume"]</data></edge><edge id="oe_382b2e34b3dac53d" source="e_d8d9b706557f592e" target="e_fbbdf1417a7b6e3e"><data key="edge_predicate_raw">be deny</data><data key="edge_assertion_id">a_630d46f99936028b</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Even if repeated exploitation of the vulnerability is possible, the attacker does not have the ability to completely deny service to legitimate users</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be deny</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be deny"]</data></edge><edge id="oe_036cdc8d56ff2d29" source="e_d8d9b706557f592e" target="e_9111a79bb0a0398b"><data key="edge_predicate_raw">be deny</data><data key="edge_assertion_id">a_47c81901c04a1c33</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Even if repeated exploitation of the vulnerability is possible, the attacker does not have the ability to completely deny service to legitimate users</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be deny</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be deny"]</data></edge><edge id="oe_8cae3239446a9ea2" source="e_d558a240751fca46" target="e_eebb7de3e9bfb149"><data key="edge_predicate_raw">measure current state of</data><data key="edge_assertion_id">a_bffb8bdc6765d1be</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Temporal metrics measure the current state of exploit techniques or code availability, the existence of any patches or workarounds, or the confidence in the description of a vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">measure current state of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["measure current state of"]</data></edge><edge id="oe_fac47aafe0c9148a" source="e_d558a240751fca46" target="e_1d5201ae87cbebb9"><data key="edge_predicate_raw">measure current state of</data><data key="edge_assertion_id">a_e2126c6987047ddc</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Temporal metrics measure the current state of exploit techniques or code availability, the existence of any patches or workarounds, or the confidence in the description of a vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">measure current state of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["measure current state of"]</data></edge><edge id="oe_1f1427b4c97c4463" source="e_a0e85d60baf1bcae" target="e_0f0dfafa6203250d"><data key="edge_predicate_raw">progress from</data><data key="edge_assertion_id">a_a3710bd770c12e78</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Furthermore, the exploit code available may progress from a proof-of-concept demonstration to exploit code that is successful in exploiting the vulnerability consistently</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">progress from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["progress from"]</data></edge><edge id="oe_d6de8a194b9a633a" source="e_527c56c7674a26dd" target="e_904da0b4f3960fb3"><data key="edge_predicate_raw">is important factor for</data><data key="edge_assertion_id">a_5a57ecd5b66d7efb</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">The Remediation Level of a vulnerability is an important factor for prioritization</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is important factor for</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is important factor for"]</data></edge><edge id="oe_81c35cb09b8434d6" source="e_4228490cbf8a6d91" target="e_98c110f1e21aa4eb"><data key="edge_predicate_raw">is unpatched when</data><data key="edge_assertion_id">a_885d224e84d54727</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">The typical vulnerability is unpatched when initially published</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is unpatched when</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is unpatched when"]</data></edge><edge id="oe_608c710e966cc4fa" source="e_edf56b768b8904e2" target="e_a568574ebde0ab4b"><data key="edge_predicate_raw">becomes</data><data key="edge_assertion_id">a_c079f85f29d35b21</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">Each of these respective stages adjusts the Temporal Score downwards, reflecting the decreasing urgency as remediation becomes final</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">becomes</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["becomes", "has become"]</data></edge><edge id="oe_fa3ddda0d4fd72ac" source="e_dbd1ba0cc63988dc" target="e_cf4606d100a09d0c"><data key="edge_predicate_raw">is known to exist with</data><data key="edge_assertion_id">a_98177f87195f329d</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">The urgency of a vulnerability is higher when a vulnerability is known to exist with certainty</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is known to exist with</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is known to exist with"]</data></edge><edge id="oe_647a28dd5997b4cf" source="e_4676679afd99eed0" target="e_3655237b10b88be1"><data key="edge_predicate_raw">suggests</data><data key="edge_assertion_id">a_979820626c5b0e3b</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric also suggests the level of technical knowledge available to would-be attackers</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">suggests</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["suggests"]</data></edge><edge id="oe_44d0b9e1b5b0a6c9" source="e_dbd1ba0cc63988dc" target="e_99980f1fd9e9f9d2"><data key="edge_predicate_raw">is validated by vendor</data><data key="edge_assertion_id">a_fabb7e1afdeef127</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">The more a vulnerability is validated by the vendor or other reputable sources, the higher the score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is validated by vendor</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is validated by vendor"]</data></edge><edge id="oe_ae40d38ef67506aa" source="e_dbd1ba0cc63988dc" target="e_99980f1fd9e9f9d2"><data key="edge_predicate_raw">is validated by other reputable sources</data><data key="edge_assertion_id">a_7eb603a0c56723ed</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">The more a vulnerability is validated by the vendor or other reputable sources, the higher the score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is validated by other reputable sources</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is validated by other reputable sources"]</data></edge><edge id="oe_e8f477e8086d9448" source="e_5b4bd0dc3a688939" target="e_e163460c91338b08"><data key="edge_predicate_raw">provide</data><data key="edge_assertion_id">a_8324e96ff4252812</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">Reasonable confidence exists, however, that the bug is reproducible and at least one impact is able to be verified (proof-of-concept exploits may provide this)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">provides</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["provides", "provide"]</data></edge><edge id="oe_3b72ebddc46dad24" source="e_5fa67428538ac0a0" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">differ on cause of</data><data key="edge_assertion_id">a_166af5686184cadd</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">The reports indicate that the cause of the vulnerability is unknown, or reports may differ on the cause or impacts of the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">differ on cause of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["differ on cause of"]</data></edge><edge id="oe_fc1eb82bd884d34d" source="e_5fa67428538ac0a0" target="e_57598c70746601d2"><data key="edge_predicate_raw">differ on</data><data key="edge_assertion_id">a_70a430c696ff0ebc</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">The reports indicate that the cause of the vulnerability is unknown, or reports may differ on the cause or impacts of the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">differ on</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["differ on"]</data></edge><edge id="oe_1f77dc3e09449b19" source="e_b39009419fada99a" target="e_4d8f9e8bdafd1675"><data key="edge_predicate_raw">is determined by</data><data key="edge_assertion_id">a_aa31e336879948a9</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C13</data><data key="edge_json_path">None</data><data key="edge_evidence">The full effect on the environmental score is determined by the corresponding Modified Base Impact metrics</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is determined by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is determined by"]</data></edge><edge id="oe_99a5fa75932971ff" source="e_c11703dfc0efe312" target="e_26f020227348bd77"><data key="edge_predicate_raw">change</data><data key="edge_assertion_id">a_b13e86ff21e7a234</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C13</data><data key="edge_json_path">None</data><data key="edge_evidence">Also, increasing the Confidentiality Requirement from Medium to High will not change the Environmental score when the (Modified Base) impact metrics are set to High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">change</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["change", "changes"]</data></edge><edge id="oe_8c3603fcb0d454be" source="e_aeb2050fed2c22c1" target="e_6ec3afa21d9dd06b"><data key="edge_predicate_raw">is part of</data><data key="edge_assertion_id">a_6250bbac5eae0a17</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C13</data><data key="edge_json_path">None</data><data key="edge_evidence">This is because the Modified Impact Sub-Score (part of the Modified Base Score that calculates impact) is already at a maximum value of 10</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are part of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are part of", "is part of"]</data></edge><edge id="oe_115d6ddff4e1ac00" source="e_b39009419fada99a" target="e_9b301e09540d09fc"><data key="edge_predicate_raw">is determined by</data><data key="edge_assertion_id">a_054405bb556adf26</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">The full effect on the Environmental score is determined by the corresponding Base metrics</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is determined by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is determined by"]</data></edge><edge id="oe_15952e57e32655db" source="e_1db208fac24377d1" target="e_5ad6c123e5abaf11"><data key="edge_predicate_raw">be to run listening service with administrator privileges For</data><data key="edge_assertion_id">a_76c1504328e9fe8e</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, the default configuration for a vulnerable component may be to run a listening service with administrator privileges, for which a compromise might grant an attacker Confidentiality, Integrity, and Availability impacts that are all High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be to run listening service with administrator privileges For</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be to run listening service with administrator privileges For"]</data></edge><edge id="oe_721a701d1c972bab" source="e_1db208fac24377d1" target="e_5ad6c123e5abaf11"><data key="edge_predicate_raw">be to run Availability impacts For</data><data key="edge_assertion_id">a_b528205c59e57588</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, the default configuration for a vulnerable component may be to run a listening service with administrator privileges, for which a compromise might grant an attacker Confidentiality, Integrity, and Availability impacts that are all High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be to run Availability impacts For</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be to run Availability impacts For"]</data></edge><edge id="oe_ecb7bc31793dec20" source="e_1db208fac24377d1" target="e_24724c67123f239d"><data key="edge_predicate_raw">be to run listening service with</data><data key="edge_assertion_id">a_d156e235e75e7182</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, the default configuration for a vulnerable component may be to run a listening service with administrator privileges, for which a compromise might grant an attacker Confidentiality, Integrity, and Availability impacts that are all High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be to run listening service with</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be to run listening service with"]</data></edge><edge id="oe_6ac2b08d202d66f2" source="e_1db208fac24377d1" target="e_349144947774f114"><data key="edge_predicate_raw">be to run</data><data key="edge_assertion_id">a_1a04c71b9d05df4c</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, the default configuration for a vulnerable component may be to run a listening service with administrator privileges, for which a compromise might grant an attacker Confidentiality, Integrity, and Availability impacts that are all High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be to run</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be to run"]</data></edge><edge id="oe_9726f966bc9074a1" source="e_2777340d458412d6" target="e_24724c67123f239d"><data key="edge_predicate_raw">grant attacker Confidentiality listening service with</data><data key="edge_assertion_id">a_fa47af53cd123d02</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, the default configuration for a vulnerable component may be to run a listening service with administrator privileges, for which a compromise might grant an attacker Confidentiality, Integrity, and Availability impacts that are all High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">grant attacker Confidentiality listening service with</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["grant attacker Confidentiality listening service with"]</data></edge><edge id="oe_490ccb824d97cb09" source="e_2777340d458412d6" target="e_349144947774f114"><data key="edge_predicate_raw">grant attacker Confidentiality</data><data key="edge_assertion_id">a_8bf3bbb81e9b8492</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, the default configuration for a vulnerable component may be to run a listening service with administrator privileges, for which a compromise might grant an attacker Confidentiality, Integrity, and Availability impacts that are all High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">grant attacker Confidentiality</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["grant attacker Confidentiality"]</data></edge><edge id="oe_2dcde2baba1a011a" source="e_2cbef1015e8443fb" target="e_040dc8c7ec38f443"><data key="edge_predicate_raw">be running with</data><data key="edge_assertion_id">a_60cb981953e82a43</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">Yet, in the analyst’s environment, that same Internet service might be running with reduced privileges; in that case, the Modified Confidentiality, Modified Integrity, and Modified Availability might each be set to Low</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be running with</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be running with"]</data></edge><edge id="oe_55009680f46949a6" source="e_a00feff6fcb1c982" target="e_b35718531dfb7863"><data key="edge_predicate_raw">uses</data><data key="edge_assertion_id">a_6ae23983d59ffabc</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">Not Defined is the default and uses the metric value of the associated Base metric</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">use</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["use", "uses", "do use", "Uses"]</data></edge><edge id="oe_3bc239686cef58e9" source="e_596a3f18c38132af" target="e_db5858cf6e7acd99"><data key="edge_predicate_raw">be represent</data><data key="edge_assertion_id">a_6eb798da84301668</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">It is acceptable to use the modified metrics to represent situations that increase the Base Score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be represent</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be represent"]</data></edge><edge id="oe_58e5662eaa4cfbb9" source="e_db5858cf6e7acd99" target="e_5dd63c0e6e0c1501"><data key="edge_predicate_raw">increase</data><data key="edge_assertion_id">a_ac389cadc3dab111</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">It is acceptable to use the modified metrics to represent situations that increase the Base Score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">increase</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["increase"]</data></edge><edge id="oe_6b79b834d5d72463" source="e_f6498126c94c6f96" target="e_506193cfefade053"><data key="edge_predicate_raw">set</data><data key="edge_assertion_id">a_829aee24b237c44e</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">The analyst can set Privileges Required to High and Modified Privileges Required to None to reflect this more serious condition in their particular environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">set</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["set"]</data></edge><edge id="oe_13aac2fe6f04474b" source="e_f6498126c94c6f96" target="e_8baba9b928c90883"><data key="edge_predicate_raw">set</data><data key="edge_assertion_id">a_e7e52912b5b3cbf4</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">The analyst can set Privileges Required to High and Modified Privileges Required to None to reflect this more serious condition in their particular environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">set</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["set"]</data></edge><edge id="oe_585eb2d6e17f349d" source="e_6cb481a83536ac29" target="e_f90f01579634abed"><data key="edge_predicate_raw">be Required to</data><data key="edge_assertion_id">a_3e8bb0e2c711cbd4</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">The analyst can set Privileges Required to High and Modified Privileges Required to None to reflect this more serious condition in their particular environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be Required to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be Required to"]</data></edge><edge id="oe_ad6005eea11221e3" source="e_cbda6adb410f4617" target="e_f90f01579634abed"><data key="edge_predicate_raw">be Required to</data><data key="edge_assertion_id">a_7139abc6f2a50aa6</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">The analyst can set Privileges Required to High and Modified Privileges Required to None to reflect this more serious condition in their particular environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be Required to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be Required to"]</data></edge><edge id="oe_ab22de6ccf337208" source="e_290d8da624d84fb0" target="e_2e1496c46b0c67cc"><data key="edge_predicate_raw">help</data><data key="edge_assertion_id">a_0d7fbe5fd952e43d</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">They are intended to help organizations properly assess and prioritize their vulnerability management processes</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">help</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["help"]</data></edge><edge id="oe_a2115e0b5714fc10" source="e_290d8da624d84fb0" target="e_40e21c1bf87487d6"><data key="edge_predicate_raw">help</data><data key="edge_assertion_id">a_93a87595afe53471</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">They are intended to help organizations properly assess and prioritize their vulnerability management processes</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">help</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["help"]</data></edge><edge id="oe_609628adca22ca25" source="e_ad16450d4d7b98f8" target="e_3871d9a29382ae85"><data key="edge_predicate_raw">is used to record CVSS metric information in</data><data key="edge_assertion_id">a_11b099da271ec53d</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">It is commonly used to record or transfer CVSS metric information in a concise form</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is used to record CVSS metric information in</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is used to record CVSS metric information in"]</data></edge><edge id="oe_978f0c75e5181a3a" source="e_ad16450d4d7b98f8" target="e_11d9e0f2a7ae327b"><data key="edge_predicate_raw">is used to record</data><data key="edge_assertion_id">a_42b39f523c0db2e5</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">It is commonly used to record or transfer CVSS metric information in a concise form</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is used to record</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is used to record"]</data></edge><edge id="oe_29316c152cc1d9a2" source="e_9e8758f7636f5ca5" target="e_534c943c598a31b3"><data key="edge_predicate_raw">are defined</data><data key="edge_assertion_id">a_93e86c4ed7c1580f</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">The abbreviated forms are defined earlier in this specification (in parentheses after each metric name and metric value), and are summarized in the table below</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are defined</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are defined", "defined", "has defined"]</data></edge><edge id="oe_07d1a2ab92c5b745" source="e_075097bc32ffa89f" target="e_afccd7a4fc5871a9"><data key="edge_predicate_raw">are considered to have value of</data><data key="edge_assertion_id">a_40284b9a296f3e5d</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">Temporal and Environmental metrics are optional, and omitted metrics are considered to have the value of Not Defined (X)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are considered to have value of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are considered to have value of"]</data></edge><edge id="oe_12adaced19bcc73f" source="e_8c5bdfed19c88e1e" target="e_97d5b9fcbb9ac78b"><data key="edge_predicate_raw">be included in</data><data key="edge_assertion_id">a_0ae1a21939be916a</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">Metrics with a value of Not Defined can be explicitly included in a vector string if desired</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be included in</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be included in"]</data></edge><edge id="oe_f1a3a3af602b9605" source="e_b701b8d9e7fc2ef7" target="e_79a5b245db4e61f6"><data key="edge_predicate_raw">be defined as</data><data key="edge_assertion_id">a_2ac58ca34024724b</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">They rely on helper functions defined as follows:</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be defined as</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be defined as"]</data></edge><edge id="oe_5b5f9be1167043b6" source="e_016e1eb518d9e09e" target="e_1c91229f829a5a65"><data key="edge_predicate_raw">depends on</data><data key="edge_assertion_id">a_3bff285a32c826ec</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental Score formula depends on sub-formulas for Modified Impact Sub-Score (MISS), ModifiedImpact, and ModifiedExploitability, all of which are defined below:</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">depends on</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["depends on"]</data></edge><edge id="oe_242e22475d7fe467" source="e_b82be424e7d21f94" target="e_fa82717f64d9c8f8"><data key="edge_predicate_raw">is used in</data><data key="edge_assertion_id">a_04653d93577930c3</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Each metric value has an associated constant which is used in the formulas, as defined in Table 16</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is used in</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is used in"]</data></edge><edge id="oe_19f3d15e7fcd9331" source="e_fa203e179c5c81e8" target="e_67f1649aba40d451"><data key="edge_predicate_raw">framed lookup table by</data><data key="edge_assertion_id">a_3b07d14b83c8b270</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">To produce the CVSS v3.1 formula, the CVSS Special Interest Group (SIG) framed the lookup table by assigning metric values to real vulnerabilities, and a severity group (low, medium, high, critical)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">framed lookup table by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["framed lookup table by"]</data></edge><edge id="oe_3a08cd1ac241be5d" source="e_fa203e179c5c81e8" target="e_5d29e070ca4b816a"><data key="edge_predicate_raw">framed lookup table to</data><data key="edge_assertion_id">a_be047796c2f4f33e</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">To produce the CVSS v3.1 formula, the CVSS Special Interest Group (SIG) framed the lookup table by assigning metric values to real vulnerabilities, and a severity group (low, medium, high, critical)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">framed lookup table to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["framed lookup table to"]</data></edge><edge id="oe_087e2642e64f6329" source="e_fa203e179c5c81e8" target="e_487f2d8360640345"><data key="edge_predicate_raw">framed</data><data key="edge_assertion_id">a_75116df916ec35dc</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">To produce the CVSS v3.1 formula, the CVSS Special Interest Group (SIG) framed the lookup table by assigning metric values to real vulnerabilities, and a severity group (low, medium, high, critical)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">framed</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["framed"]</data></edge><edge id="oe_fb582c8701ea99b4" source="e_3c6f55c088fab9eb" target="e_9fc2c1fad4a8c45c"><data key="edge_predicate_raw">collaborated with Deloitte &amp; Touche LLP to adjust</data><data key="edge_assertion_id">a_252d65791e0f9f33</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Having defined the acceptable numeric ranges for each severity level, the SIG then collaborated with Deloitte &amp; Touche LLP to adjust formula parameters in order to align the metric combinations to the SIG's proposed severity ratings</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">collaborated with Deloitte &amp; Touche LLP to adjust</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["collaborated with Deloitte &amp; Touche LLP to adjust"]</data></edge><edge id="oe_8b954f0300418882" source="e_3c6f55c088fab9eb" target="e_8204267493148c65"><data key="edge_predicate_raw">collaborated with Deloitte &amp; Touche LLP to adjust</data><data key="edge_assertion_id">a_6c2a3a36d3b65e24</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data 