data key="edge_range">Mention</data><data key="edge_derived_from">["provides", "provide"]</data></edge><edge id="oe_e95e0049911f8f40" source="e_5dd76c3d97c6af6d" target="e_3cdb923a4b9358e0"><data key="edge_predicate_raw">address</data><data key="edge_assertion_id">a_42331a7b9cc44a98</data><data key="edge_source_id">S11</data><data key="edge_source_url">https://www.bleepingcomputer.com/news/security/critical-vmware-vcenter-rce-flaw-exploited-for-reverse-ssh-access/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">The following vCenter releases address the security issue:</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">address</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["address"]</data></edge><edge id="oe_0543084a3f91b343" source="e_8082526e9187e149" target="e_74d5d203b0e879d4"><data key="edge_predicate_raw">use access for</data><data key="edge_assertion_id">a_5a9f6737c8fc762d</data><data key="edge_source_id">S11</data><data key="edge_source_url">https://www.bleepingcomputer.com/news/security/critical-vmware-vcenter-rce-flaw-exploited-for-reverse-ssh-access/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Attackers can use this access for data theft and operational disruptions</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">use access for</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["use access for"]</data></edge><edge id="oe_76ad94c6f72bc890" source="e_8082526e9187e149" target="e_204577d9c8282b6c"><data key="edge_predicate_raw">use access for</data><data key="edge_assertion_id">a_9044d4030f1156ea</data><data key="edge_source_id">S11</data><data key="edge_source_url">https://www.bleepingcomputer.com/news/security/critical-vmware-vcenter-rce-flaw-exploited-for-reverse-ssh-access/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Attackers can use this access for data theft and operational disruptions</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">use access for</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["use access for"]</data></edge><edge id="oe_e6cae41098758304" source="e_d17d99c2914fb3fa" target="e_855a19bc23e9e737"><data key="edge_predicate_raw">disclosed</data><data key="edge_assertion_id">a_35f673da4397b778</data><data key="edge_source_id">S11</data><data key="edge_source_url">https://www.bleepingcomputer.com/news/security/critical-vmware-vcenter-rce-flaw-exploited-for-reverse-ssh-access/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">According to digital forensics and incident response (DFIR) company QUIRSO, compromised systems started to connect to attacker-controlled infrastructure on August 3, just five days after Broadcom disclosed the flaw and released the emergency patch</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">reported</data><data key="edge_predicate_canonical">disclosed</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["disclosed"]</data></edge><edge id="oe_cbdb390f62f7d1b4" source="e_d17d99c2914fb3fa" target="e_5b3bfad209e6918c"><data key="edge_predicate_raw">released</data><data key="edge_assertion_id">a_791a5c45ec1b7dc2</data><data key="edge_source_id">S11</data><data key="edge