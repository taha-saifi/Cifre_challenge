ion</data><data key="edge_derived_from">["are as"]</data></edge><edge id="oe_a1e22b76d43fe340" source="e_b3c77c913f52e355" target="e_8913949ce3c45f5f"><data key="edge_predicate_raw">be considered</data><data key="edge_assertion_id">a_c8fab54fbe620ce8</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">These interactions would be considered involuntary and do not require that the user actively subvert protections built into the vulnerable component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be considered</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be considered"]</data></edge><edge id="oe_00c44a5535ac07aa" source="e_dda76eeedb5c35a4" target="e_0651ca14b1e582f2"><data key="edge_predicate_raw">subvert protections built into</data><data key="edge_assertion_id">a_f9dbf6321f7951aa</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">These interactions would be considered involuntary and do not require that the user actively subvert protections built into the vulnerable component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">subvert protections built into</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["subvert protections built into"]</data></edge><edge id="oe_001b0e28240c620f" source="e_e8580183c3bd0734" target="e_0651ca14b1e582f2"><data key="edge_predic