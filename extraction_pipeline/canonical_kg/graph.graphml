idence">Scores are generated by Empirical Security and published freely to the community</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">published to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["published to"]</data></edge><edge id="oe_e7f1b822d01abf7c" source="e_ad16450d4d7b98f8" target="e_1582bf11e3cea95e"><data key="edge_predicate_raw">be used for</data><data key="edge_assertion_id">a_a07a771e62c732ca</data><data key="edge_source_id">S48</data><data key="edge_source_url">https://www.first.org/epss/data.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">It should not be used for bulk downloads or to keep a local copy of all scores in sync; the daily CSV or the GitHub repository is the right mechanism for that</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be used for</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be used for"]</data></edge><edge id="oe_eca6202d8b52e5c7" source="e_fb6b8acc2003367f" target="e_a55bf2a863bd53c9"><data key="edge_predicate_raw">be filtering by</data><data key="edge_assertion_id">a_de91a7a59ab23547</data><data key="edge_source_id">S48</data><data key="edge_source_url">https://www.first.org/epss/data.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Basic filtering by score or percentile range is also available, as is partial CVE ID search</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be filtering by</data><data key="e