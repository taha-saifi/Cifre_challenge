 key="edge_evidence">It is an open framework, providing transparency to the individual characteristics and methodology used to derive a score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be providing transparency to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be providing transparency to"]</data></edge><edge id="oe_9f85d5546f3fb10c" source="e_ebf85728d7cf1dba" target="e_4364e67a28b13c95"><data key="edge_predicate_raw">be used to derive</data><data key="edge_assertion_id">a_49214a10270b10b4</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">It is an open framework, providing transparency to the individual characteristics and methodology used to derive a score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be used to derive</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be used to derive"]</data></edge><edge id="oe_ccfac504c31642e6" source="e_959f52a470454532" target="e_4364e67a28b13c95"><data key="edge_predicate_raw">be used to derive</data><data key="edge_assertion_id">a_debff4f72a3670fc</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">It is an open framework, providing transparency to the individual characteristics and methodology used to derive a score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be used to derive</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be used to derive"]</data></edge><edge id="oe_53c045478e78a2e2" source="e_dbd1ba0cc63988dc" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">are constant over</data><data key="edge_assertion_id">a_c7a1a627c301dfc5</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base metric group represents the intrinsic characteristics of a vulnerability that are constant over time and across user environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are constant over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are constant over"]</data></edge><edge id="oe_94e397418a381dc7" source="e_dbd1ba0cc63988dc" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">are across user environments over</data><data key="edge_assertion_id">a_b499b70c38af8321</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base metric group represents the intrinsic characteristics of a vulnerability that are constant over time and across user environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are across user environments over</data><data key="edge_domain">Mention</dat