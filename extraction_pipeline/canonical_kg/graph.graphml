932d" source="e_6c0b4943a8517fe8" target="e_962247e73ff45cc0"><data key="edge_predicate_raw">be resulting from</data><data key="edge_assertion_id">a_88f96dfe11d62d62</data><data key="edge_source_id">S14</data><data key="edge_source_url">https://advisories.ncsc.nl/2026/ncsc-2026-0280.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">This includes damage resulting from the inaccuracy of incompleteness of the information contained in the advisory</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be resulting from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be resulting from"]</data></edge><edge id="oe_e122a3e19286af3b" source="e_40266d42023f0dec" target="e_d11166eda6870fd7"><data key="edge_predicate_raw">contained in</data><data key="edge_assertion_id">a_52e877bce4670365</data><data key="edge_source_id">S14</data><data key="edge_source_url">https://advisories.ncsc.nl/2026/ncsc-2026-0280.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">This includes damage resulting from the inaccuracy of incompleteness of the information contained in the advisory</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">contained in</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["contained in"]</data></edge><edge id="oe_42a27ee461a0a909" source="e_c640b07275fb382c" target="e_c1caf615bb3f3827"><data key="edge_predicate_raw">applies to court in</data><data key="edge_assertion_id">a_456d15cb59780cf6</data><data key="edge_source_id">S14</data><data key="edge_source_url">https://advisories.ncsc.nl/2026/ncsc-2026-0280.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">This choice of means also applies to the court in summary proceedings</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">applies to court in</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["applies to court in"]</data></edge><edge id="oe_d067428ea9440758" source="e_8ebcaa1932cfd664" target="e_9f4bc004f1ab89c0"><data key="edge_predicate_raw">reference</data><data key="edge_assertion_id">a_b52240039764910f</data><data key="edge_source_id">S15</data><data key="edge_source_url">https://support.apple.com/en-us/148170</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Apple security documents reference vulnerabilities by CVE-ID when possible</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">references</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["references", "reference"]</data></edge><edge id="oe_34d42976b069c4cb" source="e_3eb110d7e94020fe" target="e_e34fe17564b60f38"><data key="edge_predicate_raw">be Sharing without</data><data key="edge_assertion_id">a_49f42dd49c896b31</data><data key="edge_source_id">S15</data><data key="edge_source_url">https://support.apple.com/en-us/148170</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Impact: An attacker on the network may be able to authenticate to Screen Sharing without valid credentials</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be Sharing without</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be Sharing without"]</data></edge><edge id="oe_7912aff923ca9d16" source="e_7614843fc4819b5b" target="e_f73c2b3cb44984d0"><data key="edge_predicate_raw">was addressed with</data><data key="edge_assertion_id">a_0e0ffff3887268ba</data><data key="edge_source_id">S15</data><data key="edge_source_url">https://support.apple.com/en-us/148170</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Description: An authentication issue was addressed with improved state management</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">was addressed with</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["was addressed with"]</data></edge><edge id="oe_c3b9beccf0bed8c3" source="e_cbbc144377acf78b" target="e_33fdb3aa956311a8"><data key="edge_predicate_raw">is provided without</data><data key="edge_assertion_id">a_ce9cdf79cb8b34dd</data><data key="edge_source_id">S15</data><data key="edge_source_url">https://support.apple.com/en-us/148170</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Information about products not manufactured by Apple, or independent websites not controlled or tested by Apple, is provided without recommendation or endorsement</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is provided without</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is provided without"]</data></edge><edge id="oe_0691ce4d1da30b3c" source="e_cbbc144377acf78b" 