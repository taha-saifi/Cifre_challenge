ge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumer: The security team that manages the environment in which the vulnerable product is deployed</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">manages</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["manages"]</data></edge><edge id="oe_6b909cf0d7e3f76c" source="e_963d5ef03119d4bc" target="e_703e5aacf73947bc"><data key="edge_predicate_raw">be associated with</data><data key="edge_assertion_id">a_67c8b499a2a16e1b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Mitigation (Control): A decision, action, or practice intended to reduce the level of risk associated with one or more threat events, threat scenarios, or vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be associated with</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be associated with"]</data></edge><edge id="oe_7fe5231df94c6ca6" source="e_de49ea449b555952" target="e_dda76eeedb5c35a4"><data key="edge_predicate_raw">be granted to</data><data key="edge_assertion_id">a_5bd4f451d4691a27</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Privilege: A collection of rights (typically read, write, and execute) granted to a user or user process which defines access to computing resources</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be granted to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be granted to"]</data></edge><edge id="oe_88a7ee5e6f5a319c" source="e_de49ea449b555952" target="e_8f6ea20e4dd6a338"><data key="edge_predicate_raw">be granted to</data><data key="edge_assertion_id">a_740e68a835a7f234</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Privilege: A collection of rights (typically read, write, and execute) granted to a user or user process which defines access to computing resources</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be granted to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be granted to"]</data></edge><edge id="oe_c68d6de96b438817" source="e_dda76eeedb5c35a4" target="e_5f9cc70e561d50d7"><data key="edge_predicate_raw">defines</data><data key="edge_assertion_id">a_191e9de72905ee17</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Privilege: A collection of rights (typically read, write, and execute) granted to a user or user process which defines access to computing resources</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">define</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["define", "defines"]</data></edge><edge id="oe_27aa4639942ca7dc" source="e_8f6ea20e4dd6a338" target="e_5f9cc70e561d50d7"><data key="edge_predicate_raw">defines</data><data key="edge_assertion_id">a_46c77ea8ea0171ef</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Privilege: A collection of rights (typically read, write, and execute) granted to a user or user process which defines access to computing resources</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">define</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["define", "defines"]</data></edge><edge id="oe_0a142d3ef5e355c7" source="e_17cea645971f898b" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">be used to demonstrate existence of</data><data key="edge_assertion_id">a_b10393d34cbd38f8</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Proof-of-Concept exploit code: Software or sufficient technical details that can be used to demonstrate the existence of a vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be used to demonstrate existence of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be used to demonstrate existence of"]</data></edge><edge id="oe_a3729ea80f68678a" source="e_9a03a9aedb645c2d" target="e_7bc66a71c6cc9944"><data key="edge_predicate_raw">provides</data><data key="edge_assertion_id">a_f2bd9c7264c6cdc0</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C22</data><data key="edge_json_path">None</data><data key="edge_evidence">Security policy: A set of policy rules (or principles) that direct how a system (or an organization) provides security services to protect sensitive and critical system resources.11</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">provides</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["provides", "provide"]</data></edge><edge id="oe_e2438d11e3059113" source="e_aa5d4cdb8743a06c" target="e_ad16450d4d7b98f8"><data key="edge_predicate_raw">include</data><data key="edge_assertion_id">a_621298d45c0a8b7d</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C22</data><data key="edge_json_path">None</data><data key="edge_evidence">Information systems include, for example, IT systems, ICS systems, OT systems, computing hardware, and so on</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">include</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["include", "includes"]</data></edge><edge id="oe_2efbabf326266aff" source="e_65a2bc8471f9273a" target="e_87a35caaa98faf5a"><data key="edge_predicate_raw">is violated as result of</data><data key="edge_assertion_id">a_7ac8bb07045fc752</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C22</data><data key="edge_json_path">None</data><data key="edge_evidence">Subsequent System: A system whose security policy is violated as a result of the exploited vulnerability but that is not the Vulnerable System</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is violated as result of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is violated as result of"]</data></edge><edge id="oe_cc20813e81652b62" source="e_80403aa9bda2cfc7" target="e_87a35caaa98faf5a"><data key="edge_predicate_raw">is violated as result of</data><data key="edge_assertion_id">a_96c634e48c321e91</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C22</data><data key="edge_json_path">None</data><data key="edge_evidence">Subsequent System: A system whose security policy is violated as a result of the exploited vulnerability but that is not the Vulnerable System</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is violated as result of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is violated as result of"]</data></edge><edge id="oe_73989a836b213a90" source="e_668be19210801bc1" target="e_adb86950277d31be"><data key="edge_predicate_raw">contribute to production of</data><data key="edge_assertion_id">a_baf3b0b231c1c195</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C22</data><data key="edge_json_path">None</data><data key="edge_evidence">Supply Chain: A subset of industry members (often cutting across many industries) that contribute to the production of goods and services that an organization (industry, or geopolitical entity) consumes</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">contribute to production of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["contribute to production of"]</data></edge><edge id="oe_205bfdaf9263961e" source="e_668be19210801bc1" target="e_aedfa9daeec6ba5f"><data key="edge_predicate_raw">contribute to production of</data><data key="edge_assertion_id">a_70871f9153cf8427</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C22</data><data key="edge_json_path">None</data><data key="edge_evidence">Supply Chain: A subset of industry members (often cutting across many industries) that contribute to the production of goods and services that an organization (industry, or geopolitical entity) consumes</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">contribute to production of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["contribute to production of"]</data></edge><edge id="oe_2d96db90d56810a2" source="e_65a2bc8471f9273a" target="e_87a35caaa98faf5a"><data key="edge_predicate_raw">is violated as result of</data><data key="edge_assertion_id">a_02a1a510934b1618</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C23</data><data key="edge_json_path">None</data><data key="edge_evidence">Vulnerable System: A system whose security policy is violated as the result of an exploited vulnerability and which contains the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is violated as result of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is violated as result of"]</data></edge><edge id="oe_7a9190a2d84d56e2" source="e_06e725c9e9907cc0" target="e_5086ede60e614714"><data key="edge_predicate_raw">are aid to scoring</data><data key="edge_assertion_id">a_4b9fc6b84d7a4d3a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C23</data><data key="edge_json_path">None</data><data key="edge_evidence">The scoring rubrics are an aid to scoring vulnerabilities by supplementing the metric definitions in the Specification Document</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are aid to scoring</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are aid to scoring"]</data></edge><edge id="oe_01e5d39b777d0867" source="e_b585119b28a1d6c9" target="e_cf503d8a57cdc58d"><data key="edge_predicate_raw">is open framework for communicating characteristics of</data><data key="edge_assertion_id">a_484408a480f6e209</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Common Vulnerability Scoring System (CVSS) is an open framework for communicating the characteristics and severity of software vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is open framework for communicating characteristics of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is open framework for communicating characteristics of"]</data></edge><edge id="oe_aa09a6a0d03f6677" source="e_b585119b28a1d6c9" target="e_e6145aa9c0971bc2"><data key="edge_predicate_raw">is open framework for</data><data key="edge_assertion_id">a_08b2d9da9b94e0fc</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Common Vulnerability Scoring System (CVSS) is an open framework for communicating the characteristics and severity of software vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is open framework for</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is open framework for"]</data></edge><edge id="oe_3d0eb1d6e16b0558" source="e_dbd1ba0cc63988dc" target="e_44fb585ec7e6699b"><data key="edge_predicate_raw">are unique to</data><data key="edge_assertion_id">a_0186308facaf1cb8</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base group represents the intrinsic qualities of a vulnerability that are constant over time and across user environments, the Temporal group reflects the characteristics of a vulnerability that change over time, and the Environmental group represents the characteristics of a vulnerability that are unique to a user's environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are unique to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are unique to"]</data></edge><edge id="oe_49574c7dc32e567c" source="e_38c8318b1fef3eff" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">represents intrinsic qualities of</data><data key="edge_assertion_id">a_ab13673c8bbf47bf</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base group represents the intrinsic qualities of a vulnerability that are constant over time and across user environments, the Temporal group reflects the characteristics of a vulnerability that change over time, and the Environmental group represents the characteristics of a vulnerability that are unique to a user's environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">represents intrinsic qualities of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["represents intrinsic qualities of"]</data></edge><edge id="oe_6ab2efc1bea48f9b" source="e_dbd1ba0cc63988dc" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">are constant over</data><data key="edge_assertion_id">a_a00fb07f2cb4b543</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base group represents the intrinsic qualities of a vulnerability that are constant over time and across user environments, the Temporal group reflects the characteristics of a vulnerability that change over time, and the Environmental group represents the characteristics of a vulnerability that are unique to a user's environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are constant over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are constant over"]</data></edge><edge id="oe_cbc036aac586a11a" source="e_dbd1ba0cc63988dc" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">are across user environments over</data><data key="edge_assertion_id">a_9d0c4156782336ca</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base group represents the intrinsic qualities of a vulnerability that are constant over time and across user environments, the Temporal group reflects the characteristics of a vulnerability that change over time, and the Environmental group represents the characteristics of a vulnerability that are unique to a user's environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are across user environments over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are across user environments over"]</data></edge><edge id="oe_0a242341ed695976" source="e_dbd1ba0cc63988dc" target="e_3d75e6dbcbfb5033"><data key="edge_predicate_raw">are across</data><data key="edge_assertion_id">a_8a7e711383cdbf1b</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base group represents the intrinsic qualities of a vulnerability that are constant over time and across user environments, the Temporal group reflects the characteristics of a vulnerability that change over time, and the Environmental group represents the characteristics of a vulnerability that are unique to a user's environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are across</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are across"]</data></edge><edge id="oe_709d933ec650d1a0" source="e_dbd1ba0cc63988dc" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">change over</data><data key="edge_assertion_id">a_b08ade949019bec4</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base group represents the intrinsic qualities of a vulnerability that are constant over time and across user environments, the Temporal group reflects the characteristics of a vulnerability that change over time, and the Environmental group represents the characteristics of a vulnerability that are unique to a user's environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">change over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["change over", "changes over", "do change over"]</data></edge><edge id="oe_566750d7d69e427a" source="e_a9ed604eb1323e31" target="e_4364e67a28b13c95"><data key="edge_predicate_raw">be used to derive</data><data key="edge_assertion_id">a_c9cd38bdb25dc360</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">A CVSS score is also represented as a vector string, a compressed textual representation of the values used to derive the score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be used to derive</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be used to derive"]</data></edge><edge id="oe_3f1a9c047c72640f" source="e_bbeb401fc98aa4bb" target="e_d75978bf19f265d8"><data key="edge_predicate_raw">include</data><data key="edge_assertion_id">a_08013da1a30cae9f</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Its outputs include numerical scores indicating the severity of a vulnerability relative to other vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">include</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["include", "includes"]</data></edge><edge id="oe_5930c734d8d474b8" source="e_54114dfd8bd8776d" target="e_4f4ef27afd32ba29"><data key="edge_predicate_raw">be indicating</data><data key="edge_assertion_id">a_5ac9a45aa311af5e</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Its outputs include numerical scores indicating the severity of a vulnerability relative to other vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be indicating</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be indicating"]</data></edge><edge id="oe_360d22becd293a01" source="e_8a5f1e21d35a9318" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">are constant over</data><data key="edge_assertion_id">a_9aafda9e27ec970c</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base Score reflects the severity of a vulnerability according to its intrinsic characteristics which are constant over time and assumes the reasonable worst case impact across different deployed environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">reported</data><data key="edge_predicate_canonical">are constant over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are constant over"]</data></edge><edge id="oe_d9e9f87fae7514d6" source="e_fdb2716c144fa03f" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">change over</data><data key="edge_assertion_id">a_0376cd1f7ba4fc92</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Temporal Metrics adjust the Base severity of a vulnerability based on factors that change over time, such as the availability of exploit code</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">change over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["change over", "changes over", "do change over"]</data></edge><edge id="oe_8c2fe5452bd61f26" source="e_b54a46ece8e786db" target="e_6491de2f1e702934"><data key="edge_predicate_raw">adjust Base to</data><data key="edge_assertion_id">a_156822df8a339897</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental Metrics adjust the Base and Temporal severities to a specific computing environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">adjust Base to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["adjust Base to"]</data></edge><edge id="oe_17d755d3b5651cea" source="e_b54a46ece8e786db" target="e_6491de2f1e702934"><data key="edge_predicate_raw">adjust Temporal severities to</data><data key="edge_assertion_id">a_1b154e56a9bc51f0</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental Metrics adjust the Base and Temporal severities to a specific computing environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">adjust Temporal severities to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["adjust Temporal severities to"]</data></edge><edge id="oe_854d0c8defedb7e9" source="e_a7121d8886ad6bca" target="e_f80f4a42f00da908"><data key="edge_predicate_raw">are produced by</data><data key="edge_assertion_id">a_18bdb88cc18c8005</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Base Scores are usually produced by the organization maintaining the vulnerable product, or a third party scoring on their behalf</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are produced by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are produced by"]</data></edge><edge id="oe_fd6122add1cae694" source="e_ad16450d4d7b98f8" target="e_497c03fe2b7b67ab"><data key="edge_predicate_raw">is typical for</data><data key="edge_assertion_id">a_79c608a61ceecd11</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">It is typical for only the Base Metrics to be published as these do not change over time and are common to all environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is typical for</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is typical for"]</data></edge><edge id="oe_d4d5f2a558e3f2f6" source="e_1e8fc3121cd402ea" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">do change over</data><data key="edge_assertion_id">a_69c070d22622cd57</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">It is typical for only the Base Metrics to be published as these do not change over time and are common to all environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">change over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["change over", "changes over", "do change over"]</data></edge><edge id="oe_4bf1823a632c2be8" source="e_9601b737f7f4595e" target="e_ac3137bde6e231c3"><data key="edge_predicate_raw">supplement Base Score with</data><data key="edge_assertion_id">a_68a8a4170c876bf5</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers of CVSS should supplement the Base Score with Temporal and Environmental Scores specific to their use of the vulnerable product to produce a severity more accurate for their organizational environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">supplement Base Score with</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["supplement Base Score with"]</data></edge><edge id="oe_f70d9db25275631f" source="e_9601b737f7f4595e" target="e_