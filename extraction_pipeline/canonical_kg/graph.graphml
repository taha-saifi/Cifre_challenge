e_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">An exploited vulnerability can only affect resources managed by the same security authority</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">be managed by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be managed by"]</data></edge><edge id="oe_e0e7abc00acf64d5" source="e_0651ca14b1e582f2" target="e_41977bbb956fd210"><data key="edge_predicate_raw">are same In</data><data key="edge_assertion_id">a_77f39d403bdc502e</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">In this case, the vulnerable component and the impacted component are either the same, or both are managed by the same security authority</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are same In</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are same In"]</data></edge><edge id="oe_77ef5d43709ecbc0" source="e_26e0466f06957bd3" target="e_41977bbb956fd210"><data key="edge_predicate_raw">are same In</data><data key="edge_assertion_id">a_a82df8bb4e202470</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">In this case, the vulnerable component and the impacted component are either the same, or both are managed by the same security authority</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are same In</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are same In"]</data></edge><edge id="oe_7a03b583b5029479" source="e_22d8a27b5ffe2dfd" target="e_c7bbd6f495adf548"><data key="edge_predicate_raw">are managed by</data><data key="edge_assertion_id">a_160de405b71042b3</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">In this case, the vulnerable component and the impacted component are either the same, or both are managed by the same security authority</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are managed by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are managed by"]</data></edge><edge id="oe_310ed0d72dc086b1" source="e_841d5cae83210039" target="e_c1b8569aebaf6353"><data key="edge_predicate_raw">be managed by</data><data key="edge_assertion_id">a_c7d161f703b43c80</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric measures the impact to the confidentiality of the information resources managed by a software component due to a successfully exploited vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be managed by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be managed by"]</data></edge><edge id="oe_a97da462dbce887d" source="e_fabb36a448bb30b7" target="e_eb1797b298a230c0"><data key="edge_predicate_raw">disclosed</data><data key="edge_assertion_id">a_9a23b064a86c192f</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Alternatively, access to only some restricted information is obtained, but the disclosed information presents a direct, serious impact</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">disclosed</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["disclosed"]</data></edge><edge id="oe_2a6896e209a4b247" source="e_d2b630e61129d09b" target="e_26e0466f06957bd3"><data key="edge_predicate_raw">be protected by</data><data key="edge_assertion_id">a_3c6684d3477deafe</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, the attacker is able to modify any/all files protected by the impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be protected by</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be protected by"]</data></edge><edge id="oe_25d7eba7c0e4f5d5" source="e_332fd4a216e1c401" target="e_2228b2b192c550b5"><data key="edge_predicate_raw">be resulting from</data><data key="edge_assertion_id">a_e95fd5aac9c7ad77</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric measures the impact to the availability of the impacted component resulting from a successfully exploited vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be resulting from</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be resulting from"]</data></edge><edge id="oe_757accb1fdd1dc2d" source="e_e56e3d4771ca46d9" target="e_841d5cae83210039"><data key="edge_predicate_raw">refers to accessibility of</data><data key="edge_assertion_id">a_429c9f59562f3695</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">refers to accessibility of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["refers to accessibility of"]</data></edge><edge id="oe_61e6dd0ae89c619d" source="e_e56e3d4771ca46d9" target="e_bf0bee0969a73481"><data key="edge_predicate_raw">refers to accessibility of</data><data key="edge_assertion_id">a_b92de3ef02ef43a4</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">refers to accessibility of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["refers to accessibility of"]</data></edge><edge id="oe_65075b2e4d7518d3" source="e_e56e3d4771ca46d9" target="e_d37e8eb9896152d1"><data key="edge_predicate_raw">refers to accessibility of</data><data key="edge_assertion_id">a_4237ec861b1b578a</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">refers to accessibility of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["refers to accessibility of"]</data></edge><edge id="oe_3bd6dc43af088533" source="e_22e800482ee5b5fd" target="e_4058f076b2d4719d"><data key="edge_predicate_raw">consume</data><data key="edge_assertion_id">a_b467023717732ff4</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">consume</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["consume"]</data></edge><edge id="oe_ec833d7eb78d4983" source="e_527c56c7674a26dd" target="e_904da0b4f3960fb3"><data key="edge_predicate_raw">is important factor for</data><data key="edge_assertion_id">a_f21cacab29ee25f5</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Remediation Level of a vulnerability is an important factor for prioritization</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is important factor for</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is important factor for"]</data></edge><edge id="oe_9a93ed39cc6d3259" source="e_4228490cbf8a6d91" target="e_98c110f1e21aa4eb"><data key="edge_predicate_raw">is unpatched when</data><data key="edge_assertion_id">a_3b178d7e954d2a50</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The typical vulnerability is unpatched when initially published</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is unpatched when</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is unpatched when"]</data></edge><edge id="oe_aca6c058fd3876ec" source="e_edf56b768b8904e2" target="e_a568574ebde0ab4b"><data key="edge_predicate_raw">becomes</data><data key="edge_assertion_id">a_ffc4ed9f706077af</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Each of these respective stages adjusts the temporal score downwards, reflecting the decreasing urgency as remediation becomes final</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">becomes</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["becomes", "has become"]</data></edge><edge id="oe_e83034d7506ff79b" source="e_298a9593b67b7b1f" target="e_34cf20183f45e324"><data key="edge_predicate_raw">has issued</data><data key="edge_assertion_id">a_270f58df162325e2</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Either the vendor has issued an official patch, or an upgrade is available</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">has issued</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["has issued"]</data></edge><edge id="oe_77d2203b6ef62ce9" source="e_298a9593b67b7b1f" target="e_d068a0aa82ac3043"><data key="edge_predicate_raw">has issued</data><data key="edge_assertion_id">a_4d58c3b08c186924</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Either the vendor has issued an official patch, or an upgrade is available</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">has issued</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["has issued"]</data></edge><edge id="oe_0e4c63422d42d71c" source="e_edf56b768b8904e2" target="e_a568574ebde0ab4b"><data key="edge_predicate_raw">becomes</data><data key="edge_assertion_id">a_836c677df8ce2fe3</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">decreasing urgency as remediation becomes final</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">becomes</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["becomes", "has become"]</data></edge><edge id="oe_cab07cd736989cae" source="e_dbd1ba0cc63988dc" target="e_cf4606d100a09d0c"><data key="edge_predicate_raw">is known to exist with</data><data key="edge_assertion_id">a_ebbae2ce04e054f9</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">The urgency of a vulnerability is higher when a vulnerability is known to exist with certainty</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">is known to exist with</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["is known to exist with"]</data></edge><edge id="oe_4a5cfc1c8fef8e49" source="e_4676679afd99eed0" target="e_3655237b10b88be1"><data key="edge_predicate_raw">suggests</data><data key="edge_assertion_id">a_ba1885778da5fbac</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric also suggests the level of technical knowledge available to would-be attackers</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">suggests</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["suggests"]</data></edge><edge id="oe_ed549c2508d6f02c" source="e_80dc2d137eea46f1" target="e_571bc10d653316b8"><data key="edge_predicate_raw">allows unauthorized attacker to bypass security feature over</data><data key="edge_assertion_id">a_2e9173412a84326b</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">Weak authentication in Microsoft Office SharePoint allows an unauthorized attacker to bypass a security feature over a network</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">allows unauthorized attacker to bypass security feature over</data><data key="edge_domain">Product</data><data key="edge_range">Mention</data><data key="edge_derived_from">["allows unauthorized attacker to bypass security feature over"]</data></edge><edge id="oe_fad55ae3ec9ea4a9" source="e_d10f040039249e07" target="e_dfd2e098a96fa540"><data key="edge_predicate_raw">lead to major loss of</data><data key="edge_assertion_id">a_9e24ff259b0c253e</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">According to the CVSS metrics, successful exploitation of this vulnerability could lead to major loss of confidentiality (C:H), and integrity (I:H), but could lead to no loss of availability (A:N)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">lead to major loss of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["lead to major loss of"]</data></edge><edge id="oe_fabb9f0645661229" source="e_537e6ab50e8f2e44" target="e_93d8650fe6b85a54"><data key="edge_predicate_raw">impact availability of</data><data key="edge_assertion_id">a_e7f68e4ac53b166e</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">Exploiting this vulnerability could allow an attacker to disclose files and modify data, but the attacker cannot impact the availability of the system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">impact availability of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["impact availability of"]</data></edge><edge id="oe_b1ce5aeaa47733ba" source="e_d76f0b71c9538da5" target="e_b08ea7e3d08237a2"><data key="edge_predicate_raw">allow attacker to disclose</data><data key="edge_assertion_id">a_137688b2a2482c7b</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">Exploiting this vulnerability could allow an attacker to disclose files and modify data, but the attacker cannot impact the availability of the system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">allow attacker to disclose</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["allow attacker to disclose"]</data></edge><edge id="oe_254ad57b618d3752" source="e_e34c73ce7cdf1ddd" target="e_98419d6c0bf73fb9"><data key="edge_predicate_raw">bypass</data><data key="edge_assertion_id">a_20fcbde1322fd130</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">In a network-based attack, an unauthenticated attacker could bypass authentication and make an anonymous connection</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">bypass</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["bypass"]</data></edge><edge id="oe_1904df326379c8d1" source="e_e34c73ce7cdf1ddd" target="e_5e5c40ee6210030c"><data key="edge_predicate_raw">make</data><data key="edge_assertion_id">a_b35fff1b02adeef4</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C03</data><data key="edge_json_path">None</data><data key="edge_evidence">In a network-based attack, an unauthenticated attacker could bypass authentication and make an anonymous connection</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">make</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["make", "makes"]</data></edge><edge id="oe_2ac3b6c4da100a1c" source="e_a1dcdd289f57b065" target="e_15c6d0b1e60c9c9a"><data key="edge_predicate_raw">protect customers through</data><data key="edge_assertion_id">a_8a8023041ecd6c69</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">Microsoft recognizes the efforts of those in the security community who help us protect customers through coordinated vulnerability disclosure</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">protect customers through</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["protect customers through"]</data></edge><edge id="oe_53b0a33a2bd46653" source="e_8e81ce852cc92461" target="e_84268809b8f931f7"><data key="edge_predicate_raw">recognizes</data><data key="edge_assertion_id">a_df0191e8e7f5d351</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">Microsoft recognizes the efforts of those in the security community who help us protect customers through coordinated vulnerability disclosure</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">recognizes</data><data key="edge_domain">Vendor</data><data key="edge_range">Mention</data><data key="edge_derived_from">["recognizes"]</data></edge><edge id="oe_997fe5fe95ae0850" source="e_5c980ac08d8e06db" target="e_422ecd83d8fd548b"><data key="edge_predicate_raw">are with</data><data key="edge_assertion_id">a_9162ec0b6855fe51</data><data key="edge_source_id">S39</data><data key="edge_source_url">https://msrc.microsoft.com/update-guide/vulnerability/CVE-2026-55040</data><data key="edge_chunk_id">S39_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">How satisfied are you with the MSRC Security Update Guide?</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are with</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are with"]</data></edge><edge id="