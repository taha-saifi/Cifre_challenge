on_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are unique to</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are unique to"]</data></edge><edge id="oe_bf0fd3e1c8f5e19e" source="e_38c8318b1fef3eff" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">represents intrinsic qualities of</data><data key="edge_assertion_id">a_c017e64faa9869b8</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base group represents the intrinsic qualities of a vulnerability that are constant over time and across user environments, the Threat group reflects the characteristics of a vulnerability that change over time, and the Environmental group represents the characteristics of a vulnerability that are unique to a user's environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">represents intrinsic qualities of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["represents intrinsic qualities of"]</data></edge><edge id="oe_bb9e2bcd37132d23" source="e_2b3df5e798af4a3c" target="e_be51db49eb59d924"><data key="edge_predicate_raw">are used as</data><data key="edge_assertion_id">a_5672f6c58634ee7b</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Supplemental metrics do not modify the final score, and are used as additional insight into the characteristics of a vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">are used as</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are used as"]</data></edge><edge id="oe_6ed18b538b8f0d74" source="e_fccda449563e87c8" target="e_707af8c91bb1d910"><data key="edge_predicate_raw">consists of</data><data key="edge_assertion_id">a_1742641026ed3340</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">A CVSS vector string consists of a compressed textual representation of the values used to derive the score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">consists of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["consists of"]</data></edge><edge id="oe_8085ae9b5bc4fdd9" source="e_a9ed604eb1323e31" target="e_4364e67a28b13c95"><data key="edge_predicate_raw">be used to derive</data><data key="edge_assertion_id">a_d5c70f7a744cb8a1</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">A CVSS vector string consists of a compressed textual representation of the values used to derive the score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be used to derive</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be used to derive"]</data></edge><edge id="oe_b3714eb4dd3e16ea" source="e_bbeb401fc98aa4bb" target="e_d75978bf19f265d8"><data key="edge_predicate_raw">include</data><data key="edge_assertion_id">a_a7497f51b67b37b9</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Its outputs include numerical scores indicating the severity of a vulnerability relative to other vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">include</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["include", "includes"]</data></edge><edge id="oe_3d711cc92bf84e92" source="e_54114dfd8bd8776d" target="e_4f4ef27afd32ba29"><data key="edge_predicate_raw">be indicating</data><data key="edge_assertion_id">a_5a5da36970df340b</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Its outputs include numerical scores indicating the severity of a vulnerability relative to other vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">be indicating</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["be indicating"]</data></edge><edge id="oe_79c24e9466238533" source="e_8a5f1e21d35a9318" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">are constant over</data><data key="edge_assertion_id">a_7f3b96c2f16f46ba</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base Score reflects the severity of a vulnerability according to its intrinsic characteristics which are constant over time and assumes the reasonable worst-case impact across different deployed environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">reported</data><data key="edge_predicate_canonical">are constant over</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are constant over"]</data></edge><edge id="oe_be80c593dabe6ec9" source="e_98b5283953a5c25e" target="e_7ee1ff4a70457dd7"><data key="edge_predicate_raw">has use of</data><data key="edge_assertion_id">a_11e9a0a98274d388</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers of CVSS should enrich the Base metrics with Threat and Environmental metric values specific to their use of the vulnerable system to produce a score that provides a more comprehensive input to risk assessment specific to their organization</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">has use of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["has use of"]</data></edge><edge id="oe_780e948d0bd1c968" source="e_4364e67a28b13c95" target="e_48ea9e92fe5bc341"><data key="edge_predicate_raw">provides</data><data key="edge_assertion_id">a_a73b0b06bcc9155b</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers of CVSS should enrich the Base metrics with Threat and Environmental metric values specific to their use of the vulnerable system to produce a score that provides a more comprehensive input to risk assessment specific to their organization</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data><data key="edge_predicate_canonical">provides</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["provides", "provide"]</data></edge><edge id="oe_745462bdf7ad0068" source="e_f7f0082982beecc7" target="e_5686e5c631b8054e"><data key="edge_predicate_raw">use CVSS information as</data><data key="edge_assertion_id">a_afb530272ec9cfe2</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers may use CVSS information as input to an organizational vulnerability management process that also considers factors that are not part of CVSS in order to rank the threats to their technology infrastructure and make informed remediation decisions</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">use CVSS information as</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["use CVSS information as"]</data></edge><edge id="oe_ae7ed7b86d037afe" source="e_f7f0082982beecc7" target="e_0becd7248453c60e"><data key="edge_predicate_raw">use</data><data key="edge_assertion_id">a_9989432933573e90</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers may use CVSS information as input to an organizational vulnerability management process that also considers factors that are not part of CVSS in order to rank the threats to their technology infrastructure and make informed remediation decisions</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">use</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["use", "uses", "do use", "Uses"]</data></edge><edge id="oe_e6239bcd76dbee16" source="e_8e874df517877380" target="e_3cf72a85fc7edc64"><data key="edge_predicate_raw">are part of</data><data key="edge_assertion_id">a_ac382303f93e2333</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers may use CVSS information as input to an organizational vulnerability management process that also considers factors that are not part of CVSS in order to rank the threats to their technology infrastructure and make informed remediation decisions</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data><data key="edge_predicate_canonical">are part of</data><data key="edge_domain">Mention</data><data key="edge_range">Mention</data><data key="edge_derived_from">["are part of", "is part of"]</data></edge><edge id="oe_71fe36f8a34523c2" source="e_dbd1ba0cc63988dc" target="e_959f52a470454532"><data key="edge_predicate_raw">be scoring</data><data key="edge_assertion_id">a_8e6f7d998c50d0cc</data><data key="edge_source_id