ge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">U.S. critical infrastructure to steal sensitive information, disrupt operations, and undermine national security</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5d51d06b59c0a052" source="e_d152aed168aa1b22" target="e_416e308841e8295d"><data key="edge_predicate_raw">directed agencies to remediate</data><data key="edge_assertion_id">a_52bf4bd996f66c7a</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">In 2021 CISA established the Known Exploited Vulnerabilities catalog pursuant to BOD 22-01, which directed agencies to aggressively remediate known exploited vulnerabilities (KEVs), protect federal assets, and reduce cyber incidents</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1d5f17a57ccf0b1e" source="e_d152aed168aa1b22" target="e_6c0b102b5b5a264a"><data key="edge_predicate_raw">directed agencies to</data><data key="edge_assertion_id">a_3b560fcc0d1f04f7</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">In 2021 CISA established the Known Exploited Vulnerabilities catalog pursuant to BOD 22-01, which directed agencies to aggressively remediate known exploited vulnerabilities (KEVs), protect federal assets, and reduce cyber incidents</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_4493c41176b40ae0" source="e_3b8e724ba04c0cda" target="e_d0c16acae006b53d"><data key="edge_predicate_raw">evolves upon CISA 's KEV Catalog while deferring action against</data><data key="edge_assertion_id">a_8db3168ac2881363</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">This Directive evolves upon CISA’s KEV Catalog and increases mission readiness across the federal government by efficiently prioritizing high-risk vulnerabilities for timely action, while deferring action against low-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_14f10910d1b232fc" source="e_3b8e724ba04c0cda" target="e_dbeb2afe79d1dc70"><data key="edge_predicate_raw">evolves upon</data><data key="edge_assertion_id">a_5655c0071a3dbf5d</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">This Directive evolves upon CISA’s KEV Catalog and increases mission readiness across the federal government by efficiently prioritizing high-risk vulnerabilities for timely action, while deferring action against low-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_030660f0230f2970" source="e_3b8e724ba04c0cda" target="e_9c1295946a9c9f48"><data key="edge_predicate_raw">increases mission readiness across federal government by prioritizing high-risk vulnerabilities for</data><data key="edge_assertion_id">a_971b8959eb90aa90</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">This Directive evolves upon CISA’s KEV Catalog and increases mission readiness across the federal government by efficiently prioritizing high-risk vulnerabilities for timely action, while deferring action against low-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9a1ed712fbd66091" source="e_3b8e724ba04c0cda" target="e_b748d8a652b706ab"><data key="edge_predicate_raw">increases mission readiness across</data><data key="edge_assertion_id">a_590cf54e62bcb4ff</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">This Directive evolves upon CISA’s KEV Catalog and increases mission readiness across the federal government by efficiently prioritizing high-risk vulnerabilities for timely action, while deferring action against low-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_79ce7a588bd512a3" source="e_a5c5219ba5c6ed8d" target="e_3933518bba68f4da"><data key="edge_predicate_raw">Is exposed</data><data key="edge_assertion_id">a_41b58c56b6af1633</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">- Asset Exposure: Is the vulnerable asset publicly exposed?</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_af8b8f8424a51b0d" source="e_c83bed36d2f7ff72" target="e_8f46a9ed8ba50ed5"><data key="edge_predicate_raw">Is vulnerability as identified by</data><data key="edge_assertion_id">a_ab9eb201694e379c</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">- KEV Status: Is the vulnerability, as identified by a common vulnerabilities and exposures identifier (CVE ID), on CISA’s Known Exploited Vulnerabilities Catalog?</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_62643c9b344f3c6c" source="e_c83bed36d2f7ff72" target="e_407ae018c1271a3b"><data key="edge_predicate_raw">Is vulnerability as identified by</data><data key="edge_assertion_id">a_e32139958586abe9</data><data key="edge_source_id">S19</data><data key="edge_source_url">https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk</data><data key="edge_chunk_id">S19_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">- KEV Status: Is the vulnerability, as identified by a common vulnerabilities and exposures identifier (CVE ID), on CISA’s Known Exploited Vulnerabilities Catalog?</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a6624cb