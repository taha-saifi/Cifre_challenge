><edge id="oe_f4f54d25163bc887" source="e_8e81ce852cc92461" target="e_716714868d3df08f"><data key="edge_predicate_raw">disclosed</data><data key="edge_assertion_id">a_289688d1616cb5cc</data><data key="edge_source_id">S46</data><data key="edge_source_url">https://www.sentrium.co.uk/labs/windows-ike-service-extensions-vulnerability-enables-remote-code-execution-cve-2026-33824</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">In April 2026, Microsoft disclosed and patched a critical remote code execution vulnerability affecting the Windows Internet Key Exchange Service Extensions</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a90f9cc09fb9f132" source="e_c7a7735bf61b8084" target="e_e89a40e488525a7c"><data key="edge_predicate_raw">was addressed Tuesday release Tracked as</data><data key="edge_assertion_id">a_3e1fe10902e868b1</data><data key="edge_source_id">S46</data><data key="edge_source_url">https://www.sentrium.co.uk/labs/windows-ike-service-extensions-vulnerability-enables-remote-code-execution-cve-2026-33824</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Tracked as CVE-2026-33824, the issue was addressed as part of Microsoft’s April 2026 Patch Tuesday release</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_4e85b80b4578a230" source="e_c7a7735bf61b8084" target="e_513b6233f5ece173"><data key="edge_predicate_raw">was addressed as part of Microsoft 's April 2026 Patch</data><data key="edge_assertion_id">a_de489c05a208e5df</data><data key="edge_source_id">S46</data><data key="edge_source_url">https://www.sentrium.co.uk/labs/windows-ike-service-extensions-vulnerability-enables-remote-code-execution-cve-2026-33824</data><data key="edge_chunk_i