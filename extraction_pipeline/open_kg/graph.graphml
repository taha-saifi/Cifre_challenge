e id="oe_a6570aac8eecbbcf" source="e_e1cdff120ac62ad9" target="e_4c3807173e6dae64"><data key="edge_predicate_raw">are frequent attack vector for</data><data key="edge_assertion_id">a_79431012a93b7e40</data><data key="edge_source_id">S28</data><data key="edge_source_url">https://content.govdelivery.com/accounts/USDHSCISA/bulletins/425854d</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">These types of vulnerabilities are a frequent attack vector for malicious cyber actors and pose significant risks to the federal enterprise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_953f21b7bff32c26" source="e_e1cdff120ac62ad9" target="e_06348469aefb12ab"><data key="edge_predicate_raw">pose significant risks to</data><data key="edge_assertion_id">a_63904edd13fe4a68</data><data key="edge_source_id">S28</data><data key="edge_source_url">https://content.govdelivery.com/accounts/USDHSCISA/bulletins/425854d</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">These types of vulnerabilities are a frequent attack vector for malicious cyber actors and pose significant risks to the federal enterprise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_6c36d3cc1b367ac1" source="e_e1cdff120ac62ad9" target="e_a5960d6e65675e78"><data key="edge_predicate_raw">pose</data><data key="edge_assertion_id">a_096109372dc7d1e4</data><data key="edge_source_id">S28</data><data key="edge_source_url">https://content.govdelivery.com/accounts/USDHSCISA/bulletins/425854d</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">These types of vulnerabilities are a frequent attack vector for malicious cyber actors and pose significant risks to the federal enterprise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_73a81ebdf277fc97" source="e_f815e0f3f0982d43" target="e_963d5ef03119d4bc"><data key="edge_predicate_raw">Based on</data><data key="edge_assertion_id">a_a708797aec224b71</data><data key="edge_source_id">S28</data><data key="edge_source_url">https://content.govdelivery.com/accounts/USDHSCISA/bulletins/425854d</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Binding Operational Directive (BOD) 26-04: Prioritizing Security Updates Based on Risk establishes vulnerability management requirements for Federal Civilian Executive Branch (FCEB) agencies</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f2a74996b617c96a" source="e_ee9fd9299514c5dc" target="e_4402b9a2331274f7"><data key="edge_predicate_raw">grant total control of</data><data key="edge_assertion_id">a_d75d4caa42e55af6</data><data key="edge_source_id">S28</data><data key="edge_source_url">https://content.govdelivery.com/accounts/USDHSCISA/bulletins/425854d</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">BOD 26-04 reinforces the importance of the KEV Catalog and requires federal agencies to prioritize rapid remediation of high-risk vulnerabilities, specifically those identified by Common Vulnerabilities and Exposures (CVEs) listed in CISA’s KEV Catalog on publicly exposed assets that grant total control of the asset post-exploitation, while deferring action for lower-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_4e4b1f1f8f01a81b" source="e_1c22e33ec3d1dfe7" target="e_ce80779d64be2798"><data key="edge_predicate_raw">be identified by</data><data key="edge_assertion_id">a_714f2b3ae208b081</data><data key="edge_source_id">S28</data><data key="edge_source_url">https://content.govdelivery.com/accounts/USDHSCISA/bulletins/425854d</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">BOD 26-04 reinforces the importance of the KEV Catalog and requires federal agencies to prioritize rapid remediation of high-risk vulnerabilities, specifically those identified by Common Vulnerabilities and Exposures (CVEs) listed in CISA’s KEV Catalog on publicly exposed assets that grant total control of the asset post-exploitation, while deferring action for lower-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a6a04c90c717c7bf" source="e_1c22e33ec3d1dfe7" target="e_407ae018c1271a3b"><data key="edge_predicate_raw">be identified by</data><data key="edge_assertion_id">a_c7dc9ed62162aa4d</data><data key="edge_source_id">S28</data><data key="edge_source_url">https://content.govdelivery.com/accounts/USDHSCISA/bulletins/425854d</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">BOD 26-04 reinforces the importance of the KEV Catalog and requires federal agencies to prioritize rapid remediation of high-risk vulnerabilities, specifically those identified by Common Vulnerabilities and Exposures (CVEs) listed in CISA’s KEV Catalog on publicly exposed assets that grant total control of the asset post-exploitation, while deferring action for lower-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_2c096b05993601c5" source="e_8f46a9ed8ba50ed5" target="e_ee9fd9299514c5dc"><data key="edge_predicate_raw">be listed in CISA 's KEV Catalog on</data><data key="edge_assertion_id">a_0bdb83164cd3acf3</data><data key="edge_source_id">S28</data><data key="edge_source_url">https://content.govdelivery.com/accounts/USDHSCISA/bulletins/425854d</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">BOD 26-04 reinforces the importance of the KEV Catalog and requires federal agencies to prioritize rapid remediation of high-risk vulnerabilities, specifically those identified by Common Vulnerabilities and Exposures (CVEs) listed in CISA’s KEV Catalog on publicly exposed assets that grant total control of the asset post-exploitation, while deferring action for lower-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_4c4fdac1c2def7c8" source="e_407ae018c1271a3b" target="e_ee9fd9299514c5dc"><data key="edge_predicate_raw">be listed in CISA 's KEV Catalog on</data><data key="edge_assertion_id">a_7768637477dc36c6</data><data key="edge_source_id">S28</data><data key="edge_source_url">https://content.govdelivery.com/accounts/USDHSCISA/bulletins/425854d</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">BOD 26-04 reinforces the importance of the KEV Catalog and requires federal agencies to prioritize rapid remediation of high-risk vulnerabilities, specifically those identified by Common Vulnerabilities and Exposures (CVEs) listed in CISA’s KEV Catalog on publicly exposed assets that grant total control of the asset post-exploitation, while deferring action for lower-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e1ceb5e52ab24cac" source="e_8f46a9ed8ba50ed5" target="e_dbeb2afe79d1dc70"><data key="edge_predicate_raw">be listed in</data><data key="edge_assertion_id">a_52e02ea66cc9c4aa</data><data key="edge_source_id">S28</data><data key="edge_source_url">https://content.govdelivery.com/accounts/USDHSCISA/bulletins/425854d</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">BOD 26-04 reinforces the importance of the KEV Catalog and requires federal agencies to prioritize rapid remediation of high-risk vulnerabilities, specifically those identified by Common Vulnerabilities and Exposures (CVEs) listed in CISA’s KEV Catalog on publicly exposed assets that grant total control of the asset post-exploitation, while deferring action for lower-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0437e165d95ed6cc" source="e_407ae018c1271a3b" target="e_dbeb2afe79d1dc70"><data key="edge_predicate_raw">be listed in</data><data key="edge_assertion_id">a_69953d5634274aa1</data><data key="edge_source_id">S28</data><data key="edge_source_url">https://content.govdelivery.com/accounts/USDHSCISA/bulletins/425854d</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">BOD 26-04 reinforces the importance of the KEV Catalog and requires federal agencies to prioritize rapid remediation of high-risk vulnerabilities, specifically those identified by Common Vulnerabilities and Exposures (CVEs) listed in CISA’s KEV Catalog on publicly exposed assets that grant total control of the asset post-exploitation, while deferring action for lower-risk vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5baed92046d71a35" source="e_19c6d948e86ef92b" target="e_e657e5e5fabf1c00"><data key="edge_predicate_raw">patch</data><data key="edge_assertion_id">a_822ea2b6b7222fc5</data><data key="edge_source_id">S28</data><data key="edge_source_url