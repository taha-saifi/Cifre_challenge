d">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric describes the level of privileges an attacker must possess prior to successfully exploiting the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9756f07056e04d49" source="e_537e6ab50e8f2e44" target="e_1b50c049dec6c218"><data key="edge_predicate_raw">possess</data><data key="edge_assertion_id">a_dc2b0340bc070024</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric describes the level of privileges an attacker must possess prior to successfully exploiting the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_6370918740047063" source="e_537e6ab50e8f2e44" target="e_4916cc2d145603f5"><data key="edge_predicate_raw">obtains privileged credentials prior to</data><data key="edge_assertion_id">a_acc957da15e999c6</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">The method by which the attacker obtains privileged credentials prior to the attack (e.g., free trial accounts), is outside the scope of this metric</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_cb2a4b2583a0149b" source="e_537e6ab50e8f2e44" target="e_333716f10a881b90"><data key="edge_predicate_raw">obtains privileged credentials</data><data key="edge_assertion_id">a_80e4f4bf348234f7</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">The method by which the attacker obtains privileged credentials prior to the attack (e.g., free trial accounts), is outside the scope of this metric</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_6bac211453fff9c4" source="e_333716f10a881b90" target="e_4676679afd99eed0"><data key="edge_predicate_raw">is outside scope of</data><data key="edge_assertion_id">a_bcd6e192242d012b</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">The method by which the attacker obtains privileged credentials prior to the attack (e.g., free trial accounts), is outside the scope of this metric</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_23939e1f374fcb17" source="e_537e6ab50e8f2e44" target="e_22048de4281152e3"><data key="edge_predicate_raw">grant themselves</data><data key="edge_assertion_id">a_2fc4bf16f5aaf607</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">Generally, self-service provisioned accounts do not constitute a privilege requirement if the attacker can grant themselves privileges as part of the attack</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_7ca5595184a1ae6b" source="e_537e6ab50e8f2e44" target="e_1b50c049dec6c218"><data key="edge_predicate_raw">grant themselves</data><data key="edge_assertion_id">a_1f8e87a3466b8dc0</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">Generally, self-service provisioned accounts do not constitute a privilege requirement if the attacker can grant themselves privileges as part of the attack</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_c3d323c67f575aa2" source="e_6f560b38a8d56108" target="e_89172678c9484153"><data key="edge_predicate_raw">do constitute</data><data key="edge_assertion_id">a_a15780a265129e71</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C08</data><data key="edge_json_path">None</data><data key="edge_evidence">Generally, self-service provisioned accounts do not constitute a privilege requirement if the attacker can grant themselves privileges as part of the attack</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_3ea7629dc801efdb" source="e_0dd1994901856e68" target="e_3ffa0916e5d6ca85"><data key="edge_predicate_raw">are limited to settings owned by</data><data key="edge_assertion_id">a_f0ca3dde9c8c6c1e</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">that are typically limited to settings and resources owned by a single low-privileged user</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_35db2b54148064e8" source="e_0dd1994901856e68" target="e_c4631f903e1159e5"><data key="edge_predicate_raw">are limited to</data><data key="edge_assertion_id">a_6106752a9a737daa</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">that are typically limited to settings and resources owned by a single low-privileged user</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_2ad4d042f0fb1f30" source="e_f62ec09cf6e6860d" target="e_3ffa0916e5d6ca85"><data key="edge_predicate_raw">be owned by</data><data key="edge_assertion_id">a_2f9899960d7aa112</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">that are typically limited to settings and resources owned by a single low-privileged user</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1622398e9c35f367" source="e_c4631f903e1159e5" target="e_3ffa0916e5d6ca85"><data key="edge_predicate_raw">be owned by</data><data key="edge_assertion_id">a_b13dbd3c8bc78a2d</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">that are typically limited to settings and resources owned by a single low-privileged user</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a1c37567ad9db8c2" source="e_1b50c049dec6c218" target="e_4b32a6da9f7ed0c2"><data key="edge_predicate_raw">Required</data><data key="edge_assertion_id">a_18853b8c3eb49c88</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">Assessment Guidance: Privileges Required is usually None for hard-coded credential vulnerabilities or vulnerabilities requiring social engineering (e.g., reflected cross-site scripting, cross-site request forgery, or file parsing vulnerability in a PDF reader)</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9f2647f89a251db1" source="e_bdbf5733f5c282d7" target="e_836b09eddead7e74"><data key="edge_predicate_raw">be treated to</data><data key="edge_assertion_id">a_27da5e8029ca6abe</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">Default credentials that have not been changed or are not unique across each environment should be treated similarly to hard-coded credentials</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_3872a2a81c5f4d2f" source="e_bdbf5733f5c282d7" target="e_322c75da4ec5b304"><data key="edge_predicate_raw">be treated</data><data key="edge_assertion_id">a_b7705d658c402876</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">Default credentials that have not been changed or are not unique across each environment should be treated similarly to hard-coded credentials</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_7434985d8887a4d3" source="e_4676679afd99eed0" target="e_4e9df37bc312f4bc"><data key="edge_predicate_raw">captures</data><data key="edge_assertion_id">a_889dcff10c232ac6</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric captures the requirement for a human user, other than the attacker, to participate in the successful compromise of the vulnerable system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1736ba87a820bd6d" source="e_028c7b1d0f837f74" target="e_537e6ab50e8f2e44"><data key="edge_predicate_raw">is other than</data><data key="edge_assertion_id">a_326d0c90ce3377e5</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric captures the requirement for a human user, other than the attacker, to participate in the successful compromise of the vulnerable system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a7e47b0cbc915dc0" source="e_8bb0cd6b7b68cd93" target="e_7ee1ff4a70457dd7"><data key="edge_predicate_raw">be participate in successful compromise of</data><data key="edge_assertion_id">a_f4c49635c79b1042</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric captures the requirement for a human user, other than the attacker, to participate in the successful compromise of the vulnerable system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f31531a2afa332cd" source="e_dbd1ba0cc63988dc" target="e_537e6ab50e8f2e44"><data key="edge_predicate_raw">be exploited at will of</data><data key="edge_assertion_id">a_9b3f2b2aed971117</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric determines whether the vulnerability can be exploited solely at the will of the attacker, or whether a separate user (or user-initiated process) must participate in some manner</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_3fa33f19c0b1d129" source="e_dbd1ba0cc63988dc" target="e_060bbd297383d5a7"><data key="edge_predicate_raw">be exploited</data><data key="edge_assertion_id">a_fe050a9bcf5a1081</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric determines whether the vulnerability can be exploited solely at the will of the attacker, or whether a separate user (or user-initiated process) must participate in some manner</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_1aafe917be55fdfa" source="e_dda76eeedb5c35a4" target="e_7ee1ff4a70457dd7"><data key="edge_predicate_raw">subvert protections built into</data><data key="edge_assertion_id">a_7d3ecda8d7fff677</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">These interactions would be considered involuntary and do not require that the user actively subvert protections built into the vulnerable system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_a0ffdd565d185b50" source="e_e8580183c3bd0734" target="e_7ee1ff4a70457dd7"><data key="edge_predicate_raw">be built into</data><data key="edge_assertion_id">a_8b06747b8402f024</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">These interactions would be considered involuntary and do not require that the user actively subvert protections built into the vulnerable system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_f40dc3ac1f742263" source="e_b3c77c913f52e355" target="e_8913949ce3c45f5f"><data key="edge_predicate_raw">be considered</data><data key="edge_assertion_id">a_09b8d25e4ae09132</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">These interactions would be considered involuntary and do not require that the user actively subvert protections built into the vulnerable system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_2dffeff60da1eb76" source="e_75ac4e09b3f2b875" target="e_2228b2b192c550b5"><data key="edge_predicate_raw">capture effects of</data><data key="edge_assertion_id">a_5234fbfe557d0670</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Impact metrics capture the effects of a successfully exploited vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_af2d71e9e1edcf1d" source="e_d4cff6070f136c90" target="e_35b2194131dcbc9a"><data key="edge_predicate_raw">constrain impacts to</data><data key="edge_assertion_id">a_29f9ca91cf639eb9</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Analysts should constrain impacts to a reasonable, final outcome which they are confident an attacker is able to achieve</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_967e765da715c3c1" source="e_d4cff6070f136c90" target="e_57598c70746601d2"><data key="edge_predicate_raw">constrain</data><data key="edge_assertion_id">a_de903422b86abe07</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Analysts should constrain impacts to a reasonable, final outcome which they are confident an attacker is able to achieve</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fe07129fef4041dc" source="e_dbd1ba0cc63988dc" target="e_f3d00477181497a6"><data key="edge_predicate_raw">requires read-only permissions prior to being</data><data key="edge_assertion_id">a_bffdf8359dd3e0a4</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, consider a vulnerability that requires read-only permissions prior to being able to exploit the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b38eb61cf82fb530" source="e_dbd1ba0cc63988dc" target="e_abe5b5f78166cb31"><data key="edge_predicate_raw">requires</data><data key="edge_assertion_id">a_ab3e9a6bcd8e977a</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, consider a vulnerability that requires read-only permissions prior to being able to exploit the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e83ba32df3c34e2d" source="e_5abf948c6bee4fdf" target="e_f3d00477181497a6"><data key="edge_predicate_raw">be able</data><data key="edge_assertion_id">a_35ec01c6bb957b7e</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, consider a vulnerability that requires read-only permissions prior to being able to exploit the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_58037d6d6ffde8d0" source="e_537e6ab50e8f2e44" target="e_16ea76003b3fd67e"><data key="edge_predicate_raw">maintains gains write access After</data><data key="edge_assertion_id">a_07b3001fca308429</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">After successful exploitation, the attacker maintains the same level of read access, and gains write access</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7d7afa82dee121dd" source="e_537e6ab50e8f2e44" target="e_d0456205cb01f7a0"><data key="edge_predicate_raw">maintains</data><data key="edge_assertion_id">a_39ebac27377a6c06</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">After successful exploitation, the attacker maintains the same level of read access, and gains write access</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_53bdf4fcc9388a79" source="e_8f5263a93ee3ad05" target="e_f2dca16215b933e8"><data key="edge_predicate_raw">write</data><data key="edge_assertion_id">a_f99b5a4cb2770464</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">After successful exploitation, the attacker maintains the same level of read access, and gains write access</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e09c5e6c7e959c23" source="e_29bb0e9d5a84c984" target="e_f2dca16215b933e8"><data key="edge_predicate_raw">write</data><data key="edge_assertion_id">a_a30153ba8e9b111f</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">After successful exploitation, the attacker maintains the same level of read access, and gains write access</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c9bde1ff96a8653f" source="e_537e6ab50e8f2e44" target="e_7ec3a26547017318"><data key="edge_predicate_raw">starts with</data><data key="edge_assertion_id">a_dad4e41cee38049f</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, if an attacker starts with partial access to restricted information (Confidentiality Low) and successful exploitation of the vulnerability results in complete loss in confidentiality (Confidentiality High), then the resultant CVSS Base metric value should reference the “end game” Impact metric value (Confidentiality High)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_3891a061017107a3" source="e_537e6ab50e8f2e44" target="e_0b036e5df064a6b7"><data key="edge_predicate_raw">starts with</data><data key="edge_assertion_id">a_7fb830ebc7115e2e</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, if an attacker starts with partial access to restricted information (Confidentiality Low) and successful exploitation of the vulnerability results in complete loss in confidentiality (Confidentiality High), then the resultant CVSS Base metric value should reference the “end game” Impact metric value (Confidentiality High)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_37e547fc1030b01f" source="e_b06e479590c522c6" target="e_d7268769fbad72a0"><data key="edge_predicate_raw">reference</data><data key="edge_assertion_id">a_96ce31569721947e</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, if an attacker starts with partial access to restricted information (Confidentiality Low) and successful exploitation of the vulnerability results in complete loss in confidentiality (Confidentiality High), then the resultant CVSS Base metric value should reference the “end game” Impact metric value (Confidentiality High)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5301929b51dd925f" source="e_61d75bfb2ba29a45" target="e_75ac4e09b3f2b875"><data key="edge_predicate_raw">need to account for impacts to impacts outside of Vulnerable System When identifying values for</data><data key="edge_assertion_id">a_9e11d17aecc0039d</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When identifying values for the impact metrics, assessment providers need to account for impacts both to the Vulnerable System and impacts outside of the Vulnerable System</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0a22f2456c17f67f" source="e_61d75bfb2ba29a45" target="e_75ac4e09b3f2b875"><data key="edge_predicate_raw">need to account for impacts When identifying values for</data><data key="edge_assertion_id">a_09353154c81dcdb0</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When identifying values for the impact metrics, assessment providers need to account for impacts both to the Vulnerable System and impacts outside of the Vulnerable System</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_10cd87455e17c257" source="e_61d75bfb2ba29a45" target="e_9b82ae529e3afef4"><data key="edge_predicate_raw">need to account for</data><data key="edge_assertion_id">a_17dd2bf8a271b68d</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When identifying values for the impact metrics, assessment providers need to account for impacts both to the Vulnerable System and impacts outside of the Vulnerable System</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_00f0c1807f62cfd2" source="e_61d75bfb2ba29a45" target="e_3429978cd9dc60ed"><data key="edge_predicate_raw">need to account for</data><data key="edge_assertion_id">a_602eb5e00c003f88</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When identifying values for the impact metrics, assessment providers need to account for impacts both to the Vulnerable System and impacts outside of the Vulnerable System</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7c3bc538a1056fca" source="e_61d75bfb2ba29a45" target="e_57598c70746601d2"><data key="edge_predicate_raw">need to account for</data><data key="edge_assertion_id">a_0bbefeee32182cec</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When identifying values for the impact metrics, assessment providers need to account for impacts both to the Vulnerable System and impacts outside of the Vulnerable System</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_045c934a85d2fca9" source="e_57598c70746601d2" target="e_7b06f2b2e6976d8f"><data key="edge_predicate_raw">are established</data><data key="edge_assertion_id">a_3ed65276b77c4b24</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">These impacts are established by two sets of impact metrics: “Vulnerable System impact” and “Subsequent System impact”</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_bfedc70649e02fd3" source="e_57598c70746601d2" target="e_664d5b9e60c68b47"><data key="edge_predicate_raw">are established</data><data key="edge_assertion_id">a_740fba712abe4a81</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">These impacts are established by two sets of impact metrics: “Vulnerable System impact” and “Subsequent System impact”</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_301322a7624bce5d" source="e_61d75bfb2ba29a45" target="e_856f644b1eea7665"><data key="edge_predicate_raw">use conceptual model of system of interest When establishing boundaries for</data><data key="edge_assertion_id">a_b77f11f00e7e8617</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When establishing the boundaries for the Vulnerable System metric values, assessment providers should use the conceptual model of a system of interest</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5f38828284a43f93" source="e_61d75bfb2ba29a45" target="e_f52f19c613910d1c"><data key="edge_predicate_raw">use</data><data key="edge_assertion_id">a_ed8f08fc7d531b29</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When establishing the boundaries for the Vulnerable System metric values, assessment providers should use the conceptual model of a system of interest</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e4a65fd3d1f17f9e" source="e_c6a340213fcac165" target="e_f2cdc47ec4f51081"><data key="edge_predicate_raw">is defined as set of</data><data key="edge_assertion_id">a_821f501350e8e31a</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Formally, a system of interest for scoring a vulnerability is defined as the set of computing logic that executes in an environment with a coherent function and set of security policies</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_212315f811b8808b" source="e_3521c6ce31419359" target="e_c6c46476c8ff74de"><data key="edge_predicate_raw">executes in environment with</data><data key="edge_assertion_id">a_b53a6845f3cb7200</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Formally, a system of interest for scoring a vulnerability is defined as the set of computing logic that executes in an environment with a coherent function and set of security policies</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a9b63d271e7ebcb5" source="e_3521c6ce31419359" target="e_33b897287e267e17"><data key="edge_predicate_raw">executes in</data><data key="edge_assertion_id">a_3ab1bdc882ec9d8a</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Formally, a system of interest for scoring a vulnerability is defined as the set of computing logic that executes in an environment with a coherent function and set of security policies</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f10405247b7c2af2" source="e_dbd1ba0cc63988dc" target="e_bf4d0c761a68594e"><data key="edge_predicate_raw">exists in more components of</data><data key="edge_assertion_id">a_61ebe0c58d15c414</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The vulnerability exists in one or more components of such a system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5520868f001ea775" source="e_76352b9065576337" target="e_de24cb3f3fac6c9e"><data key="edge_predicate_raw">serves purpose from</data><data key="edge_assertion_id">a_45119f1a4e2a14ad</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">A technology product or a solution that serves a purpose or function from a consumer's perspective is considered a system (e.g., a server, workstation, containerized service, etc.)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f037fa5111325697" source="e_76352b9065576337" target="e_2dcafecf60ea08b2"><data key="edge_predicate_raw">serves</data><data key="edge_assertion_id">a_2b3b5b257b0291f0</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">A technology product or a solution that serves a purpose or function from a consumer's perspective is considered a system (e.g., a server, workstation, containerized service, etc.)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_6e242bd3e16349a8" source="e_302eb86b8ae9a4db" target="e_93d8650fe6b85a54"><data key="edge_predicate_raw">is considered</data><data key="edge_assertion_id">a_8acdf44c78de8fba</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">A technology product or a solution that serves a purpose or function from a consumer's perspective is considered a system (e.g., a server, workstation, containerized service, etc.)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f7bc7dc9390c244f" source="e_76352b9065576337" target="e_93d8650fe6b85a54"><data key="edge_predicate_raw">is considered</data><data key="edge_assertion_id">a_51afb00d16e7a535</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">A technology product or a solution that serves a purpose or function from a consumer's perspective is considered a system (e.g., a server, workstation, containerized service, etc.)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_20dafaa7a12356be" source="e_ad16450d4d7b98f8" target="e_93d8650fe6b85a54"><data key="edge_predicate_raw">is designed to be used exclusively by</data><data key="edge_assertion_id">a_fc66a494051ff0bb</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When a system provides its functionality solely to another system, or it is designed to be exclusively used by another system, then together they are considered as the system of interest for scoring</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_231c9fd563243e47" source="e_ad16450d4d7b98f8" target="e_93d8650fe6b85a54"><data key="edge_predicate_raw">is designed to be used by</data><data key="edge_assertion_id">a_f02f5e2016d67949</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When a system provides its functionality solely to another system, or it is designed to be exclusively used by another system, then together they are considered as the system of interest for scoring</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0b16344afbe21bea" source="e_93d8650fe6b85a54" target="e_c9f7ebbebae4fbbf"><data key="edge_predicate_raw">provides</data><data key="edge_assertion_id">a_053c904c74aac860</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When a system provides its functionality solely to another system, or it is designed to be exclusively used by another system, then together they are considered as the system of interest for scoring</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5261dc4de0a2892b" source="e_93d8650fe6b85a54" target="e_93d8650fe6b85a54"><data key="edge_predicate_raw">provides functionality to</data><data key="edge_assertion_id">a_db115fe202de1e94</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When a system provides its functionality solely to another system, or it is designed to be exclusively used by another system, then together they are considered as the system of interest for scoring</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_105bcedf8d87a661" source="e_290d8da624d84fb0" target="e_f6f8d56c7e2e986d"><data key="edge_predicate_raw">are considered as system of interest for scoring</data><data key="edge_assertion_id">a_7a173b24731fa373</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When a system provides its functionality solely to another system, or it is designed to be exclusively used by another system, th