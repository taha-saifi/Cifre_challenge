y">asserted</data></edge><edge id="oe_63516d752559bf8f" source="e_5299db4a3b7653a2" target="e_3d33bcab7851ab3b"><data key="edge_predicate_raw">expose IKE services to</data><data key="edge_assertion_id">a_40d96594136d1427</data><data key="edge_source_id">S46</data><data key="edge_source_url">https://www.sentrium.co.uk/labs/windows-ike-service-extensions-vulnerability-enables-remote-code-execution-cve-2026-33824</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Organisations should prioritise patching systems that expose IKE services to untrusted networks</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_89186e16110f1258" source="e_5299db4a3b7653a2" target="e_cb0484a48ca2259a"><data key="edge_predicate_raw">expose</data><data key="edge_assertion_id">a_7633920d142dbe75</data><data key="edge_source_id">S46</data><data key="edge_source_url">https://www.sentrium.co.uk/labs/windows-ike-service-extensions-vulnerability-enables-remote-code-execution-cve-2026-33824</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Organisations should prioritise patching systems that expose IKE services to untrusted networks</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_22b1bf128ed196d8" source="e_d7ab1020fcb494c5" target="e_6a5b18796f0b7110"><data key="edge_predicate_raw">be applied</data><data key="edge_assertion_id">a_deb78b55b2cac158</data><data key="edge_source_id">S46</data><data key="edge_source_url">https://www.sentrium.co.uk/labs/windows-ike-service-extensions-vulnerability-enables-remote-code-execution-cve-2026-33824</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Where patching cannot be applied immedi