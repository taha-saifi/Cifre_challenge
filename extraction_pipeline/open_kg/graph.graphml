9b0eaf6</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">It is the responsibility of the CVSS consumer to populate the values of Exploit Maturity (E) based on information regarding the availability of exploitation code/processes and the state of exploitation techniques</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_afd9c91907ba78c4" source="e_2079f7f0585a6a0c" target="e_d4735ae1e7282cca"><data key="edge_predicate_raw">be referred to as</data><data key="edge_assertion_id">a_a308198d7914a54d</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">This information will be referred to as “threat intelligence” throughout this document</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5c31257c4f39cf4c" source="e_2079f7f0585a6a0c" target="e_7e5867a250c568cf"><data key="edge_predicate_raw">be referred to throughout</data><data key="edge_assertion_id">a_083c6f2f6f23d697</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C14</data><data key="edge_json_path">None</data><data key="edge_evidence">This information will be referred to as “threat intelligence” throughout this document</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b1d25ec87712c992" source="e_1acae121d088630c" target="e_70d113b7cf439f46"><data key="edge_predicate_raw">be preferred over those with</data><data key="edge_assertion_id">a_96606e4b2b64a5c2</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">Operational Recommendation: Threat intelligence sources that provide Exploit Maturity information for all vulnerabilities should be preferred over those with only partial coverage</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_176c0fb4e9f066ac" source="e_ad16450d4d7b98f8" target="e_d4735ae1e7282cca"><data key="edge_predicate_raw">is recommended to use multiple sources of</data><data key="edge_assertion_id">a_eb50d41fc21626d4</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">Also, it is recommended to use multiple sources of threat intelligence as many are not comprehensive</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_086e076a83eb420b" source="e_768bf52735c34131" target="e_4abbc3f47df76ccf"><data key="edge_predicate_raw">enable consumer analyst to customize</data><data key="edge_assertion_id">a_4c33a4f9849c938b</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">These metrics enable the consumer analyst to customize the resulting score depending on the importance of the affected IT asset to a user’s organization, measured in terms of complementary/alternative security controls in place, Confidentiality, Integrity, and Availability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_405c23bcd174b37d" source="e_768bf52735c34131" target="e_754fa75553fa09be"><data key="edge_predicate_raw">enable consumer analyst to customize</data><data key="edge_assertion_id">a_47da76251a3afd32</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">These metrics enable the consumer analyst to customize the resulting score depending on the importance of the affected IT asset to a user’s organization, measured in terms of complementary/alternative security controls in place, Confidentiality, Integrity, and Availability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9894edfd747e501a" source="e_d05dc162b952a920" target="e_a98014409305c0ed"><data key="edge_predicate_raw">be depending on importance of</data><data key="edge_assertion_id">a_0939f7fac6f6e93a</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">These metrics enable the consumer analyst to customize the resulting score depending on the importance of the affected IT asset to a user’s organization, measured in terms of complementary/alternative security controls in place, Confidentiality, Integrity, and Availability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9ac194df070d75bd" source="e_768bf52735c34131" target="e_80b852b98e6b518c"><data key="edge_predicate_raw">are modified equivalent of</data><data key="edge_assertion_id">a_9a60220e7b6c00a7</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">The metrics are the modified equivalent of Base metrics and are assigned values based on the system placement within organizational infrastructure</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_53ccc0801cf8f9ed" source="e_768bf52735c34131" target="e_0b3496c070468740"><data key="edge_predicate_raw">are assigned</data><data key="edge_assertion_id">a_16d33ddbc1cf4aad</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">The metrics are the modified equivalent of Base metrics and are assigned values based on the system placement within organizational infrastructure</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f2d16bf98a461eb3" source="e_a9ed604eb1323e31" target="e_c1dc8fe342a2da24"><data key="edge_predicate_raw">be based on system placement within</data><data key="edge_assertion_id">a_c7769ccf1d8f0843</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">The metrics are the modified equivalent of Base metrics and are assigned values based on the system placement within organizational infrastructure</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_107a5c41b71b004d" source="e_768bf52735c34131" target="e_7f8096987d902565"><data key="edge_predicate_raw">enable consumer to customize</data><data key="edge_assertion_id">a_9a1b2534177fe1a6</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">These metrics enable the consumer to customize the assessment depending on the importance of the affected IT asset to the analyst’s organization, measured in terms of Confidentiality, Integrity, and Availability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c852f2e4802c269d" source="e_a93cd344a30befb7" target="e_c52321f3e68882ab"><data key="edge_predicate_raw">supports</data><data key="edge_assertion_id">a_aea8b0d25058b73f</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">That is, if an IT asset supports a business function for which Availability is most important, the analyst can assign a greater value to Availability metrics relative to Confidentiality and Integrity</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_6ea3fb1180901723" source="e_e56e3d4771ca46d9" target="e_5d1d72902eb15d6e"><data key="edge_predicate_raw">is most</data><data key="edge_assertion_id">a_ba250cb2d61731a0</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">That is, if an IT asset supports a business function for which Availability is most important, the analyst can assign a greater value to Availability metrics relative to Confidentiality and Integrity</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_7e31f77092fee334" source="e_f6498126c94c6f96" target="e_8cda6ed912ad8793"><data key="edge_predicate_raw">assign greater value to</data><data key="edge_assertion_id">a_bce16cd581fe8ed9</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">That is, if an IT asset supports a business function for which Availability is most important, the analyst can assign a greater value to Availability metrics relative to Confidentiality and Integrity</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_358436f8b640d0d9" source="e_f6498126c94c6f96" target="e_1a35ca554daf0f47"><data key="edge_predicate_raw">assign greater value</data><data key="edge_assertion_id">a_1ca6c77a27d47765</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">That is, if an IT asset supports a business function for which Availability is most important, the analyst can assign a greater value to Availability metrics relative to Confidentiality and Integrity</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_cb01d5b1afa910d5" source="e_f6498126c94c6f96" target="e_624d33dd68b0de17"><data key="edge_predicate_raw">assign greater value</data><data key="edge_assertion_id">a_12de420419bff5a4</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">That is, if an IT asset supports a business function for which Availability is most important, the analyst can assign a greater value to Availability metrics relative to Confidentiality and Integrity</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_707b541e8b6c9c13" source="e_f6498126c94c6f96" target="e_8ba0639306d76dcd"><data key="edge_predicate_raw">assign</data><data key="edge_assertion_id">a_643c750c3d56d335</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">That is, if an IT asset supports a business function for which Availability is most important, the analyst can assign a greater value to Availability metrics relative to Confidentiality and Integrity</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_b898c9c329cd2cd9" source="e_b39009419fada99a" target="e_4d8f9e8bdafd1675"><data key="edge_predicate_raw">is determined by</data><data key="edge_assertion_id">a_43beb56738454482</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The full effect on the environmental score is determined by the corresponding Modified Base Impact metrics</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ce52ea5a7d8542b8" source="e_768bf52735c34131" target="e_c89e9873faad3f01"><data key="edge_predicate_raw">are set to default value of Defined reasonable worst case of</data><data key="edge_assertion_id">a_0525cb89d614bbf8</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">Following the concept of assuming “reasonable worst case”, in absence of explicit values, these metrics are set to the default value of Not Defined (X), which is equivalent to the metric value of High (H)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_6600102cd171fecb" source="e_afccd7a4fc5871a9" target="e_7b4f67c17e442588"><data key="edge_predicate_raw">is equivalent to metric value of</data><data key="edge_assertion_id">a_247317bbec0ba4b2</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">Following the concept of assuming “reasonable worst case”, in absence of explicit values, these metrics are set to the default value of Not Defined (X), which is equivalent to the metric value of High (H)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_40326db88ef2e4d8" source="e_7b4f67c17e442588" target="e_074229e4d05d7665"><data key="edge_predicate_raw">is considered</data><data key="edge_assertion_id">a_b10f19f718554731</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The lower the Security Requirement, the lower the score (recall that High is considered the default)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_df99f3f517fdbe0b" source="e_0e016f2d5b196887" target="e_44fb585ec7e6699b"><data key="edge_predicate_raw">be based on specific characteristics of</data><data key="edge_assertion_id">a_f4dffc2ddc8074c3</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">These metrics enable the consumer analyst to override individual Base metric values based on specific characteristics of a user’s environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_187bec7e17802638" source="e_768bf52735c34131" target="e_b942f553d9498924"><data key="edge_predicate_raw">enable consumer analyst to override</data><data key="edge_assertion_id">a_8c06046d9b8affb0</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">These metrics enable the consumer analyst to override individual Base metric values based on specific characteristics of a user’s environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e51c647d857dedd6" source="e_cc7d718fa81c41b8" target="e_768735eaceef9eff"><data key="edge_predicate_raw">be reflected via</data><data key="edge_assertion_id">a_aeffab35081bf672</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">Characteristics that affect Exploitability or Impact can be reflected via an appropriately modified Environmental metric value</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_85cf48b5901b0634" source="e_cc7d718fa81c41b8" target="e_8deebfd1151914f5"><data key="edge_predicate_raw">affect</data><data key="edge_assertion_id">a_c71416443e168a80</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">Characteristics that affect Exploitability or Impact can be reflected via an appropriately modified Environmental metric value</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_68fa772c0d6b2e6f" source="e_cc7d718fa81c41b8" target="e_9ed9f9c2275e8e7e"><data key="edge_predicate_raw">affect</data><data key="edge_assertion_id">a_fad3b1027957a3a2</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">Characteristics that affect Exploitability or Impact can be reflected via an appropriately modified Environmental metric value</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_086c7d1f167cb3aa" source="e_0dd1d2b00920b892" target="e_79a5b245db4e61f6"><data key="edge_predicate_raw">is determined by corresponding Base metrics as</data><data key="edge_assertion_id">a_5084a3befc36e625</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The full effect on the resulting score is determined by the corresponding Base metrics as follows</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8161ec2f3117e7f5" source="e_0dd1d2b00920b892" target="e_9b301e09540d09fc"><data key="edge_predicate_raw">is determined by</data><data key="edge_assertion_id">a_f4936dcfd9613c75</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The full effect on the resulting score is determined by the corresponding Base metrics as follows</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7cd7f38b55c4ea1a" source="e_99e2c42a91e28e80" target="e_02880d339811368c"><data key="edge_predicate_raw">Required</data><data key="edge_assertion_id">a_9c582014620d6459</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Example: If a provider sets the Base Metric Privileges Required to Low (PR:L) and an analyst overrides Modified Privileges Required to High (MPR:H), then the resulting score will be calculated as if the Base Metric Privileges Requires was set to High</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fc567cfc9946a574" source="e_7187f5984ec20df7" target="e_76641d366073ed00"><data key="edge_predicate_raw">Required</data><data key="edge_assertion_id">a_889cf85f891aef1a</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Example: If a provider sets the Base Metric Privileges Required to Low (PR:L) and an analyst overrides Modified Privileges Required to High (MPR:H), then the resulting score will be calculated as if the Base Metric Privileges Requires was set to High</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_64e29315d3427ca5" source="e_869917b411ab4e2c" target="e_8dc8b73ad22b6803"><data key="edge_predicate_raw">Requires</data><data key="edge_assertion_id">a_da694889eb07a2a6</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Example: If a provider sets the Base Metric Privileges Required to Low (PR:L) and an analyst overrides Modified Privileges Required to High (MPR:H), then the resulting score will be calculated as if the Base Metric Privileges Requires was set to High</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ce15de21a974774e" source="e_b0b8500294aa8ce2" target="e_571bc10d653316b8"><data key="edge_predicate_raw">sets Base Metric Attack Vector to</data><data key="edge_assertion_id">a_1998faa061d49bc8</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Similarly, if a provider sets the Base Metric Attack Vector to Network (AV:N) and an analyst sets Modified Attack Vector to Physical (MAV:P), then the resulting score will be calculated as if the Base Attack Vector was set to Physical</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_52d1abbc39b46e3f" source="e_b0b8500294aa8ce2" target="e_f6498126c94c6f96"><data key="edge_predicate_raw">sets Base Metric Attack Vector to</data><data key="edge_assertion_id">a_0d0d0b5eee1311fc</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Similarly, if a provider sets the Base Metric Attack Vector to Network (AV:N) and an analyst sets Modified Attack Vector to Physical (MAV:P), then the resulting score will be calculated as if the Base Attack Vector was set to Physical</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_bc444bee319bda83" source="e_3189a9999089646b" target="e_832ba76039c387b2"><data key="edge_predicate_raw">be calculated as if Base Attack Vector was set to Physical</data><data key="edge_assertion_id">a_5b433eaaccbe005c</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Similarly, if a provider sets the Base Metric Attack Vector to Network (AV:N) and an analyst sets Modified Attack Vector to Physical (MAV:P), then the resulting score will be calculated as if the Base Attack Vector was set to Physical</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_afefb0e2b3817e1e" source="e_3189a9999089646b" target="e_832ba76039c387b2"><data key="edge_predicate_raw">be calculated</data><data key="edge_assertion_id">a_397a885d9145fde0</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Similarly, if a provider sets the Base Metric Attack Vector to Network (AV:N) and an analyst sets Modified Attack Vector to Physical (MAV:P), then the resulting score will be calculated as if the Base Attack Vector was set to Physical</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0d8f324e03de6907" source="e_253d7d14fec0fbb7" target="e_4e27ce4dd545ed47"><data key="edge_predicate_raw">was set to</data><data key="edge_assertion_id">a_bc0a587dd940e2d3</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Similarly, if a provider sets the Base Metric Attack Vector to Network (AV:N) and an analyst sets Modified Attack Vector to Physical (MAV:P), then the resulting score will be calculated as if the Base Attack Vector was set to Physical</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_51201e0fdf1dd94b" source="e_cf22bfb6e8c361fa" target="e_1fbd30b4980115a8"><data key="edge_predicate_raw">applies to</data><data key="edge_assertion_id">a_bbcf766a5ad6e637</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">A special case to this rule applies to the Modified Subsequent System Integrity (MSI) and the Modified Subsequent System Availability (MSA) which can be set to an additional special value of Safety (S) which is not included in the Base Subsequent System impact metrics</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_9660ef0f63cbfa52" source="e_cf22bfb6e8c361fa" target="e_153151d48b9fb1f7"><data key="edge_predicate_raw">applies to</data><data key="edge_assertion_id">a_a9a71f38516c02e8</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">A special case to this rule applies to the Modified Subsequent System Integrity (MSI) and the Modified Subsequent System Availability (MSA) which can be set to an additional special value of Safety (S) which is not included in the Base Subsequent System impact metrics</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_e6b855b1c7ca40a1" source="e_153151d48b9fb1f7" target="e_d999ddd1227d98cb"><data key="edge_predicate_raw">be set to additional special value of</data><data key="edge_assertion_id">a_bef09fd91604c5a7</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">A special case to this rule applies to the Modified Subsequent System Integrity (MSI) and the Modified Subsequent System Availability (MSA) which can be set to an additional special value of Safety (S) which is not included in the Base Subsequent System impact metrics</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_be4bbd591e73beb2" source="e_d999ddd1227d98cb" target="e_280b458a02d96928"><data key="edge_predicate_raw">is included in</data><data key="edge_assertion_id">a_f6ea173e833173ed</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">A special case to this rule applies to the Modified Subsequent System Integrity (MSI) and the Modified Subsequent System Availability (MSA) which can be set to an additional special value of Safety (S) which is not included in the Base Subsequent System impact metrics</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_6a4167addb47bc3b" source="e_29f65d2a742d0fa3" target="e_977b11c40843a4f2"><data key="edge_predicate_raw">be used for calculation of score In</data><data key="edge_assertion_id">a_ab3a7605d5b152e2</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">In this particular case, the special value will be directly used for the calculation of the score as explained in the section 4.2.1 below</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e540428477a4a34d" source="e_29f65d