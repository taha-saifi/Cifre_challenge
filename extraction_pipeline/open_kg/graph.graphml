w.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">New metrics must not be added to existing metric groups, but must be added to new metric groups</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_68a46ed6c3362e78" source="e_9a8f3abd114e531b" target="e_bbecfad40d527c76"><data key="edge_predicate_raw">be added to</data><data key="edge_assertion_id">a_f85b03ab05f8adec</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">New metrics must not be added to existing metric groups, but must be added to new metric groups</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_8d27cc75d5735721" source="e_bbecfad40d527c76" target="e_582cbc3216c9c0c9"><data key="edge_predicate_raw">be based on</data><data key="edge_assertion_id">a_cf7194903e481db1</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">New metric groups can be based on existing metric groups</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_adfa8f1490714567" source="e_bbecfad40d527c76" target="e_754fa75553fa09be"><data key="edge_predicate_raw">have impact on</data><data key="edge_assertion_id">a_6da6624d21142a1b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">New metric groups can optionally have an impact on the resulting score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_5df19c4ce4e37892" source="e_754fa75553fa09be" target="e_57502fbebac6f4d3"><data key="edge_predicate_raw">be based on</data><data key="edge_assertion_id">a_73c10721546e230d</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The resulting score must be based on adjusting the CVSS-B, CVSS-BT, CVSS-BE, CVSS-BTE scores as appropriate</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_2e1ca684a9579f2b" source="e_754fa75553fa09be" target="e_fd0e4bf7a89d4789"><data key="edge_predicate_raw">be based on</data><data key="edge_assertion_id">a_228fd3931c750f42</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The resulting score must be based on adjusting the CVSS-B, CVSS-BT, CVSS-BE, CVSS-BTE scores as appropriate</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b483117e9afba512" source="e_754fa75553fa09be" target="e_c3db5f094080754d"><data key="edge_predicate_raw">be based on</data><data key="edge_assertion_id">a_25ce6dfd20473605</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The resulting score must be based on adjusting the CVSS-B, CVSS-BT, CVSS-BE, CVSS-BTE scores as appropriate</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_495b65a10b8b7960" source="e_754fa75553fa09be" target="e_45e97aac83e7233d"><data key="edge_predicate_raw">be based on adjusting CVSS-BTE scores as</data><data key="edge_assertion_id">a_d7569be2de8461dc</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The resulting score must be based on adjusting the CVSS-B, CVSS-BT, CVSS-BE, CVSS-BTE scores as appropriate</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e7cfba380e80bb46" source="e_e4e64cd0aa2d2d31" target="e_cf84203db6db5fdb"><data key="edge_predicate_raw">does approve</data><data key="edge_assertion_id">a_093a4cc52985f7ac</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The CVSS SIG does not officially approve extensions, but rather acts as a consulting body, similar to IETF1</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_f2b301c642b30597" source="e_e4e64cd0aa2d2d31" target="e_6aa5f58ba2b470ee"><data key="edge_predicate_raw">acts</data><data key="edge_assertion_id">a_a80fde8bbc2b362f</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The CVSS SIG does not officially approve extensions, but rather acts as a consulting body, similar to IETF1</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_3986ad2f35a03b56" source="e_e4e64cd0aa2d2d31" target="e_6aa5f58ba2b470ee"><data key="edge_predicate_raw">acts as consulting body</data><data key="edge_assertion_id">a_e04bb3f79e3e2735</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The CVSS SIG does not officially approve extensions, but rather acts as a consulting body, similar to IETF1</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_c3fef11fa42f69b2" source="e_5449887309dbf900" target="e_5116743c6705778a"><data key="edge_predicate_raw">be listed on first.org website</data><data key="edge_assertion_id">a_1c826175eb1811dd</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The list of validated extensions will be listed on the first.org website, similar to IANA2</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_3c719d2374d3ae9c" source="e_5449887309dbf900" target="e_589b9e237dce3039"><data key="edge_predicate_raw">be listed on</data><data key="edge_assertion_id">a_2c99663dab4c92ae</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">The list of validated extensions will be listed on the first.org website, similar to IANA2</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_24a7b1fe82e56f61" source="e_7e67eadaaf108cde" target="e_6663adf866efaeda"><data key="edge_predicate_raw">be listed</data><data key="edge_assertion_id">a_37aa1cad53cd8ff2</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">CVSS Extension vector strings must be listed separately, utilizing the following format:</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_30bb153e5ede9051" source="e_b02277edbff0e0e4" target="e_22707e38043fc570"><data key="edge_predicate_raw">is required</data><data key="edge_assertion_id">a_1c0d28c8b686ef6a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">When scoring Attack Vector, use Adjacent or Network (as appropriate), when a network connection is required for an attack to succeed, even if the attack is not launched over a network</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_bdb70da52fa2f0a3" source="e_537e6ab50e8f2e44" target="e_571bc10d653316b8"><data key="edge_predicate_raw">has choosing over</data><data key="edge_assertion_id">a_e7dbf01b444cae0c</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, a local attacker may be able to trick a vulnerable, privileged, local program into sending sensitive data to a server of the attacker’s choosing over a network</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_3c3c9296bb650d9b" source="e_b1387b1015bcac9a" target="e_a2d4ff0cca330308"><data key="edge_predicate_raw">is required to gather</data><data key="edge_assertion_id">a_414898cf1f4d98d7</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">As a network connection is required to gather the sensitive data this is scored with an Attack Vector of Network</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8f36ff90f7932402" source="e_e163460c91338b08" target="e_955f6f574a1665da"><data key="edge_predicate_raw">is scored with</data><data key="edge_assertion_id">a_75f1d3fc08fe8b5c</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">As a network connection is required to gather the sensitive data this is scored with an Attack Vector of Network</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_789bc45e0f5f7eef" source="e_340a67b65e9efc13" target="e_9f4bc004f1ab89c0"><data key="edge_predicate_raw">is received over network</data><data key="edge_assertion_id">a_3d0432cb28dc765c</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">Vulnerabilities where malicious data is received over a network by one system, then passed to a separate system with a vulnerability should be scored with an Attack Vector of Local</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5ab86050c3092757" source="e_340a67b65e9efc13" target="e_9f4bc004f1ab89c0"><data key="edge_predicate_raw">is received</data><data key="edge_assertion_id">a_c7442adcc21e271e</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">Vulnerabilities where malicious data is received over a network by one system, then passed to a separate system with a vulnerability should be scored with an Attack Vector of Local</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_257793d95841fe2e" source="e_9f4bc004f1ab89c0" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">passed to separate system with</data><data key="edge_assertion_id">a_21479f000a1821bd</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">Vulnerabilities where malicious data is received over a network by one system, then passed to a separate system with a vulnerability should be scored with an Attack Vector of Local</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c8bafdaaaf43e962" source="e_5ad6c123e5abaf11" target="e_41977bbb956fd210"><data key="edge_predicate_raw">starts vulnerable system in</data><data key="edge_assertion_id">a_6674bc9a626b3a69</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">An example is a web browser that downloads a malicious office document, saves it to disk, and then starts a vulnerable system (in this case, a document processing application) which reads the saved file</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fdcc9ae7db3983ce" source="e_f31025df433d0a7e" target="e_bc27806f7d651173"><data key="edge_predicate_raw">saves web browser</data><data key="edge_assertion_id">a_1e42db0e79ba6375</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">An example is a web browser that downloads a malicious office document, saves it to disk, and then starts a vulnerable system (in this case, a document processing application) which reads the saved file</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c4e61a21a66586ba" source="e_f31025df433d0a7e" target="e_bc27806f7d651173"><data key="edge_predicate_raw">saves starts vulnerable system in case</data><data key="edge_assertion_id">a_e96969e5299168e2</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">An example is a web browser that downloads a malicious office document, saves it to disk, and then starts a vulnerable system (in this case, a document processing application) which reads the saved file</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_46203e2c070ea2fb" source="e_f31025df433d0a7e" target="e_ad16450d4d7b98f8"><data key="edge_predicate_raw">saves web browser</data><data key="edge_assertion_id">a_785a1896ece12232</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">An example is a web browser that downloads a malicious office document, saves it to disk, and then starts a vulnerable system (in this case, a document processing application) which reads the saved file</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ec709d04c83b0fc4" source="e_f31025df433d0a7e" target="e_ad16450d4d7b98f8"><data key="edge_predicate_raw">saves starts vulnerable system in case</data><data key="edge_assertion_id">a_1ec6c87ca635bc67</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">An example is a web browser that downloads a malicious office document, saves it to disk, and then starts a vulnerable system (in this case, a document processing application) which reads the saved file</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8070098602a44891" source="e_74eed2bf87f1b8c8" target="e_85e8fc5a4010aa9f"><data key="edge_predicate_raw">reads</data><data key="edge_assertion_id">a_f883d43e7bd2e40f</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">An example is a web browser that downloads a malicious office document, saves it to disk, and then starts a vulnerable system (in this case, a document processing application) which reads the saved file</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_d9e09cac2e38c572" source="e_46cf44ea93b1aa6d" target="e_beeb3bf3767a2aca"><data key="edge_predicate_raw">be scored as Network In</data><data key="edge_assertion_id">a_2071ec82ea85b4a3</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">In cases where the vulnerable system contains the functionality that receives the malicious data, Attack Vector should be scored as Network</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fb65343538405303" source="e_46cf44ea93b1aa6d" target="e_571bc10d653316b8"><data key="edge_predicate_raw">be scored as</data><data key="edge_assertion_id">a_29473ba7299b74cf</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">In cases where the vulnerable system contains the functionality that receives the malicious data, Attack Vector should be scored as Network</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8ba53cb8f050d343" source="e_7ee1ff4a70457dd7" target="e_beeb3bf3767a2aca"><data key="edge_predicate_raw">contains functionality</data><data key="edge_assertion_id">a_0a77b71ced9e1b51</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">In cases where the vulnerable system contains the functionality that receives the malicious data, Attack Vector should be scored as Network</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5bbf17518112104a" source="e_c9f7ebbebae4fbbf" target="e_340a67b65e9efc13"><data key="edge_predicate_raw">receives</data><data key="edge_assertion_id">a_ed4595fbf01d3c05</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C16</data><data key="edge_json_path">None</data><data key="edge_evidence">In cases where the vulnerable system contains the functionality that receives the malicious data, Attack Vector should be scored as Network</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ccc433ba86453bd8" source="e_b6432506bf460085" target="e_571bc10d653316b8"><data key="edge_predicate_raw">be scored as</data><data key="edge_assertion_id">a_d024e7cf549ff8a8</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Attack Vector should be scored as Network</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_edc3473590f50483" source="e_3c74f9bc0c3d9897" target="e_da0eaf6d0dc539d1"><data key="edge_predicate_raw">perform system critical actions within</data><data key="edge_assertion_id">a_0d2d156acf0e0a5b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">There could be scenarios where a system user could perform system critical actions, within the user’s own privilege, and then completely deny performing the action; that would cause a Repudiation Impact</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_38fa8336afbd2997" source="e_3c74f9bc0c3d9897" target="e_9ed04b684aeaddcf"><data key="edge_predicate_raw">perform system critical actions</data><data key="edge_assertion_id">a_92998969924b7b6b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">There could be scenarios where a system user could perform system critical actions, within the user’s own privilege, and then completely deny performing the action; that would cause a Repudiation Impact</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_f333c519a9c53fad" source="e_3c74f9bc0c3d9897" target="e_b330f24574fc9b81"><data key="edge_predicate_raw">deny</data><data key="edge_assertion_id">a_b275f14d13acc94a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">There could be scenarios where a system user could perform system critical actions, within the user’s own privilege, and then completely deny performing the action; that would cause a Repudiation Impact</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_9e055e4ebd6feeb0" source="e_3c74f9bc0c3d9897" target="e_ba55d6211ac08e71"><data key="edge_predicate_raw">deny</data><data key="edge_assertion_id">a_25c925e1af75557e</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">There could be scenarios where a system user could perform system critical actions, within the user’s own privilege, and then completely deny performing the action; that would cause a Repudiation Impact</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_c53a6d3cb1526040" source="e_0dd1994901856e68" target="e_840d397c0e759c65"><data key="edge_predicate_raw">cause</data><data key="edge_assertion_id">a_4ac92019820d7094</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">There could be scenarios where a system user could perform system critical actions, within the user’s own privilege, and then completely deny performing the action; that would cause a Repudiation Impact</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_25a23240c680106a" source="e_726130f426106cb3" target="e_0045105c43d56431"><data key="edge_predicate_raw">did do anything beyond</data><data key="edge_assertion_id">a_44de0ef999113d58</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">The malicious admin didn’t do anything beyond own privileges</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_54f76e4ec0231510" source="e_16117b608fa64f9e" target="e_840d397c0e759c65"><data key="edge_predicate_raw">caused</data><data key="edge_assertion_id">a_0cab06a20875f57f</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">But in this case, CWE-778: Insufficient Logging was the weakness which caused a Repudiation impact, and hence an Integrity impact. (Example: CVE-2019-8124)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a5f784c1c45bdb15" source="e_537e6ab50e8f2e44" target="e_3c6c728fe026f9eb"><data key="edge_predicate_raw">take malicious actions in</data><data key="edge_assertion_id">a_7c4192e702d0e87b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">But the attacker can still take malicious actions in the system by impersonating another user of the same privileges leading to a Repudiation impact, and hence an Integrity impact. (Example: CVE-2017-6785)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_215a033de323bec4" source="e_537e6ab50e8f2e44" target="e_966ea6ba0ee45cdd"><data key="edge_predicate_raw">take malicious actions in</data><data key="edge_assertion_id">a_6486e503ff1fd05c</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">But the attacker can still take malicious actions in the system by impersonating another user of the same privileges leading to a Repudiation impact, and hence an Integrity impact. (Example: CVE-2017-6785)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_eb5e09b66caa7e17" source="e_537e6ab50e8f2e44" target="e_93d8650fe6b85a54"><data key="edge_predicate_raw">take malicious actions in</data><data key="edge_assertion_id">a_e19257e24298e967</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">But the attacker can still take malicious actions in the system by impersonating another user of the same privileges leading to a Repudiation impact, and hence an Integrity impact. (Example: CVE-2017-6785)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_16703385815477ae" source="e_724a8f4b4b152206" target="e_840d397c0e759c65"><data key="edge_predicate_raw">be leading to</data><data key="edge_assertion_id">a_74b0bf055d64342b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">But the attacker can still take malicious actions in the system by impersonating another user of the same privileges leading to a Repudiation impact, and hence an Integrity impact. (Example: CVE-2017-6785)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_6afe719ee2d6b5f5" source="e_ad16450d4d7b98f8" target="e_93d8650fe6b85a54"><data key="edge_predicate_raw">impacts Integrity of</data><data key="edge_assertion_id">a_261959f1e8ba6ef9</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Whenever a vulnerability causes a potential repudiation, it immediately impacts the Integrity of the system, along with other subsequent impacts</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_76cce5b725c492e4" source="e_ad16450d4d7b98f8" target="e_a759ffb9494b80c6"><data key="edge_predicate_raw">impacts Integrity of system along with</data><data key="edge_assertion_id">a_094afb17ea551b3a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Whenever a vulnerability causes a potential repudiation, it immediately impacts the Integrity of the system, along with other subsequent impacts</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ddc714c42d77dda2" source="e_dbd1ba0cc63988dc" target="e_0c2e756f0ed8aa74"><data key="edge_predicate_raw">causes</data><data key="edge_assertion_id">a_78adc7423de82e5d</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Whenever a vulnerability causes a potential repudiation, it immediately impacts the Integrity of the system, along with other subsequent impacts</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c61170c5ec2f8af8" source="e_ba0065176e2591f2" target="e_83af6f5fdcf6fddc"><data key="edge_predicate_raw">provides guidance on</data><data key="edge_assertion_id">a_1b21b92debbd214a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">This section provides guidance on selecting appropriate metric values for these based on the characteristics of a specific environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_93982eeb0401e64c" source="e_ba0065176e2591f2" target="e_934c1f7b91073d1f"><data key="edge_predicate_raw">provides</data><data key="edge_assertion_id">a_d29ccce99dbc5160</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">This section provides guidance on selecting appropriate metric values for these based on the characteristics of a specific environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b7689a6083550b0b" source="e_4bc4eb1baf280b10" target="e_a83d78667bb486cf"><data key="edge_predicate_raw">are simplified to illustrate</data><data key="edge_assertion_id">a_3884f04d2f17f64c</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">The examples are simplified to illustrate the concepts</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_edca183ceb5989bd" source="e_01bfb050f261768c" target="e_352aa36a4f934e61"><data key="edge_predicate_raw">used</data><data key="edge_assertion_id">a_349c51835b23f9de</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">The Confidentiality Requirement of a system should be based on the classification level of the data that is stored or used by the user and/or applications running on the target system</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_616b02de450d8433" source="e_c622ef1f54fda5bd" target="e_d93d3f2293801306"><data key="edge_predicate_raw">be taken into</data><data key="edge_assertion_id">a_4075516fad4c2095</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Encryption of the data at rest on this device should also be taken into consideration when establishing the Confidentiality Requirement</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_426705e3f936a8ef" source="e_c622ef1f54fda5bd" target="e_de9553ff493560e7"><data key="edge_predicate_raw">be taken into consideration when</data><data key="edge_assertion_id">a_60ceeee6162ee56d</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Encryption of the data at rest on this device should also be taken into consideration when establishing the Confidentiality Requirement</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_56a01bada02b45c5" source="e_61641163de7ce9bc" target="e_fe71bcaf94bcb750"><data key="edge_predicate_raw">passes through device without</data><data key="edge_assertion_id">a_8ee1fd663f454d25</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Data that passes through a device without being consumed or processed (e.g., a switch or firewall) should not be taken into consideration when assessing this attribute</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_7270b44e1a710696" source="e_61641163de7ce9bc" target="e_f9d993a34943743c"><data key="edge_predicate_raw">passes through device without</data><data key="edge_assertion_id">a_fd5154f668b8340a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C17</data><data key="edge_json_path">None</data><data key="edge_evidence">Data that passes through a device without being consumed or processed (e.g., a switch or firewall) should not be taken into consideration when assessing this attribute</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_cd59b1c348a780b6" source="e_61641163de7ce9bc" target="e_7eccdb8a16f99bae"><data key="edge_predicate_raw">passes through</data><data key="edge_assertion_id">a_271993303f27f53e</data><data key="edge_sourc