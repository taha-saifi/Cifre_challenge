data><data key="edge_json_path">None</data><data key="edge_evidence">The use of multiple vulnerabilities to achieve an overall outcome is known as "vulnerability chaining." SSVC lets</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c1b95f14133faa61" source="e_3068da8f4844da53" target="e_794eacf546214ced"><data key="edge_predicate_raw">be achieve</data><data key="edge_assertion_id">a_b5a47d8759080cbd</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">The use of multiple vulnerabilities to achieve an overall outcome is known as "vulnerability chaining." SSVC lets</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_4f1806d5cba07689" source="e_d4cff6070f136c90" target="e_8332b65a2e047ba7"><data key="edge_predicate_raw">consider</data><data key="edge_assertion_id">a_762bdfe58cfed164</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">analysts consider vulnerability chaining when determining the correct automatable decision point</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9dd7fd000530bc42" source="e_dbd1ba0cc63988dc" target="e_1ff256734a169bb7"><data key="edge_predicate_raw">be chaining when</data><data key="edge_assertion_id">a_5c07849b8aebf8e9</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">analysts consider vulnerability chaining when determining the correct automatable decision point</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f3178ecc6478ec4d" source="e_4f99a70924824209" target="e_9b76083ba3f21406"><data key="edge_predicate_raw">perform In</data><data key="edge_assertion_id">a_104122512c209dcc</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">In contrast to non-essential functions, an organization “must perform a [MEF] during a disruption to normal</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fe33f6f4924ec41b" source="e_4f99a70924824209" target="e_206b43150a3ee04c"><data key="edge_predicate_raw">perform during</data><data key="edge_assertion_id">a_69dacb66e503106c</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">In contrast to non-essential functions, an organization “must perform a [MEF] during a disruption to normal</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c7b007969edb91d7" source="e_4f99a70924824209" target="e_e03236cb54bb68ce"><data key="edge_predicate_raw">exists</data><data key="edge_assertion_id">a_14ed7dfbf636b029</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">operations.”3 The mission is the reason an organization exists, and MEFs are how that mission is realized</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_67b853173cb023f3" source="e_f5282588cca580e9" target="e_68605030f6ad54d2"><data key="edge_predicate_raw">support</data><data key="edge_assertion_id">a_73ac27a1853935b1</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">essential functions support the smooth delivery or success of MEFs rather than directly supporting the mission</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f39725c7de316d49" source="e_f5282588cca580e9" target="e_0750e3a27214d3ae"><data key="edge_predicate_raw">support success of</data><data key="edge_assertion_id">a_31e05a3b9d8a4d87</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">essential functions support the smooth delivery or success of MEFs rather than directly supporting the mission</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f3d76b612cc26f40" source="e_f5282588cca580e9" target="e_635360fa7f3504e2"><data key="edge_predica