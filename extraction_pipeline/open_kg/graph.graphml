raw">consists of</data><data key="edge_assertion_id">a_1742641026ed3340</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">A CVSS vector string consists of a compressed textual representation of the values used to derive the score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8085ae9b5bc4fdd9" source="e_a9ed604eb1323e31" target="e_4364e67a28b13c95"><data key="edge_predicate_raw">be used to derive</data><data key="edge_assertion_id">a_d5c70f7a744cb8a1</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">A CVSS vector string consists of a compressed textual representation of the values used to derive the score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fd4abdfb97960d68" source="e_b1abc47325cb826c" target="e_e94f91e35c1b7dcb"><data key="edge_predicate_raw">be found at</data><data key="edge_assertion_id">a_946c48fac59d0207</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The most current CVSS resources can be found at https://www.first.org/cvss/</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_940804d577a4bc20" source="e_29f374d3ae492bbc" target="e_81cbd545ac116bb7"><data key="edge_predicate_raw">reserves</data><data key="edge_assertion_id">a_5f32c8e1b26304bf</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">FIRST reserves the right to update CVSS and this document periodically at its sole discretion</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a325abca30b09bc9" source="e_599b6cd1166e8fab" target="e_3cf72a85fc7edc64"><data key="edge_predicate_raw">be update</data><data key="edge_assertion_id">a_8e4c404a3f4650c6</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">FIRST reserves the right to update CVSS and this document periodically at its sole discretion</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_842fc8d49472f93f" source="e_29f374d3ae492bbc" target="e_7d71f6b7f3df9b75"><data key="edge_predicate_raw">owns</data><data key="edge_assertion_id">a_692746c2d3365a77</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">While FIRST owns all rights and interest in CVSS, it licenses it to the public freely for use, subject to the conditions below</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_d83964d48acdf265" source="e_022732e26b7b8bc6" target="e_3cf72a85fc7edc64"><data key="edge_predicate_raw">is required to use</data><data key="edge_assertion_id">a_6260527ae32b7217</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Membership in FIRST is not required to use or implement CVSS</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_08410290a3cb568f" source="e_022732e26b7b8bc6" target="e_a0d60350cd3ed040"><data key="edge_predicate_raw">is required</data><data key="edge_assertion_id">a_629406fe4576e829</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Membership in FIRST is not required to use or implement CVSS</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_3f2487dd734639c8" source="e_749697968074f926" target="e_803d80074cf06ab9"><data key="edge_predicate_raw">used</data><data key="edge_assertion_id">a_dc0f0155f98b7124</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">FIRST does, however, require that any individual or entity using CVSS give proper attribution, where applicable, that CVSS is owned by FIRST and used by permission</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_24f76adbb6881f6f" source="e_29f374d3ae492bbc" target="e_867f177d2871e08a"><data key="edge_predicate_raw">requires</data><data key="edge_assertion_id">a_e912afdb6081868b</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Further, FIRST requires as a condition of use that any individual or entity which publishes CVSS data conforms to the guidelines described in this document and provides both the score and the vector string so others can understand how the score was derived</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_824bf3ddd9bf6a96" source="e_b585119b28a1d6c9" target="e_cf503d8a57cdc58d"><data key="edge_predicate_raw">captures principal technical characteristics of</data><data key="edge_assertion_id">a_dc562172fad111e1</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Common Vulnerability Scoring System (CVSS) captures the principal technical characteristics of software, hardware and firmware vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_08c44949d30b71f0" source="e_b585119b28a1d6c9" target="e_e93e0b19f73f2484"><data key="edge_predicate_raw">captures principal technical characteristics of</data><data key="edge_assertion_id">a_787978b56a3f6509</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Common Vulnerability Scoring System (CVSS) captures the principal technical characteristics of software, hardware and firmware vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f3f169ec9d5fff9c" source="e_b585119b28a1d6c9" target="e_bbef9357513b0323"><data key="edge_predicate_raw">captures principal technical characteristics of</data><data key="edge_assertion_id">a_ed41d9f15a9f88f5</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Common Vulnerability Scoring System (CVSS) captures the principal technical characteristics of software, hardware and firmware vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b3714eb4dd3e16ea" source="e_bbeb401fc98aa4bb" target="e_d75978bf19f265d8"><data key="edge_predicate_raw">include</data><data key="edge_assertion_id">a_a7497f51b67b37b9</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Its outputs include numerical scores indicating the severity of a vulnerability relative to other vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_3d711cc92bf84e92" source="e_54114dfd8bd8776d" target="e_4f4ef27afd32ba29"><data key="edge_predicate_raw">be indicating</data><data key="edge_assertion_id">a_5a5da36970df340b</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Its outputs include numerical scores indicating the severity of a vulnerability relative to other vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_6431b44f6e263a30" source="e_5dd63c0e6e0c1501" target="e_63e627de38b828ae"><data key="edge_predicate_raw">reflects</data><data key="edge_assertion_id">a_8e7753a4f97b1cbf</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base Score reflects the severity of a vulnerability according to its intrinsic characteristics which are constant over time and assumes the reasonable worst-case impact across different deployed environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">reported</data></edge><edge id="oe_a3e46d76671eb645" source="e_5dd63c0e6e0c1501" target="e_dfb9a225e3a6b59a"><data key="edge_predicate_raw">assumes reasonable worst-case impact across</data><data key="edge_assertion_id">a_b5594e09a4c974f4</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base Score reflects the severity of a vulnerability according to its intrinsic characteristics which are constant over time and assumes the reasonable worst-case impact across different deployed environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">reported</data></edge><edge id="oe_79c24e9466238533" source="e_8a5f1e21d35a9318" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">are constant over</data><data key="edge_assertion_id">a_7f3b96c2f16f46ba</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base Score reflects the severity of a vulnerability according to its intrinsic characteristics which are constant over time and assumes the reasonable worst-case impact across different deployed environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">reported</data></edge><edge id="oe_34b5507ba6f53cd3" source="e_b02545dbef6b631f" target="e_be7e53e39b5f4ecc"><data key="edge_predicate_raw">adjust</data><data key="edge_assertion_id">a_08e62298bed15285</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Threat Metrics adjust the severity of a vulnerability based on factors, such as the availability of proof-of-concept code or active exploitation</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_d7b10befebfecf75" source="e_b02545dbef6b631f" target="e_bd6f1ca14c1a3b4a"><data key="edge_predicate_raw">adjust</data><data key="edge_assertion_id">a_6541107fa5321a4e</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Threat Metrics adjust the severity of a vulnerability based on factors, such as the availability of proof-of-concept code or active exploitation</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7851077950dbc241" source="e_b54a46ece8e786db" target="e_6270b5012ad9d707"><data key="edge_predicate_raw">refine further</data><data key="edge_assertion_id">a_ddd6fc476272be09</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental Metrics further refine the resulting severity score to a specific computing environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_3d0a69f11ebc5ddd" source="e_b54a46ece8e786db" target="e_6491de2f1e702934"><data key="edge_predicate_raw">refine resulting severity score to</data><data key="edge_assertion_id">a_5c71dfa7a6d08070</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental Metrics further refine the resulting severity score to a specific computing environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0cc193fd19cd473b" source="e_b54a46ece8e786db" target="e_6270b5012ad9d707"><data key="edge_predicate_raw">refine</data><data key="edge_assertion_id">a_bf685e68c7d6e313</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental Metrics further refine the resulting severity score to a specific computing environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a691596a9eb031d1" source="e_290d8da624d84fb0" target="e_37519529ecae123d"><data key="edge_predicate_raw">consider</data><data key="edge_assertion_id">a_a3b802666816bec4</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">They consider factors such as the presence of mitigations in that environment and the criticality attributes of the vulnerable system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ab622d0dfcba73fb" source="e_290d8da624d84fb0" target="e_2351bcb81ba17027"><data key="edge_predicate_raw">consider</data><data key="edge_assertion_id">a_97eb7a8550b60b81</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">They consider factors such as the presence of mitigations in that environment and the criticality attributes of the vulnerable system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7868863e352e06b6" source="e_80b852b98e6b518c" target="e_7069213457cbe14e"><data key="edge_predicate_raw">are provided by</data><data key="edge_assertion_id">a_c2f788235442512f</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Base Metrics, and optionally Supplemental Metrics, are provided by the organization maintaining the vulnerable system, or a third party assessment on their behalf</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c080e83b12e80529" source="e_b2a26612a73c754d" target="e_7069213457cbe14e"><data key="edge_predicate_raw">are provided by</data><data key="edge_assertion_id">a_2d047c804f867e4f</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Base Metrics, and optionally Supplemental Metrics, are provided by the organization maintaining the vulnerable system, or a third party assessment on their behalf</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_3c76b7f9ce2b86e6" source="e_4f99a70924824209" target="e_7ee1ff4a70457dd7"><data key="edge_predicate_raw">be maintaining</data><data key="edge_assertion_id">a_4df15f21e46aedbd</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Base Metrics, and optionally Supplemental Metrics, are provided by the organization maintaining the vulnerable system, or a third party assessment on their behalf</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_728fe21aa5c299dc" source="e_838a95b0b63fa880" target="e_035903dbb83828a9"><data key="edge_predicate_raw">is available to</data><data key="edge_assertion_id">a_ece8a3fe295cec41</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C02</data><dat