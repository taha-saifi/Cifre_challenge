ines.</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a98a78eeae7d038d" source="e_fbfb70a00355d68e" target="e_06e658826ae0c25a"><data key="edge_predicate_raw">has published date</data><data key="edge_assertion_id">a_aff17c8be84ec1c6</data><data key="edge_source_id">S06</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-63520</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.published</data><data key="edge_evidence">published: 2026-08-11T17:18:47.377</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7f1753c45e5d5826" source="e_fbfb70a00355d68e" target="e_7e31cc6e5f37e12c"><data key="edge_predicate_raw">has last modified date</data><data key="edge_assertion_id">a_03c19d94ca9735cb</data><data key="edge_source_id">S06</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-63520</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.lastModified</data><data key="edge_evidence">lastModified: 2026-08-13T13:38:30.453</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ed113caa2d8a5e82" source="e_fbfb70a00355d68e" target="e_b5b88d276861e80d"><data key="edge_predicate_raw">has vulnerability status</data><data key="edge_assertion_id">a_8a9a78621ab90ec0</data><data key="edge_source_id">S06</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-63520</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.vulnStatus</data><data key="edge_evidence">vulnStatus: Analyzed</data><data key="edge_extraction_method">structured</data><data key="edge_polari