_id">S12</data><data key="edge_source_url">https://medium.com/@quirso_de/active-exploitation-of-cve-2026-59310-361-victim-ips-across-47-countries-9783187cc6ff</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Its legitimate penetration-testing features include automatic connect-back, SSH port forwarding, file transfer, multiple transports and remote shell management</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_71bcca9dc57ea846" source="e_4b33bf8c9c6ea600" target="e_71e5a3736713020f"><data key="edge_predicate_raw">include</data><data key="edge_assertion_id">a_b49f05bdfc5841c4</data><data key="edge_source_id">S12</data><data key="edge_source_url">https://medium.com/@quirso_de/active-exploitation-of-cve-2026-59310-361-victim-ips-across-47-countries-9783187cc6ff</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Its legitimate penetration-testing features include automatic connect-back, SSH port forwarding, file transfer, multiple transports and remote shell management</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a0769384a1fe3ed5" source="e_4b33bf8c9c6ea600" target="e_fc38994fd7e89be6"><data key="edge_predicate_raw">include</data><data key="edge_assertion_id">a_28e6ee7195d70af2</data><data key="edge_source_id">S12</data><data key="edge_source_url">https://medium.com/@quirso_de/active-exploitation-of-cve-2026-59310-361-victim-ips-across-47-countries-9783187cc6ff</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Its legitimate penetration-testing features include automatic connect-back, SSH port forwarding, file transfer, multiple transports and remote shell management</data><data key="edg