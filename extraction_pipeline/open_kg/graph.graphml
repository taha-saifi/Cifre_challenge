ta key="edge_evidence">A CVSS score is also represented as a vector string, a compressed textual representation of the values used to derive the score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_cd11fa3ff2b89f75" source="e_b1abc47325cb826c" target="e_e94f91e35c1b7dcb"><data key="edge_predicate_raw">be found at</data><data key="edge_assertion_id">a_5b9e7d60c0964a76</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The most current CVSS resources can be found at https://www.first.org/cvss/</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_6bd12dfb5f49ba7c" source="e_599b6cd1166e8fab" target="e_3cf72a85fc7edc64"><data key="edge_predicate_raw">be update</data><data key="edge_assertion_id">a_d59e4f5099bf7439</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">FIRST reserves the right to update CVSS and this document periodically at its sole discretion</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a1ad63d0ea25dfc2" source="e_29f374d3ae492bbc" target="e_81cbd545ac116bb7"><data key="edge_predicate_raw">reserves</data><data key="edge_assertion_id">a_dd65b18698c9a993</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">FIRST reserves the right to update CVSS and this document periodically at its sole discretion</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7950b5e3f814075f" source="e_29f374d3ae492bbc" target="e_3cf72a85fc7edc64"><data key="edge_predicate_raw">owns right in</data><data key="edge_assertion_id">a_7a46095426b8b921</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">While FIRST owns all right and interest in CVSS, it licenses it to the public freely for use, subject to the conditions below</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0a628b023128aa1d" source="e_29f374d3ae492bbc" target="e_7d71f6b7f3df9b75"><data key="edge_predicate_raw">owns</data><data key="edge_assertion_id">a_1ebd84e58dc1db52</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">While FIRST owns all right and interest in CVSS, it licenses it to the public freely for use, subject to the conditions below</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_abcded5987ce459f" source="e_022732e26b7b8bc6" target="e_3cf72a85fc7edc64"><data key="edge_predicate_raw">is required to use</data><data key="edge_assertion_id">a_175036b4846f1534</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Membership in FIRST is not required to use or implement CVSS</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_65f575bb2d1d856c" source="e_022732e26b7b8bc6" target="e_a0d60350cd3ed040"><data key="edge_predicate_raw">is required</data><data key="edge_assertion_id">a_8ee986b7c5b59b8f</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Membership in FIRST is not required to use or implement CVSS</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_0c60032d42183288" source="e_749697968074f926" target="e_803d80074cf06ab9"><data key="edge_predicate_raw">used</data><data key="edge_assertion_id">a_47f60582d628a553</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">FIRST does, however, require that any individual or entity using CVSS give proper attribution, where applicable, that CVSS is owned by FIRST and used by permission</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_2a34cf96fbe4c9da" source="e_29f374d3ae492bbc" target="e_b6e05751684f96a7"><data key="edge_predicate_raw">requires</data><data key="edge_assertion_id">a_e3ae2db58f718102</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Further, FIRST requires as a condition of use that any individual or entity which publishes scores conforms to the guidelines described in this document and provides both the score and the scoring vector so others can understand how the score was derived</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_6c654cc6c5db8b54" source="e_b585119b28a1d6c9" target="e_cf503d8a57cdc58d"><data key="edge_predicate_raw">captures principal technical characteristics of</data><data key="edge_assertion_id">a_cf472a4cd106926d</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Common Vulnerability Scoring System (CVSS) captures the principal technical characteristics of software, hardware and firmware vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_4206e8c8605f47b2" source="e_b585119b28a1d6c9" target="e_e93e0b19f73f2484"><data key="edge_predicate_raw">captures principal technical characteristics of</data><data key="edge_assertion_id">a_717c4088022bafb2</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Common Vulnerability Scoring System (CVSS) captures the principal technical characteristics of software, hardware and firmware vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_30295c0711e673d4" source="e_b585119b28a1d6c9" target="e_bbef9357513b0323"><data key="edge_predicate_raw">captures principal technical characteristics of</data><data key="edge_assertion_id">a_f280df2f4ff86c94</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Common Vulnerability Scoring System (CVSS) captures the principal technical characteristics of software, hardware and firmware vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_3f1a9c047c72640f" source="e_bbeb401fc98aa4bb" target="e_d75978bf19f265d8"><data key="edge_predicate_raw">include</data><data key="edge_assertion_id">a_08013da1a30cae9f</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Its outputs include numerical scores indicating the severity of a vulnerability relative to other vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5930c734d8d474b8" source="e_54114dfd8bd8776d" target="e_4f4ef27afd32ba29"><data key="edge_predicate_raw">be indicating</data><data key="edge_assertion_id">a_5ac9a45aa311af5e</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">Its outputs include numerical scores indicating the severity of a vulnerability relative to other vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5244ebea95cdc5ed" source="e_5dd63c0e6e0c1501" target="e_63e627de38b828ae"><data key="edge_predicate_raw">reflects</data><data key="edge_assertion_id">a_03716be0c0b7ba1f</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base Score reflects the severity of a vulnerability according to its intrinsic characteristics which are constant over time and assumes the reasonable worst case impact across different deployed environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">reported</data></edge><edge id="oe_6cc1cbc5c53b870a" source="e_5dd63c0e6e0c1501" target="e_dfb9a225e3a6b59a"><data key="edge_predicate_raw">assumes reasonable worst case impact across</data><data key="edge_assertion_id">a_4a765370c0f47ad9</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base Score reflects the severity of a vulnerability according to its intrinsic characteristics which are constant over time and assumes the reasonable worst case impact across different deployed environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">reported</data></edge><edge id="oe_360d22becd293a01" source="e_8a5f1e21d35a9318" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">are constant over</data><data key="edge_assertion_id">a_9aafda9e27ec970c</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Base Score reflects the severity of a vulnerability according to its intrinsic characteristics which are constant over time and assumes the reasonable worst case impact across different deployed environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">reported</data></edge><edge id="oe_d9e9f87fae7514d6" source="e_fdb2716c144fa03f" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">change over</data><data key="edge_assertion_id">a_0376cd1f7ba4fc92</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Temporal Metrics adjust the Base severity of a vulnerability based on factors that change over time, such as the availability of exploit code</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_77c6347252128dc0" source="e_d558a240751fca46" target="e_53fb3f52e50e89a4"><data key="edge_predicate_raw">adjust</data><data key="edge_assertion_id">a_99b7c550aead7c9d</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Temporal Metrics adjust the Base severity of a vulnerability based on factors that change over time, such as the availability of exploit code</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8c2fe5452bd61f26" source="e_b54a46ece8e786db" target="e_6491de2f1e702934"><data key="edge_predicate_raw">adjust Base to</data><data key="edge_assertion_id">a_156822df8a339897</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental Metrics adjust the Base and Temporal severities to a specific computing environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_17d755d3b5651cea" source="e_b54a46ece8e786db" target="e_6491de2f1e702934"><data key="edge_predicate_raw">adjust Temporal severities to</data><data key="edge_assertion_id">a_1b154e56a9bc51f0</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental Metrics adjust the Base and Temporal severities to a specific computing environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_258f07ccab4141c2" source="e_b54a46ece8e786db" target="e_3bca66551d1e30df"><data key="edge_predicate_raw">adjust</data><data key="edge_assertion_id">a_bd90f4139cdac5b7</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental Metrics adjust the Base and Temporal severities to a specific computing environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0131ccf156216672" source="e_b54a46ece8e786db" target="e_46aae4675d89b0f9"><data key="edge_predicate_raw">adjust</data><data key="edge_assertion_id">a_a9eaa74a1c1de738</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">The Environmental Metrics adjust the Base and Temporal severities to a specific computing environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_bab058a18402bf22" source="e_290d8da624d84fb0" target="e_37519529ecae123d"><data key="edge_predicate_raw">consider</data><data key="edge_assertion_id">a_42b0a67cbd215178</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C01</data><data key="edge_json_path">None</data><data key="edge_evidence">They consider factors such as the presence of mitigations in that environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_854d0c8defedb7e9" source="e_a7121d8886ad6bca" target="e_f80f4a42f00da908"><data key="edge_predicate_raw">are produced by</data><data key="edge_assertion_id">a_18bdb88cc18c8005</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Base Scores are usually produced by the organization maintaining the vulnerable product, or a third party scoring on their behalf</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a14b4d40f37940fa" source="e_4f99a70924824209" target="e_02ef297f69111ff2"><data key="edge_predicate_raw">be maintaining</data><data key="edge_assertion_id">a_20f316d3853db11e</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Base Scores are usually produced by the organization maintaining the vulnerable product, or a third party scoring on their behalf</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c01fb208bfd19e5c" source="e_cee6c4a180d725c2" target="e_e54943b334c1ec72"><data key="edge_predicate_raw">be scoring on</data><data key="edge_assertion_id">a_b31380b7c1a25fd7</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Base Scores are usually produced by the organization maintaining the vulnerable product, or a third party scoring on their behalf</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fd6122add1cae694" source="e_ad16450d4d7b98f8" target="e_497c03fe2b7b67ab"><data key="edge_predicate_raw">is typical for</data><data key="edge_assertion_id">a_79c608a61ceecd11</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">It is typical for only the Base Metrics to be published as these do not change over time and are common to all environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_d4d5f2a558e3f2f6" source="e_1e8fc3121cd402ea" target="e_ca335c133f4134dc"><data key="edge_predicate_raw">do change over</data><data key="edge_assertion_id">a_69c070d22622cd57</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">It is typical for only the Base Metrics to be published as these do not change over time and are common to all environments</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_4bf1823a632c2be8" source="e_9601b737f7f4595e" target="e_ac3137bde6e231c3"><data key="edge_predicate_raw">supplement Base Score with</data><data key="edge_assertion_id">a_68a8a4170c876bf5</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers of CVSS should supplement the Base Score with Temporal and Environmental Scores specific to their use of the vulnerable product to produce a severity more accurate for their organizational environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f70d9db25275631f" source="e_9601b737f7f4595e" target="e_0a08cd94b3043c4a"><data key="edge_predicate_raw">supplement Base Score with</data><data key="edge_assertion_id">a_a3db3a4148420a92</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers of CVSS should supplement the Base Score with Temporal and Environmental Scores specific to their use of the vulnerable product to produce a severity more accurate for their organizational environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a2685cfa3e0fcb91" source="e_9601b737f7f4595e" target="e_5dd63c0e6e0c1501"><data key="edge_predicate_raw">supplement</data><data key="edge_assertion_id">a_dbd92a3cfdddef2f</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers of CVSS should supplement the Base Score with Temporal and Environmental Scores specific to their use of the vulnerable product to produce a severity more accurate for their organizational environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_eb93dfc25babd9c2" source="e_2d4e09df2adaeebc" target="e_499dd71fc0a5507c"><data key="edge_predicate_raw">be produce severity more accurate for</data><data key="edge_assertion_id">a_6f4967c93a34dac9</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumers of CVSS should supplement the Base Score with Temporal and Environmental Scores specific to their use of the vulnerable product to produce a severity more accurate for their organizational environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_56ee4fb6383ec605" source="e_f7f0082982beecc7" target="e_5686e5c631b8054e"><data key="edge_predicate_raw">use CVSS information as</data><data key="edge_assertion_id">a_0eae21f5dc360eeb</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3