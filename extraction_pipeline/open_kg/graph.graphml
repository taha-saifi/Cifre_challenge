y="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_6eca4215e497b455" source="e_0c26841570172bd5" target="e_15c4b8b661ffa085"><data key="edge_predicate_raw">lies in</data><data key="edge_assertion_id">a_2881469c81367902</data><data key="edge_source_id">S16</data><data key="edge_source_url">https://unit42.paloaltonetworks.com/autonomous-ai-cyber-attack-campaign/</data><data key="edge_chunk_id">S16_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">The significance of these findings lies in the trajectory rather than the outcome of any individual campaign</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9bdb48a07352cb94" source="e_444cf5c34809311d" target="e_89be8d6fc1fb31d4"><data key="edge_predicate_raw">executing</data><data key="edge_assertion_id">a_855217ab82096564</data><data key="edge_source_id">S16</data><data key="edge_source_url">https://unit42.paloaltonetworks.com/autonomous-ai-cyber-attack-campaign/</data><data key="edge_chunk_id">S16_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">The actor is actively iterating — refining tool configurations, developing custom skills, establishing proxy infrastructure and executing autonomous attack cycles</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b8cefb2dc81cb9f1" source="e_d5ac758a309f3169" target="e_28557e5a12dfd0ae"><data key="edge_predicate_raw">continues to</data><data key="edge_assertion_id">a_382fe8aa56235150</data><data key="edge_source_id">S16</data><data key="edge_source_url">https://unit42.paloaltonetworks.com/autonomous-ai-cyber-attack-campaign/</data><data key="edge_chunk_id">S16_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">