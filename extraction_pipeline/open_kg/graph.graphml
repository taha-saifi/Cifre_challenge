a key="edge_modality">asserted</data></edge><edge id="oe_79040bd6f7bb6f96" source="e_741149884ba72e33" target="e_16fc6d93fae96623"><data key="edge_predicate_raw">Hit</data><data key="edge_assertion_id">a_b81545d91331f82e</data><data key="edge_source_id">S44</data><data key="edge_source_url">https://diesec.com/2026/08/vmware-vcenter-cve-2026-59310/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">VMware vCenter CVE-2026-59310: Germany Hit Hardest</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_aff9b08662c1e0e5" source="e_2244eeeb213ec10e" target="e_9d157c667e852a28"><data key="edge_predicate_raw">live during</data><data key="edge_assertion_id">a_8c537dccd531739a</data><data key="edge_source_id">S44</data><data key="edge_source_url">https://diesec.com/2026/08/vmware-vcenter-cve-2026-59310/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">German incident-response firm QUIRSO uncovered the campaign live during an IR engagement, tracing 361 distinct victim IP addresses back to a directory-traversal flaw in vCenter’s Syslog server that Broadcom patched on July 29</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_60ff861e3cd39844" source="e_d17d99c2914fb3fa" target="e_bc29fe0de70cfb86"><data key="edge_predicate_raw">patched vCenter 's Syslog server on</data><data key="edge_assertion_id">a_d81f445bd789726d</data><data key="edge_source_id">S44</data><data key="edge_source_url">https://diesec.com/2026/08/vmware-vcenter-cve-2026-59310/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">German incident-response firm QUIRSO uncovered the campaign live during an IR engagement, tracing 361 distinct victim IP addresses back to a directory-traversal flaw in vCenter’s Syslog server that Broadcom patched on July 29</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1f82a6d401ae60b0" source="e_d17d99c2914fb3fa" target="e_17dc28ccc10496dd"><data key="edge_predicate_raw">patched</data><data key="edge_assertion_id">a_45adca16e7289fff</data><data key="edge_source_id">S44</data><data key="edge_source_url">https://diesec.com/2026/08/vmware-vcenter-cve-2026-59310/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">German incident-response firm QUIRSO uncovered the campaign live during an IR engagement, tracing 361 distinct victim IP addresses back to a directory-traversal flaw in vCenter’s Syslog server that Broadcom patched on July 29</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_943950e59be8eead" source="e_504b05d329b569f1" target="e_a7c8a7811012ffd6"><data key="edge_predicate_raw">be disclosed by Broadcom on</data><data key="edge_assertion_id">a_ff2215dc4550c0ca</data><data key="edge_source_id">S44</data><data key="edge_source_url">https://diesec.com/2026/08/vmware-vcenter-cve-2026-59310/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">CVE-2026-59310 is a directory-traversal vulnerability in the VMware vCenter Syslog server, disclosed by Broadcom on July 29, 2026 (VMSA-2026-0006) with a CVSS v3.1 score of 9.8</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7478e89c6b8308e6" source="e_504b05d329b569f1" target="e_d17d99c2914fb3fa"><data key="edge_predicate_raw">be disclosed by</data><data key="edge_assertion_id">a_bff4b15f9750cb4e</data><data key="edge_source_id">S44</data><data key="edge_source_url">https://diesec.com/2026/08/vmware-vcenter-cve-2026-59310/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">CVE-2026-59310 is a directory-traversal vulnerability in the VMware vCenter Syslog server, disclosed by Broadcom on July 29, 2026 (VMSA-2026-0006) with a CVSS v3.1 score of 9.8</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_63a84f7425c8cd43" source="e_7728e2b3bc50ae75" target="e_80424f1f0920557d"><data key="edge_predicate_raw">is directory-traversal vulnerability in</data><data key="edge_assertion_id">a_52857b4e6c1842c3</data><data key="edge_source_id">S44</data><data key="edge_source_url">https://diesec.com/2026/08/vmware-vcenter-cve-2026-59310/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">CVE-2026-59310 is a directory-traversal vulnerability in the VMware vCenter Syslog server, disclosed by Broadcom on July 29, 2026 (VMSA-2026-0006) with a CVSS v3.1 score of 9.8</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_4161fc247f506aef" source="e_d0de5eac16608de2" target="e_f1469154a41fa408"><data key="edge_predicate_raw">can exploit</data><data key="edge_assertion_id">a_528b303dc2ebc2cb</data><data key="edge_source_id">S44</data><data key="edge_source_url">https://diesec.com/2026/08/vmware-vcenter-cve-2026-59310/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">An attacker with network access to vCenter — no prior authentication needed — can exploit the flaw to write files outside the intended directory and ultimately execute arbitrary code on the vCenter server itself</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_7500097cbcece8ba" source="e_618d93742ee02dc6" target="e_e90912ec26feac2d"><data key="edge_predicate_raw">began around</data><data key="edge_assertion_id">a_c36f60a71abf1d94</data><data key="edge_source_id">S44</data><data key="edge_source_url">https://diesec.com/2026/08/vmware-vcenter-cve-2026-59310/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Exploitation began around August 3, 2026, roughly five days after public disclosure</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_dc07736e457182da" source="e_f6c8c89f43ed8687" target="e_60746b32e49ce10f"><data key="edge_predicate_raw">be gathered during</data><data key="edge_assertion_id">a_60c4877ed05bcab7</data><data key="edge_source_id">S44</data><data key="edge_source_url">https://diesec.com/2026/08/vmware-vcenter-cve-2026-59310/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">QUIRSO’s telemetry, gathered during an active incident-response engagement, counted 361 unique victim IP addresses spread across 47 countries</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5768a72e52b4e8a4" source="e_741149884ba72e33" target="e_741149884ba72e33"><data key="edge_predicate_raw">account for largest share of compromised hosts with</data><data key="edge_assertion_id">a_f9c58778569bb0c7</data><data key="edge_source_id">S44</data><data key="edge_source_url">https://diesec.com/2026/08/vmware-vcenter-cve-2026-59310/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Germany, the United States, Turkey, Iran and France account for the largest share of compromise