="e_8ea2d5e84baadda6" target="e_c2300a2b8413d008"><data key="edge_predicate_raw">has CISA action due date</data><data key="edge_assertion_id">a_1a0ad5de440723fa</data><data key="edge_source_id">S03</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-55040</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.cisaActionDue</data><data key="edge_evidence">2026-08-21</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_59ec683a29ec5cc7" source="e_8ea2d5e84baadda6" target="e_9b28c50be6e7da88"><data key="edge_predicate_raw">has CISA required action</data><data key="edge_assertion_id">a_97804c689a142798</data><data key="edge_source_id">S03</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-55040</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.cisaRequiredAction</data><data key="edge_evidence">Apply mitigations in accordance with vendor instructions, ensuring compliance with CISA’s BOD 26-04 Prioritizing Security Updates Based on Risk (see URL in Notes) guidance and CISA’s “Forensics Triage Requirements” (see URL in Notes). Follow applicable BOD 26-04 guidance for cloud services or discontinue use of the product if mitigations are unavailable. Stakeholders are responsible for evaluating each asset's internet exposure and ensuring adherence to BOD 26-04 patching guidelines.</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ab45aa91733ff935" source="e_7728e2b3bc50ae75" target="e_ac0f7b9a84db88a3"><data key="edge_predicate_raw">has published date</data><data key="edge_assertion_id">a_b202ad53cf9ccb0c</data><data key="edge_source_id">S04</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-59310</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.published</data><data key="edge_evidence">published: 2026-07-30T13:16:53.993</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_252c32dc6887e9bb" source="e_7728e2b3bc50ae75" target="e_508a9008a5cc2274"><data key="edge_predicate_raw">has last modified date</data><data key="edge_assertion_id">a_b2bf4fc319899bb3</data><data key="edge_source_id">S04</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-59310</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.lastModified</data><data key="edge_evidence">lastModified: 2026-08-19T04:17:24.940</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9765e06d77420799" source="e_7728e2b3bc50ae75" target="e_b5b88d276861e80d"><data key="edge_predicate_raw">has vulnerability status</data><data key="edge_assertion_id">a_24dbe938cc96c2f8</data><data key="edge_source_id">S04</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-59310</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.vulnStatus</data><data key="edge_evidence">vulnStatus: Analyzed</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_d567ca8449b956a4" source="e_7728e2b3bc50ae75" target="e_f65539a204048c7d"><data key="edge_predicate_raw">has source identifier</data><data key="edge_assertion_id">a_5dce97031350c25c</data><data key="edge_source_id">S04</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-59310</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.v