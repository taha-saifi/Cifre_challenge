_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">In some circumstances, the Base metrics may differ on different product versions, platforms, and/or operating systems</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_18b0f4e5c8c62904" source="e_80b852b98e6b518c" target="e_8be38bbecf21a7b3"><data key="edge_predicate_raw">differ on</data><data key="edge_assertion_id">a_8e0858cbcc2ac27f</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">In some circumstances, the Base metrics may differ on different product versions, platforms, and/or operating systems</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_b30af7eab0376fd2" source="e_9c2e79484c45fd01" target="e_5ad6c123e5abaf11"><data key="edge_predicate_raw">is applicable For</data><data key="edge_assertion_id">a_730a00ece1d8fb08</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, a hypothetical vulnerability is applicable to multiple operating systems produced by the same vendor</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c347853253c73f72" source="e_9c2e79484c45fd01" target="e_f89aac5775f3e8ef"><data key="edge_predicate_raw">is applicable to multiple operating systems produced by</data><data key="edge_assertion_id">a_5fdcc5c920df3d1e</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, a hypothetical vulnerability is applicable to multiple operating systems produced by the same vendor</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1dc60676766f9fea" source="e_20eedadc83aff3b0" target="e_f89aac5775f3e8ef"><data key="edge_predicate_raw">be produced by</data><data key="edge_assertion_id">a_7c04b45e4ebddcf6</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, a hypothetical vulnerability is applicable to multiple operating systems produced by the same vendor</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7cd22ca4957f86ec" source="e_4801fe47c6613feb" target="e_7b4f67c17e442588"><data key="edge_predicate_raw">change Attack Complexity to</data><data key="edge_assertion_id">a_6c9cc3a43da1bcb6</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">However, a newer operating system has new inherent protection capabilities that change the Attack Complexity to High (H)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f4336ff65aafee8d" source="e_4801fe47c6613feb" target="e_76edc2bdd4022652"><data key="edge_predicate_raw">change</data><data key="edge_assertion_id">a_2308b9496fb19814</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">However, a newer operating system has new inherent protection capabilities that change the Attack Complexity to High (H)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_19ee866512f64673" source="e_ede880f604e26f42" target="e_c0d91b611f395da1"><data key="edge_predicate_raw">be outlining</data><data key="edge_assertion_id">a_778d87a0ce394f03</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">It is acceptable to assess and publish multiple CVSS-B scores for a single vulnerability provided each has additional language outlining the specific product versions, platforms, and/or operating systems that are relevant to each CVSS-B score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0dd06b6dbf0ef21e" source="e_ede880f604e26f42" target="e_a71a25fded255343"><data key="edge_predicate_raw">be outlining</data><data key="edge_assertion_id">a_a35f0dce3f1a2920</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">It is acceptable to assess and publish multiple CVSS-B scores for a single vulnerability provided each has additional language outlining the specific product versions, platforms, and/or operating systems that are relevant to each CVSS-B score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_73b8595ddac10d0a" source="e_ede880f604e26f42" target="e_8be38bbecf21a7b3"><data key="edge_predicate_raw">be outlining</data><data key="edge_assertion_id">a_eaccfc35f25cce2a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">It is acceptable to assess and publish multiple CVSS-B scores for a single vulnerability provided each has additional language outlining the specific product versions, platforms, and/or operating systems that are relevant to each CVSS-B score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_68f748a1293e2dbe" source="e_1ad4fa20584b7a30" target="e_4ad90eb816a48e13"><data key="edge_predicate_raw">be using</data><data key="edge_assertion_id">a_f7b4f56525067296</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">Values for all CVSS-B metrics (not only a numeric CVSS-B score) must be supplied for each affected product version, platform, and/or operating system using a standard format</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_6d435f277a7d1ab3" source="e_1b26466706d6d315" target="e_89ef65857569b41b"><data key="edge_predicate_raw">exist to leverage core foundation of CVSS for</data><data key="edge_assertion_id">a_8324799a28043159</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C15</data><data key="edge_json_path">None</data><data key="edge_evidence">Opportunities exist to leverage the c