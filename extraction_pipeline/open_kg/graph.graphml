_e9711a485e37b296</data><data key="edge_source_id">S46</data><data key="edge_source_url">https://www.sentrium.co.uk/labs/windows-ike-service-extensions-vulnerability-enables-remote-code-execution-cve-2026-33824</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Sentrium supports organisations in identifying and managing exposure to critical infrastructure vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_aaa9f40ee7ab2a36" source="e_9ea9f5ea2cf426bf" target="e_0f1f7e6a36f6f4e2"><data key="edge_predicate_raw">supports</data><data key="edge_assertion_id">a_f512976e114f2044</data><data key="edge_source_id">S46</data><data key="edge_source_url">https://www.sentrium.co.uk/labs/windows-ike-service-extensions-vulnerability-enables-remote-code-execution-cve-2026-33824</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Sentrium supports organisations in identifying and managing exposure to critical infrastructure vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a99181f4399b923d" source="e_8ce4dd550b5d64a5" target="e_2bb1c73eb57da45e"><data key="edge_predicate_raw">has assessment by</data><data key="edge_assertion_id">a_d6fa0669208b5424</data><data key="edge_source_id">S46</data><data key="edge_source_url">https://www.sentrium.co.uk/labs/windows-ike-service-extensions-vulnerability-enables-remote-code-execution-cve-2026-33824</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Start your assessment today by completing our Sentrium penetration testing enquiry form</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8c7d6112774f6201" source="e_5bb272a22c6abb50" target="e_da59e58134436c3a"><data key="edge_predicate_raw">be exploited in</data><data key="edge_assertion_id">a_c9ff7a1593281fec</data><data key="edge_source_id">S47</data><data key="edge_source_url">https://www.first.org/epss/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">The Exploit Prediction Scoring System (EPSS) is a data-driven machine-learning model that estimates the probability that a published CVE will be exploited in the wild in the next 30 days</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5d7f1a31f765cd6d" source="e_5c980ac08d8e06db" target="e_53e6279ddd6e53b3"><data key="edge_predicate_raw">focus</data><data key="edge_assertion_id">a_67cc5c82a25bbee2</data><data key="edge_source_id">S47</data><data key="edge_source_url">https://www.first.org/epss/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">It offsets subjective judgments with empirical signals from observed exploitation and ongoing activity, helping you focus limited remediation effort where attacks are most likely</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_aaa680e8f0533856" source="e_22e800482ee5b5fd" target="e_bf332acbd501ae6d"><data key="edge_predicate_raw">are most</data><data key="edge_assertion_id">a_9974cb68eb5a7a01</data><data key="edge_source_id">S47</data><data key="edge_source_url">https://www.first.org/epss/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">It offsets subjective judgments with empirical signals from observed exploitation and ongoing activity, helping you focus limited remediation effort where attacks are most likely</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_90e4b75371504fbb" source="e_15be66e9ad41889e" target="e_d848adf61c9b8850"><data key="edge_predicate_raw">makes</data><data key="edge_assertion_id">a_b0c66e45eb5478d9</data><data key="edge_source_id">S47</data><data key="edge_source_url">https://www.first.org/epss/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">EPSS publishes a 0–1 probability (with ranking percentiles) every day for every CVE and makes the data freely and openly accessible via CSV and API as well as a github repo, so it slots easily into workflows and dashboards</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a46bd354ac0eb666" source="e_15be66e9ad41889e" target="e_51d85e32f9e7eb0c"><data key="edge_predicate_raw">makes accessible via</data><data key="edge_assertion_id">a_e5d6ba9aa59315a1</data><data key="edge_source_id">S47</data><data key="edge_source_url">https://www.first.org/epss/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">EPSS publishes a 0–1 probability (with ranking percentiles) every day for every CVE and makes the data freely and openly accessible via CSV and API as well as a github repo, so it slots easily into workflows and dashboards</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a8bf903a76e8dfe1" source="e_15be66e9ad41889e" target="e_1169e8d1093a489f"><data key="edge_predicate_raw">makes accessible via</data><data key="edge_assertion_id">a_0a652afda314b6ca</data><data key="edge_source_id">S47</data><data key="edge_source_url">https://www.first.org/epss/</data><data key="edge_ch