</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Devices that contain data directly used to make health decisions should be rated High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_3e1cd92ef4b7d6bf" source="e_61641163de7ce9bc" target="e_2ec07d67a031de15"><data key="edge_predicate_raw">be used to make</data><data key="edge_assertion_id">a_a6341d456f0fc9d0</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Devices that contain data directly used to make health decisions should be rated High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ca463708d710c1b2" source="e_e1cfc695b1b6dfe7" target="e_7b4f67c17e442588"><data key="edge_predicate_raw">be rated</data><data key="edge_assertion_id">a_b9137513ba2db53f</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Devices that contain data directly used to make health decisions should be rated High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_645e9f4b494cd634" source="e_04862b0252e3113e" target="e_296484ce1f23de32"><data key="edge_predicate_raw">be rated at</data><data key="edge_assertion_id">a_e064cb2c41a27a18</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Network equipment such as a router or switch will generally be rated at least Medium due strictly to the sensitivity of information such as forwarding tables, etc</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5213ae65fdd15499" source="e_97edd5acd89f9331" target="e_296484ce1f23de32"><data key="edge_predicate_raw">be rated at</data><data key="edge_assertion_id">a_84f6805a581c6db8</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Network equipment such as a router or switch will generally be rated at least Medium due strictly to the sensitivity of information such as forwarding tables, etc</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_6a8816a5f088b34d" source="e_04862b0252e3113e" target="e_4e590b6ad583a439"><data key="edge_predicate_raw">be rated at least Medium due strictly to sensitivity of</data><data key="edge_assertion_id">a_ebce029c46bd9605</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Network equipment such as a router or switch will generally be rated at least Medium due strictly to the sensitivity of information such as forwarding tables, etc</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_6fcec89ec0c1667a" source="e_97edd5acd89f9331" target="e_4e590b6ad583a439"><data key="edge_predicate_raw">be rated at least Medium due strictly to sensitivity of</data><data key="edge_assertion_id">a_826404b8a32c1869</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Network equipment such as a router or switch will generally be rated at least Medium due strictly to the sensitivity of information such as forwarding tables, etc</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_d58b01e97555caca" source="e_31218d5fbdfe6a35" target="e_2c349636a7f49ab0"><data key="edge_predicate_raw">be rated as</data><data key="edge_assertion_id">a_f344684a21afa967</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Firewalls should be rated as High due to the sensitivity of the rule set</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b4a6eb58243175ba" source="e_ce31ee5fd3e3b19f" target="e_7eccdb8a16f99bae"><data key="edge_predicate_raw">be based on uptime requirements of</data><data key="edge_assertion_id">a_c1f8f806d53ce183</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">The Availability Requirement of a system should be based on the uptime requirements and redundancy of the device or the applications hosted by the device</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9e83e663227c56b9" source="e_ce31ee5fd3e3b19f" target="e_6a692a4954fd2347"><data key="edge_predicate_raw">be based on</data><data key="edge_assertion_id">a_203193877330ce1b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">The Availability Requirement of a system should be based on the uptime requirements and redundancy of the device or the applications hosted by the device</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8ca0012f506b065b" source="e_ce31ee5fd3e3b19f" target="e_7eccdb8a16f99bae"><data key="edge_predicate_raw">be based on applications hosted by</data><data key="edge_assertion_id">a_441876b66103d256</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">The Availability Requirement of a system should be based on the uptime requirements and redundancy of the device or the applications hosted by the device</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a3943ea042743e13" source="e_391b448e7eb0cfb0" target="e_7eccdb8a16f99bae"><data key="edge_predicate_raw">be hosted by</data><data key="edge_assertion_id">a_d2a7a76c01b9bfa2</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">The Availability Requirement of a system should be based on the uptime requirements and redundancy of the device or the applications hosted by the device</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_942fc7cb5f5bc6e8" source="e_e1cfc695b1b6dfe7" target="e_c47f34e9c179e3e1"><data key="edge_predicate_raw">are part of</data><data key="edge_assertion_id">a_f3bcc7a39a4ec1f4</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Devices that are part of redundant clusters will have lower Availability Requirements</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e96fa0be9159812f" source="e_15bd7a47ff8b692e" target="e_0fc67c1d25981c2e"><data key="edge_predicate_raw">are rated with</data><data key="edge_assertion_id">a_1be81ad05b2e1a2f</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Devices without full capacity redundancy that are rated with recovery requirements less than 24 hours should be rated High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_4d22a10aad173ebc" source="e_b1d6968604227d92" target="e_030111ecac4d18ed"><data key="edge_predicate_raw">be rated</data><data key="edge_assertion_id">a_efbc819863da3465</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Devices without full capacity redundancy that are rated with recovery requirements between 1-5 days should be rated Medium</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_68189f26e198af10" source="e_bfea3c73293d30ac" target="e_d5bfbcb5ba84f908"><data key="edge_predicate_raw">be rated as</data><data key="edge_assertion_id">a_dfa4b5e4353f6f61</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Clustered devices and/or those with full capacity redundancy should be rated as Low</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_d017ebcf7afbe06b" source="e_4d5ff973992d585f" target="e_d5bfbcb5ba84f908"><data key="edge_predicate_raw">be rated as</data><data key="edge_assertion_id">a_b2be14c7dd0b9546</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Clustered devices and/or those with full capacity redundancy should be rated as Low</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c4cd398cc53bedf6" source="e_e1cfc695b1b6dfe7" target="e_866f4db1c2b22919"><data key="edge_predicate_raw">are required to have</data><data key="edge_assertion_id">a_f984cbda30abd324</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Devices that are required to have rapid response times for transactional purposes based on regulatory requirements, should be rated High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_07c0894f58dd3e15" source="e_e1cfc695b1b6dfe7" target="e_6fa0fb9d7056547b"><data key="edge_predicate_raw">are required to have rapid response times for</data><data key="edge_assertion_id">a_fb8c73476bcb5530</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Devices that are required to have rapid response times for transactional purposes based on regulatory requirements, should be rated High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9d4a6229efb2d49a" source="e_65557458ccb5f7c4" target="e_5709be18828b5822"><data key="edge_predicate_raw">be based on</data><data key="edge_assertion_id">a_15f21db98d96ecff</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Devices that are required to have rapid response times for transactional purposes based on regulatory requirements, should be rated High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1359e5983a5b3980" source="e_e1cfc695b1b6dfe7" target="e_7b4f67c17e442588"><data key="edge_predicate_raw">be rated</data><data key="edge_assertion_id">a_548fcdd7f43143b6</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">Devices that are required to have rapid response times for transactional purposes based on regulatory requirements, should be rated High</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_58e6ef3eabcc8fd7" source="e_54b478dcf9b37c22" target="e_1e8070a280814846"><data key="edge_predicate_raw">provides</data><data key="edge_assertion_id">a_e7b17ef218178a00</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">A new, optional metric group called the Supplemental metric group provides new metrics that describe and measure additional extrinsic attributes of a vulnerability</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_56601aef4be6aac4" source="e_586e3102a6ab682b" target="e_9a5ad6de08ab74ad"><data key="edge_predicate_raw">be used</data><data key="edge_assertion_id">a_79b44ea06847ba06</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C18</data><data key="edge_json_path">None</data><data key="edge_evidence">This contextual information may be used differently in each consumer’s environment</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_d9638c08a1da8265" source="e_768bf52735c34131" target="e_660f4f640dd0931a"><data key="edge_predicate_raw">convey additional extrinsic characteristics of</data><data key="edge_assertion_id">a_82aef9ef7079e338</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">Metrics and values will simply convey additional extrinsic characteristics of the vulnerability itself</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ee68ff3b9655ab2d" source="e_a9ed604eb1323e31" target="e_660f4f640dd0931a"><data key="edge_predicate_raw">convey additional extrinsic characteristics of</data><data key="edge_assertion_id">a_b32d2da0a252d6b9</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">Metrics and values will simply convey additional extrinsic characteristics of the vulnerability itself</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a4b193139981abf8" source="e_9cf9e67a33f313e5" target="e_d999ddd1227d98cb"><data key="edge_predicate_raw">be aligned to</data><data key="edge_assertion_id">a_2df0653e9ca5563b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">When a system has an intended use or fitness of purpose aligned to safety, it is possible that exploiting a vulnerability within that system may have Safety impact which can be represented in the Supplemental Metrics group</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_190fa83b25f9ac53" source="e_fb8ea41b8705c2d6" target="e_8fc389924516130b"><data key="edge_predicate_raw">be represented in</data><data key="edge_assertion_id">a_e77cc6a240fdc11d</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">When a system has an intended use or fitness of purpose aligned to safety, it is possible that exploiting a vulnerability within that system may have Safety impact which can be represented in the Supplemental Metrics group</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_b3965918e693e010" source="e_022bda0b03ad1169" target="e_3efdc84762bfa93d"><data key="edge_predicate_raw">uses</data><data key="edge_assertion_id">a_09166197fa6cdea3</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">delivery uses channels that widely deployed network security configurations block, and</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_975993a594a00323" source="e_3efdc84762bfa93d" target="e_9e1814c1c1f0b957"><data key="edge_predicate_raw">deployed</data><data key="edge_assertion_id">a_656e736da3c2b1b0</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">delivery uses channels that widely deployed network security configurations block, and</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7f244e4c76d793ec" source="e_618d93742ee02dc6" target="e_ad0079b5add58365"><data key="edge_predicate_raw">is reliable</data><data key="edge_assertion_id">a_2808f5b3604e06ad</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">exploitation is not reliable, due to exploit-prevention techniques enabled by default; ASLR is an example of an exploit-prevention tool</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_4b921889696145a3" source="e_d517f5dfd7db6dd5" target="e_9299086080c4accc"><data key="edge_predicate_raw">be enabled by</data><data key="edge_assertion_id">a_0a7a37d5857eb6a4</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">exploitation is not reliable, due to exploit-prevention techniques enabled by default; ASLR is an example of an exploit-prevention tool</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_ceaecbfcd574538a" source="e_5cd3d0abe013a8be" target="e_189a4122f3e069ba"><data key="edge_predicate_raw">is example of</data><data key="edge_assertion_id">a_dfe1549592815558</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">exploitation is not reliable, due to exploit-prevention techniques enabled by default; ASLR is an example of an exploit-prevention tool</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_f295d0f08b217706" source="e_40e9b4cae7572c3e" target="e_fb003243b2adf690"><data key="edge_predicate_raw">be provided for</data><data key="edge_assertion_id">a_090c96a4bb21c590</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">These are example reasons, provided for illustration, and are not an exhaustive list of reasons why a kill chain step may not be automatable</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_0508863afb7de770" source="e_970cff862ce2bb64" target="e_fb003243b2adf690"><data key="edge_predicate_raw">be provided for</data><data key="edge_assertion_id">a_b55939fd3f17fee9</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">These are example reasons, provided for illustration, and are not an exhaustive list of reasons why a kill chain step may not be automatable</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_afe1d96a537f8c9e" source="e_1e8fc3121cd402ea" target="e_fb003243b2adf690"><data key="edge_predicate_raw">are example reasons provided for</data><data key="edge_assertion_id">a_5b750fe9d8534748</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">These are example reasons, provided for illustration, and are not an exhaustive list of reasons why a kill chain step may not be automatable</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_18bd079ac4c3ce4e" source="e_1e8fc3121cd402ea" target="e_598f385ecb096de3"><data key="edge_predicate_raw">are exhaustive list of</data><data key="edge_assertion_id">a_09d9ad44638eb4ac</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">These are example reasons, provided for illustration, and are not an exhaustive list of reasons why a kill chain step may not be automatable</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_bc0890c711c7a644" source="e_dbd1ba0cc63988dc" target="e_eb4c55863d9af897"><data key="edge_predicate_raw">allows</data><data key="edge_assertion_id">a_64bf5062f793b010</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">As one heuristic for yes, if the vulnerability allows unauthenticated remote code execution or command injection, the expected response is yes</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_4a7ecd4dd6270aa6" source="e_dbd1ba0cc63988dc" target="e_5510a8a748415eed"><data key="edge_predicate_raw">allows</data><data key="edge_assertion_id">a_498c324c083464ec</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">As one heuristic for yes, if the vulnerability allows unauthenticated remote code execution or command injection, the expected response is yes</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7262bad965971de1" source="e_d4cff6070f136c90" target="e_c1c167f9445786e3"><data key="edge_predicate_raw">provide</data><data key="edge_assertion_id">a_cb9be086052f982d</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">Analysts should provide an argument or demonstration that all four steps are able to be automated rather than solely relying on heuristics</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0baf38ba252e5462" source="e_bd446b8be4ff3757" target="e_76f941d8ac2aec07"><data key="edge_predicate_raw">stay</data><data key="edge_assertion_id">a_94f76756a130a4dd</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">The definition of automatable is intended to stay materially the same as the definition of the decision point by the same name in the stakeholder specific vulnerability categorization (version 2)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c88a646743ef22b0" source="e_bd446b8be4ff3757" target="e_ebd90615f387a20a"><data key="edge_predicate_raw">stay</data><data key="edge_assertion_id">a_a6ff0f1de97a4d4e</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">The definition of automatable is intended to stay materially the same as the definition of the decision point by the same name in the stakeholder specific vulnerability categorization (version 2)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9caab6e68b8569f1" source="e_11ec9ccc1fc96285" target="e_287a42987bc6bb3d"><data key="edge_predicate_raw">publish Qualitative Severity Ratings from</data><data key="edge_assertion_id">a_b9148751875f3ab8</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">Other vendors publish Qualitative Severity Ratings from the CVSS v3.x Specification Document in their advisories</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9460d8e306e97398" source="e_11ec9ccc1fc96285" target="e_835140d8fc9de36c"><data key="edge_predicate_raw">publish Qualitative Severity Ratings in</data><data key="edge_assertion_id">a_776618fe6a1217c3</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">Other vendors publish Qualitative Severity Ratings from the CVSS v3.x Specification Document in their advisories</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1921922e3d33b20e" source="e_11ec9ccc1fc96285" target="e_6d50e79cbe0c218e"><data key="edge_predicate_raw">publish</data><data key="edge_assertion_id">a_d69c4373ab1583d9</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">Other vendors publish Qualitative Severity Ratings from the CVSS v3.x Specification Document in their advisories</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fdfa679d85962003" source="e_bb192ae9e03fa1fb" target="e_4a17d33b79767a98"><data key="edge_predicate_raw">be incorporate</data><data key="edge_assertion_id">a_49426356836d28ff</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">To facilitate a standardized method to incorporate additional provider-supplied assessment, it is proposed to adopt an optional “pass-through” Supplemental Metric called Provider Urgency</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ebcb243a487a1604" source="e_ad16450d4d7b98f8" target="e_359279469b39720b"><data key="edge_predicate_raw">is proposed to adopt optional pass-through Supplemental Metric called Provider Urgency To facilitate</data><data key="edge_assertion_id">a_77aa26da146ff6ad</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">To facilitate a standardized method to incorporate additional provider-supplied assessment, it is proposed to adopt an optional “pass-through” Supplemental Metric called Provider Urgency</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5aafe108d78ade7e" source="e_36f90a3cb73c2af0" target="e_47c9fe22e7bb1dd8"><data key="edge_predicate_raw">called</data><data key="edge_assertion_id">a_bf3e9ac01cd20a15</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C19</data><data key="edge_json_path">None</data><data key="edge_evidence">To facilitate a standardized method to incorporate additional provider-supplied assessment, it is proposed to adopt an optional “pass-through” Supplemental Metric called Provider Urgency</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_4b78783377e1b099" source="e_6cfaadc524dbde57" target="e_7f018f637ddffa7b"><data key="edge_predicate_raw">requires</data><data key="edge_assertion_id">a_e4eef299dd1935c7</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">User (U): The Component/System requires manual intervention by the user to recover services, after an attack has been performed</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_bb0c04b62a819e5c" source="e_ea2962b83fdcf010" target="e_4676679afd99eed0"><data key="edge_predicate_raw">are suggestive examples of when to select Diffuse for</data><data key="edge_assertion_id">a_cf122412e64cc7b7</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">The following are suggestive examples of when to select the Diffuse or Concentrated metric values for this metric</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_d710703967bfc0d7" source="e_ea2962b83fdcf010" target="e_4676679afd99eed0"><data key="edge_predicate_raw">are suggestive examples of when to select Concentrated metric values for</data><data key="edge_assertion_id">a_4d875628257ab453</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">The following are suggestive examples of when to select the Diffuse or Concentrated metric values for this metric</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8d8dabe1cb0b5165" source="e_6130f752858a0708" target="e_48b9de94f1a079e8"><data key="edge_predicate_raw">be owned by</data><data key="edge_assertion_id">a_57217ab110d16252</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">Diffuse: Examples of systems with diffuse value are email accounts, most consumer online banking accounts, common cell phones, and most personal computing resources owned and maintained by users. (A “user” is anyone whose professional task is something other than the maintenance of the system or component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_3029053002b74aa7" source="e_62555e79585e1059" target="e_93d8650fe6b85a54"><data key="edge_predicate_raw">is responsible for proper operation of</data><data key="edge_assertion_id">a_b4465b439f2038db</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">A “system operator” is anyone who is professionally responsible for the proper operation or maintenance of a system.)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_138b15b24958a782" source="e_62555e79585e1059" target="e_fa752e8a0efa8d52"><data key="edge_predicate_raw">is responsible for</data><data key="edge_assertion_id">a_045ee154251485c4</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">A “system operator” is anyone who is professionally responsible for the proper operation or maintenance of a system.)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fb83193428c6a52b" source="e_f46bd6c3e68cd941" target="e_526b5c56fe76dbfd"><data key="edge_predicate_raw">are direct responsibility of</data><data key="edge_assertion_id">a_31ed480120836ce1</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">Concentrated: Heuristically, such systems are often the direct responsibility of “system operators” rather than users. (A “user” is anyone whose professional task is something other than the maintenance of the system or component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1f7866d363aaa919" source="e_f46bd6c3e68cd941" target="e_48b9de94f1a079e8"><data key="edge_predicate_raw">are direct responsibility rather than</data><data key="edge_assertion_id">a_36ea544e5f7a8c0a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">Concentrated: Heuristically, such systems are often the direct responsibility of “system operators” rather than users. (A “user” is anyone whose professional task is something other than the maintenance of the system or component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_60c32670258bb690" source="e_403cff0ef11d571d" target="e_bb06948234c7db8a"><data key="edge_predicate_raw">be hosting</data><data key="edge_assertion_id">a_957c4ff51e6c76fa</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">A “system operator” is anyone who is professionally responsible for the proper operation or maintenance of a system.) Examples of concentrated value are database systems, Kerberos servers, web servers hosting login pages, and cloud service providers</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_986d0e904dd86e16" source="e_a4c79dc1075d4e26" target="e_c040aef1e0ce6571"><data key="edge_predicate_raw">inform</data><data key="edge_assertion_id">a_263a184e32550d86</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">However, usefulness and uniqueness of the resources on the vulnerable system also inform value density</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_34ee26e979f49e53" source="e_f17c7cc268ec74cb" target="e_c040aef1e0ce6571"><data key="edge_predicate_raw">inform</data><data key="edge_assertion_id">a_ec78f833aa564409</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">However, usefulness and uniqueness of the resources on the vulnerable system also inform value density</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_2cc025803973c5e9" source="e_b513313d2355cbb2" target="e_5ad6c123e5abaf11"><data key="edge_predicate_raw">have concentrated value For</data><data key="edge_assertion_id">a_4481309b6de6abb5</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, encrypted mobile messaging platforms may have concentrated value, not because each phone’s messaging history has a particularly large amount of data, but because it is uniquely valuable to law enforcement</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_233067251a1bce02" source="e_b513313d2355cbb2" target="e_47869b8b12d1452e"><data key="edge_predicate_raw">have concentrated</data><data key="edge_assertion_id">a_bdeb5a0156e8307e</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, encrypted mobile messaging platforms may have concentrated value, not because each phone’s messaging history has a particularly large amount of data, but because it is uniquely valuable to law enforcement</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_6e2fa912752d9c83" source="e_ad16450d4d7b98f8" target="e_28dd035941535d8c"><data key="edge_predicate_raw">is valuable to</data><data key="edge_assertion_id">a_b492b7ae88214441</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, encrypted mobile messaging platforms may have concentrated value, not because each phone’s messaging history has a particularly large amount of data, but because it is uniquely valuable to law enforcement</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_42d64ff24595b794" source="e_27c3d83a97913d23" target="e_76f941d8ac2aec07"><data key="edge_predicate_raw">stay</data><data key="edge_assertion_id">a_257dd1cf0cef3784</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">The definition of value density is intended to stay materially the same as the definition of the decision point by the same name in the stakeholder specific vulnerability categorization (version 2)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_3a22ebc0115074a0" source="e_27c3d83a97913d23" target="e_ebd90615f387a20a"><data key="edge_predicate_raw">stay</data><data key="edge_assertion_id">a_9f11dc3190b45936</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">The definition of value density is intended to stay materially the same as the definition of the decision point by the same name in the stakeholder specific vulnerability categorization (version 2)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8bd0f7c15f38e47f" source="e_f7f0082982beecc7" target="e_fd676437ab51b484"><data key="edge_predicate_raw">to provide</data><data key="edge_assertion_id">a_f872f0610ac29057</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">The intention of the Vulnerability Response Effort metric is to provide supplemental information on how difficult it is for consumers to provide an initial response to the impact of vulnerabilities for deployed products and services in their infrastructure</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_359e4e7aa66015a1" source="e_f7f0082982beecc7" target="e_fa83bcbab886e89f"><data key="edge_predicate_raw">to provide</data><data key="edge_assertion_id">a_5438549645ccb90a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">The intention of the Vulnerability Response Effort metric is to provide supplemental information on how difficult it is for consumers to provide an initial response to the impact of vulnerabilities for deployed products and services in their infrastructure</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_af9e7ac6c15c88ba" source="e_a4d6f98a0fb303d3" target="e_0da99a133597d918"><data key="edge_predicate_raw">take additional information on effort required into</data><data key="edge_assertion_id">a_ec4fd774da056225</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">The consumer can then take this additional information on effort required into consideration when applying mitigations and/or scheduling remediation</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_1ede1970c24f0b71" source="e_a4d6f98a0fb303d3" target="e_ac1d0f6b26b25574"><data key="edge_predicate_raw">take additional information on effort required into</data><data key="edge_assertion_id">a_95c0ef2eac04d2a3</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">The consumer can then take this additional information on effort required into consideration when applying mitigations and/or scheduling remediation</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_22dab79834ee38d1" source="e_70973f0fc94d31c9" target="e_7f765772ac6c1cb7"><data key="edge_predicate_raw">be required into consideration when</data><data key="edge_assertion_id">a_ce4a8f98a936ac99</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">The consumer can then take this additional information on effort required into consideration when applying mitigations and/or scheduling remediation</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_52487c860bc42e4e" source="e_70973f0fc94d31c9" target="e_301ab130bb3a8852"><data key="edge_predicate_raw">be required into consideration when</data><data key="edge_assertion_id">a_88e3ccd5a2ea811f</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">The consumer can then take this additional information on effort required into consideration when applying mitigations and/or scheduling remediation</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_1bba0eabfca8dff4" source="e_70973f0fc94d31c9" target="e_d93d3f2293801306"><data key="edge_predicate_raw">be required into</data><data key="edge_assertion_id">a_1d9bfdd70db4cf3a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">The consumer can then take this additional information on effort required into consideration when applying mitigations and/or scheduling remediation</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_a77ae982ba2e697e" source="e_d5c915872f1063a4" target="e_1ff9ff52fcffcf3a"><data key="edge_predicate_raw">required</data><data key="edge_assertion_id">a_940a00b76ebaef71</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">When calculating Vulnerability Response Effort, the effort required to deploy the quickest available response should be considered</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_cebdacf3d34e59c9" source="e_be74ffef073dc8d3" target="e_0267402202f58eec"><data key="edge_predicate_raw">use standard definitions for</data><data key="edge_assertion_id">a_93b8f5af74f63628</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">As much as possible, we will use standard definitions for terms and prefer global, consensus, freely available definitions.4</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_546f98202dbad602" source="e_be74ffef073dc8d3" target="e_4c69475582351a86"><data key="edge_predicate_raw">use</data><data key="edge_assertion_id">a_9ca833ff7ab62198</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">As much as possible, we will use standard definitions for terms and prefer global, consensus, freely available definitions.4</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_d7587455ca0b7dd9" source="e_be74ffef073dc8d3" target="e_eca0458802e0dd47"><data key="edge_predicate_raw">prefer</data><data key="edge_assertion_id">a_7c41d8ba544e5283</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">As much as possible, we will use standard definitions for terms and prefer global, consensus, freely available definitions.4</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_1fd7ac3b1407b71b" source="e_93d8650fe6b85a54" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">is affected by</data><data key="edge_assertion_id">a_74009b67b7865b95</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">Affected: A system is affected by a vulnerability if a user or operator of the system must take action to remediate, mitigate, or otherwise address the vulnerability.5 If a system is affected by a vulnerability, the CVSS v4.0 Base score must not be 0.0</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_fe11c2e902b4736c" source="e_c7b43ec7e5be0c4a" target="e_6c0b102b5b5a264a"><data key="edge_predicate_raw">take action to</data><data key="edge_assertion_id">a_183e966bd684ba31</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">Affected: A system is affected by a vulnerability if a user or operator of the system must take action to remediate, mitigate, or otherwise address the vulnerability.5 If a system is affected by a vulnerability, the CVSS v4.0 Base score must not be 0.0</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_440a631766953375" source="e_c7b43ec7e5be0c4a" target="e_5561eb65bbb8faad"><data key="edge_predicate_raw">take action</data><data key="edge_assertion_id">a_3ddc63e23139564a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">Affected: A system is affected by a vulnerability if a user or operator of the system must take action to remediate, mitigate, or otherwise address the vulnerability.5 If a system is affected by a vulnerability, the CVSS v4.0 Base score must not be 0.0</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_582f421c6a06ba77" source="e_79f5e4367de5c3a5" target="e_6c0b102b5b5a264a"><data key="edge_predicate_raw">take action to</data><data key="edge_assertion_id">a_ce01663f3fddd59b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">Affected: A system is affected by a vulnerability if a user or operator of the system must take action to remediate, mitigate, or otherwise address the vulnerability.5 If a system is affected by a vulnerability, the CVSS v4.0 Base score must not be 0.0</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_32e2eaf2c09b41ac" source="e_79f5e4367de5c3a5" target="e_5561eb65bbb8faad"><data key="edge_predicate_raw">take action</data><data key="edge_assertion_id">a_32652a87534643f5</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C20</data><data key="edge_json_path">None</data><data key="edge_evidence">Affected: A system is affected by a vulnerability if a user or operator of the system must take action to remediate, mitigate, or otherwise address the vulnerability.5 If a system is affected by a vulnerability, the CVSS v4.0 Base score must not be 0.0</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_0d5c2f5456764d48" source="e_605921cf37ae199c" target="e_4669078157e38ac3"><data key="edge_predicate_raw">is affected</data><data key="edge_assertion_id">a_e3659db6adb0f03a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">user or operator of the system must take action to remediate, mitigate, or otherwise address the vulnerability.5 If a system is affected by a vulnerability, the CVSS v4.0 Base score must not be 0.0</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_5a59412ab61ea461" source="e_50d78e0cd2cfca7d" target="e_7bc66a71c6cc9944"><data key="edge_predicate_raw">be evade</data><data key="edge_assertion_id">a_8bb9c314db87d80c</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Attacker: A human person that “...attempts to evade security services and violate the security policy of a system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fda7d42532a233f9" source="e_0d327d12b90b919a" target="e_7bc66a71c6cc9944"><data key="edge_predicate_raw">be evade</data><data key="edge_assertion_id">a_cdb342bea5a32d48</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Attacker: A human person that “...attempts to evade security services and violate the security policy of a system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b8b97af8a2c6d81e" source="e_5dd63c0e6e0c1501" target="e_438ff312e751bbbc"><data key="edge_predicate_raw">be produced by</data><data key="edge_assertion_id">a_9026778e46fca02c</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Chained score: The Base Score produced by scoring two or more chained vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_36d54c9c77059cd6" source="e_ab0d9123eb2746b9" target="e_106a49c8576bc28c"><data key="edge_predicate_raw">manages</data><data key="edge_assertion_id">a_9b93e99603fdec72</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumer: The security team that manages the environment in which the vulnerable product is deployed</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_733bde74eaf7ffab" source="e_02ef297f69111ff2" target="e_106a49c8576bc28c"><data key="edge_predicate_raw">is deployed</data><data key="edge_assertion_id">a_486c22558cd933a3</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Consumer: The security team that manages the environment in which the vulnerable product is deployed</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5a674bb9ec699399" source="e_3c833b981ef528af" target="e_c89600a324b62cca"><data key="edge_predicate_raw">allows</data><data key="edge_assertion_id">a_9e7af1deb5daf3a3</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Default credential: Data such as a user name and password that is initially configured and allows authentication unless it has been changed</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_d49c45b08d2f3018" source="e_8fdccadaf29ca205" target="e_b61434f3ea52eab6"><data key="edge_predicate_raw">be shared by</data><data key="edge_assertion_id">a_ea899187585295d5</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">A default credential may be shared by many systems or unique to individual systems</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_40a0913cd61fe7c2" source="e_93d8650fe6b85a54" target="e_c524e27152dbf123"><data key="edge_predicate_raw">force default credential to be</data><data key="edge_assertion_id">a_4a598a059cc0d050</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">A system may force a default credential to be changed</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_533ce99a4679a347" source="e_ba499904b33e58c1" target="e_0fcb6a1ecbd60cd9"><data key="edge_predicate_raw">is of</data><data key="edge_assertion_id">a_e51b5399203bb64d</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">A cloud (of which there could be multiple), on prem (a single or group of data centers), or a logically distinct environment like a DMZ or Development (as opposed to production)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_944c827120542122" source="e_2f54832991589014" target="e_6e4daa65dd223767"><data key="edge_predicate_raw">allows</data><data key="edge_assertion_id">a_7fd3c0a4588b48e8</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Hard-coded credential: Data such as a user name and password that is always configured, always allows authentication, and cannot be changed or disabled</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_c8806f4f88b31d4f" source="e_687cc0dc750acf40" target="e_9e02527b10de0e8e"><data key="edge_predicate_raw">reduce</data><data key="edge_assertion_id">a_2d621c365bb6764c</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Mitigation (Control): A decision, action, or practice intended to reduce the level of risk associated with one or more threat events, threat scenarios, or vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9cc5d072de5346cc" source="e_ff6ebc9ca1f015bc" target="e_9e02527b10de0e8e"><data key="edge_predicate_raw">reduce</data><data key="edge_assertion_id">a_083a192f33cf38ba</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Mitigation (Control): A decision, action, or practice intended to reduce the level of risk associated with one or more threat events, threat scenarios, or vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_22e290d8e5077379" source="e_ead7edaa4d3072c3" target="e_9e02527b10de0e8e"><data key="edge_predicate_raw">reduce</data><data key="edge_assertion_id">a_28e076c4246c49fe</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Mitigation (Control): A decision, action, or practice intended to reduce the level of risk associated with one or more threat events, threat scenarios, or vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_6b909cf0d7e3f76c" source="e_963d5ef03119d4bc" target="e_703e5aacf73947bc"><data key="edge_predicate_raw">be associated with</data><data key="edge_assertion_id">a_67c8b499a2a16e1b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Mitigation (Control): A decision, action, or practice intended to reduce the level of risk associated with one or more threat events, threat scenarios, or vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7fe5231df94c6ca6" source="e_de49ea449b555952" target="e_dda76eeedb5c35a4"><data key="edge_predicate_raw">be granted to</data><data key="edge_assertion_id">a_5bd4f451d4691a27</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Privilege: A collection of rights (typically read, write, and execute) granted to a user or user process which defines access to computing resources</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_88a7ee5e6f5a319c" source="e_de49ea449b555952" target="e_8f6ea20e4dd6a338"><data key="edge_predicate_raw">be granted to</data><data key="edge_assertion_id">a_740e68a835a7f234</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C21</data><data key="edge_json_path">None</data><data key="edge_evidence">Privilege: A collection of rights (typically read, write, and execute) granted to a user or user process which defines access to computing resources</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</d