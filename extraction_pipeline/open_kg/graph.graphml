624d84fb0" target="e_f5282588cca580e9"><data key="edge_predicate_raw">provide</data><data key="edge_assertion_id">a_7fdb8318e65f8094</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">they directly provide essential functions, then this criticality is what is important</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_128421fd5918d34b" source="e_77d2c88a71e7230d" target="e_48f8c25cd617fe07"><data key="edge_predicate_raw">is more than</data><data key="edge_assertion_id">a_0567280268e201b8</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C06</data><data key="edge_json_path">None</data><data key="edge_evidence">prevalence is more than simply counting devices or products present</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ed15337245ccd687" source="e_77d2c88a71e7230d" target="e_6a39b17b9b9f31bd"><data key="edge_predicate_raw">is more than</data><data key="edge_assertion_id">a_a9570b25661d86bd</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C06</data><data key="edge_json_path">None</data><data key="edge_evidence">prevalence is more than simply counting devices or products present</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_71f6266d4f4be1ad" source="e_5eaea8f6e0cff084" ta