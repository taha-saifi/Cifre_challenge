5" target="e_9b28c50be6e7da88"><data key="edge_predicate_raw">has CISA required action</data><data key="edge_assertion_id">a_e959e1ec82718b5f</data><data key="edge_source_id">S04</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-59310</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.cisaRequiredAction</data><data key="edge_evidence">Apply mitigations in accordance with vendor instructions, ensuring compliance with CISA’s BOD 26-04 Prioritizing Security Updates Based on Risk (see URL in Notes) guidance and CISA’s “Forensics Triage Requirements” (see URL in Notes). Follow applicable BOD 26-04 guidance for cloud services or discontinue use of the product if mitigations are unavailable. Stakeholders are responsible for evaluating each asset's internet exposure and ensuring adherence to BOD 26-04 patching guidelines.</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_af0731b526b09fa1" source="e_df01d494de3177fd" target="e_41dac8d36a021928"><data key="edge_predicate_raw">has published date</data><data key="edge_assertion_id">a_0e1eb832dec32168</data><data key="edge_source_id">S05</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-65400</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.published</data><data key="edge_evidence">published: 2026-08-06T22:18:14.533</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_be93b1d8e3753566" source="e_df01d494de3177fd" target="e_dd66c660dcd7e4ee"><data key="edge_predicate_raw">has last modified date</data><data key="edge_assertion_id">a_474c3a8f4d3acadf</data><data key="edge_source_id">S05</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-6540