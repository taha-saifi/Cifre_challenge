y="edge_json_path">None</data><data key="edge_evidence">Instead of declaring a decision point as “unknown,” CISA identifies the value that is the most reasonable assumption</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">uncertain</data></edge><edge id="oe_768c196938ddac61" source="e_6f7684418f21aa11" target="e_47869b8b12d1452e"><data key="edge_predicate_raw">identifies</data><data key="edge_assertion_id">a_29119de33ff19fc2</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Instead of declaring a decision point as “unknown,” CISA identifies the value that is the most reasonable assumption</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">uncertain</data></edge><edge id="oe_796c4c15958c3830" source="e_f06be94522d51d45" target="e_1e8fc3121cd402ea"><data key="edge_predicate_raw">change</data><data key="edge_assertion_id">a_6f6960cbca882c4b</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Such an approach requires reliable historical evidence and future events may change these</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_24cfefb9abcdd9f0" source="e_92ebed9c81e58271" target="e_1e8fc3121cd402ea"><data key="edge_predicate_raw">change</data><data key="edge_assertion_id">a_8d7bcd2810adb14c</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Such an approach requires reliable historical evidence and future events may change these</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_2d29dd8d8d1e9bb2" source="e_ac3b4679f9e0d3d3" target="e_864946b1ccee072d"><data key="edge_predicate_raw">requires</data><data key="edge_assertion_id">a_7a28fbcc7fbce564</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Such an approach requires reliable historical evidence and future events may change these</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_a510df15a542c626" source="e_ac3b4679f9e0d3d3" target="e_3f4ca4093c0a897e"><data key="edge_predicate_raw">requires</data><data key="edge_assertion_id">a_c28d804848987de3</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Such an approach requires reliable historical evidence and future events may change these</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_85c4d6f31b48a798" source="e_6a16eec4a6620da9" target="e_7f5400296a550f83"><data key="edge_predicate_raw">determines</data><data key="edge_assertion_id">a_a8310ea98043c867</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">This measure determines the present state of exploitation of the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_bf556def914b53c5" source="e_ad16450d4d7b98f8" target="e_f25e0c4aba813135"><data key="edge_predicate_raw">does predict</data><data key="edge_assertion_id">a_b2bf91e4cd269616</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">It does not predict future exploitation or</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_3c247ac457db7420" source="e_ea555680f2270bee" target="e_0a74ab6b8c124112"><data key="edge_predicate_raw">exploit</data><data key="edge_assertion_id">a_3f9b89d9849cf313</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">measure feasibility or ease of adversary development of future exploit code; rather, it acknowledges available</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_6f9916bcf6155a8d" source="e_2f8791ec645807f3" target="e_0a74ab6b8c124112"><data key="edge_predicate_raw">exploit</data><data key="edge_assertion_id">a_56517cacd6f08df3</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/def