on_id">a_ede88ffc68949eef</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">system has another unpatched vulnerability that remotely and easily gives an attacker a guest account or otherwise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ec89bce0edc6b10b" source="e_e163460c91338b08" target="e_5f8936281649808d"><data key="edge_predicate_raw">is result of</data><data key="edge_assertion_id">a_cf66d2f2087b790b</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">This is the result of “chaining”</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0de0fae387e804ef" source="e_9f4bc004f1ab89c0" target="e_ab37797b297865c8"><data key="edge_predicate_raw">be make</data><data key="edge_assertion_id">a_d89470346063f2f4</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">vulnerabilities to make exploitation automatable, as discussed further below</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_17f5ae8f385a4d4c" source="e_0651ca14b1e582f2" target="e_f26720649f642157"><data key="edge_predicate_raw">does have open connectivity to</data><data key="edge_assertion_id">a_5f87fe5c87c23125</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">Another example of a barrier is if the vulnerable component does not normally have open connectivity to the internet</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_90b09b8fe01c3bbf" source="e_0651ca14b1e582f2" target="e_f26720649f642157"><data key="edge_predicate_raw">is exposed to</data><data key="edge_assertion_id">a_e32f9ab187f7cba8</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">whether the vulnerable component is commonly exposed to the internet by other operators</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_63f2c8d6e65bbba1" source="e_0651ca14b1e582f2" target="e_f7badda21c0f35c3"><data key="edge_predicate_raw">is exposed to internet by</data><data key="edge_assertion_id">a_0c996b42b872eefa</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">whether the vulnerable component is commonly exposed to the internet by other operators</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f5aeb80e868d9965" source="e_f6498126c94c6f96" target="e_7f7f6fbf3a1e3179"><data key="edge_predicate_raw">has best understanding of</data><data key="edge_assertion_id">a_c60068af1e4ecf25</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">should capture the analyst's best understanding of plausible scenarios at the time of the analysis</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_80efcec49f2f1ae7" source="e_4a440f0d7f548662" target="e_45dd858ce0f12c6d"><data key="edge_predicate_raw">needs</data><data key="edge_assertion_id">a_48e8cb8ba1d8b08f</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">However, the actor needs prior access to the target network to exploit Vulnerability A</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_821455aef0ccc7cd" source="e_32546eab4713320e" target="e_acb458ee4b91b56d"><data key="edge_predicate_raw">be exploit</data><data key="edge_assertion_id">a_cef3c90d2e1a9913</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">However, the actor needs prior access to the target network to exploit Vulnerability A</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_bde2f287b01cab5