ositive</data><data key="edge_modality">asserted</data></edge><edge id="oe_698c258385e46275" source="e_be40be3be505e89c" target="e_d23f7f14f38261cb"><data key="edge_predicate_raw">is important variable in</data><data key="edge_assertion_id">a_6711627633a01e52</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">Scope is an important variable in the scoring decision</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a55e29a533b82865" source="e_4f99a70924824209" target="e_93d265501db78408"><data key="edge_predicate_raw">determine</data><data key="edge_assertion_id">a_900a4dad851a83a5</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">An organization can determine a vulnerability's scope by</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_151fec68284eead3" source="e_04c9b50e31e59d8c" target="e_d1f12f8915068d0a"><data key="edge_predicate_raw">affected</data><data key="edge_assertion_id">a_2b4cfa2ffaef4618</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">understanding how the boundaries of the affected system are set</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e12c89433688fa32" source="e_e7af4632d6017fc9" target="e_0cb921fff571300d"><data key="edge_predicate_raw">is analyzed as</data><data key="edge_assertion_id">a_822cbff4332ed8f4</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">presence across multiple related systems—is analyzed as one or multiple vulnerabilities will also help an organization</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e74b04fc3438d351" source="e_9da0a3af79887332" target="e_4f99a70924824209"><data key="edge_predicate_raw">help</data><data key="edge_assertion_id">a_6ee90b18c5fb04b2</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">presence across multiple related systems—is analyzed as one or multiple vulnerabilities will also help an organization</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f058786be462a63c" source="e_dbd1ba0cc63988dc" target="e_4dac9c64efc512d2"><data key="edge_predicate_raw">be scoring</data><data key="edge_assertion_id">a_1420a20472e8a768</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C02</data><data key="edge_json_path">None</data><data key="edge_evidence">CISA uses the following decision points and associated values for making vulnerability scoring decisions (outlined in</data><