0e7" target="e_36ca5f7151d21469"><data key="edge_predicate_raw">is included</data><data key="edge_assertion_id">a_3894230be8aa29f2</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">The evasion or satisfaction of authentication mechanisms or requisites is included in the Privileges Required assessment and is not considered here as a factor of relevance for Attack Complexity</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_e08de1899fe0fa9d" source="e_9bf6ead54114b2ce" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">requires target-specific circumvention to exploit</data><data key="edge_assertion_id">a_e00e037e3304a340</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">The attack requires no target-specific circumvention to exploit the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_0ddcf856b1cd4b6f" source="e_12810bde9da43506" target="e_800f8a7b26ff1b48"><data key="edge_predicate_raw">exploit</data><data key="edge_assertion_id">a_0b79fad098a6bbea</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">These include: Evasion of exploit mitigation techniques</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0d266a7507af52ab" source="e_94de2d42b3ccfc73" target="e_5ad6c123e5abaf11"><data key="edge_predicate_raw">be performed for attack to be successful For</data><data key="edge_assertion_id">a_001c7a25acfcc93f</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, circumvention of address space randomization (ASLR) or data execution prevention (DEP) must be performed for the attack to be successful</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e5adad8d434d1d2d" source="e_d1b7614c4ec2832f" target="e_5ad6c123e5abaf11"><data key="edge_predicate_raw">be performed for attack to be successful For</data><data key="edge_assertion_id">a_6cbce0a73daaa70d</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, circumvention of address space randomization (ASLR) or data execution prevention (DEP) must be performed for the attack to be successful</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c82efe2ca38774fd" source="e_94de2d42b3ccfc73" target="e_ff5a731ec7eab337"><data key="edge_predicate_raw">be performed for</data><data key="edge_assertion_id">a_734ec2bc733c6701</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, circumvention of address space randomization (ASLR) or data execution prevention (DEP) must be performed for the attack to be successful</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_99c0c28a8ae31363" source="e_d1b7614c4ec2832f" target="e_ff5a731ec7eab337"><data key="edge_predicate_raw">be performed for</data><data key="edge_assertion_id">a_c174e30d99d69810</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, circumvention of address space randomization (ASLR) or data execution prevention (DEP) must be performed for the attack to be successful</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_755175e419e72713" source="e_9bf6ead54114b2ce" target="e_417c17841add5e7d"><data key="edge_predicate_raw">be successful</data><data key="edge_assertion_id">a_d4ffe80935ca2719</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, circumvention of address space randomization (ASLR) or data execution prevention (DEP) must be performed for the attack to be successful</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_76c0675b8a5be959" source="e_7e6651e61976ac94" target="e_c00ecbf5fe9852a6"><data key="edge_predicate_raw">be needed to break crypto channel</data><data key="edge_assertion_id">a_209714704b4643d4</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">To obtain the secret the attacker must perform additional attacks or break otherwise secure measures (e.g. knowledge of a secret key may be needed to break a crypto channel)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_ff310d6fd58a172b" source="e_7e6651e61976ac94" target="e_99b081bbf7fd433b"><data key="edge_predicate_raw">be needed to break</data><data key="edge_assertion_id">a_18b00a90d9d32fa0</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">To obtain the secret the attacker must perform additional attacks or break otherwise secure measures (e.g. knowledge of a secret key may be needed to break a crypto channel)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_b06dca617a3a8d2f" source="e_537e6ab50e8f2e44" target="e_8124110a3ebec92e"><data key="edge_predicate_raw">perform additional attacks</data><data key="edge_assertion_id">a_da8ca71c55fc08cd</data><data key="edge_source_id">S50</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/specification-document</data><data key="edge_chunk_id">S50_C07</data><data key="edge_json_path">None</data><data key="edge_evidence">To obtain the secret the attacker must perform additional attacks or break otherwise secure measures (e.g. knowledge of a secret key may be needed to break a crypto channel)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_5169c9a240dea1ff" source="e_537e6ab50e8f2e44" target="e_8124110a3ebec92e"><data key