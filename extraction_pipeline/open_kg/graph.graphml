C04</data><data key="edge_json_path">None</data><data key="edge_evidence">authenticated and logged in, that usually prevents a vulnerability from being wormable</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_81b4e4be1fa84aba" source="e_1b6f531078fc8ef6" target="e_ca88e2447b7b3144"><data key="edge_predicate_raw">gives attacker</data><data key="edge_assertion_id">a_e7a26956d9eeb3e3</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">system has another unpatched vulnerability that remotely and easily gives an attacker a guest account or otherwise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8925ca0b9a06fb45" source="e_1b6f531078fc8ef6" target="e_02f0f8280e1d2c2c"><data key="edge_predicate_raw">gives attacker</data><data key="edge_assertion_id">a_afac0a790f58d03b</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sites/default/files/publications/cisa-ssvc-guide%20508c.pdf</data><data key="edge_chunk_id">S54_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">system has another unpatched vulnerability that remotely and easily gives an attacker a guest account or otherwise</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_681ce8d54c311954" source="e_1b6f531078fc8ef6" target="e_ce42f1740079c44d"><data key="edge_predicate_raw">gives attacker</data><data key="edge_assertion_id">a_ea61fedb664d88cf</data><data key="edge_source_id">S54</data><data key="edge_source_url">https://www.cisa.gov/sit