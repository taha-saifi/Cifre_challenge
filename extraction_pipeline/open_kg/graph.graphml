aw_json.vulnerabilities[0].cve.descriptions[0].value</data><data key="edge_evidence">An authentication issue was addressed with improved state management. This issue is fixed in macOS Sequoia 15.7.9, macOS Sonoma 14.8.9, macOS Tahoe 26.6.1. An attacker on the network may be able to authenticate to Screen Sharing without valid credentials.</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_baf8d5ee359eabd3" source="e_df01d494de3177fd" target="e_78a26605d5a1c1e0"><data key="edge_predicate_raw">has affected product</data><data key="edge_assertion_id">a_3783b7d16c85a19c</data><data key="edge_source_id">S05</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-65400</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.affected[0].affectedData[0].product</data><data key="edge_evidence">macOS</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_4894753808f81785" source="e_78a26605d5a1c1e0" target="e_cd9606e3c678f437"><data key="edge_predicate_raw">has vendor</data><data key="edge_assertion_id">a_3b1cbd58140737ab</data><data key="edge_source_id">S05</data><data key="edge_source_url">https://nvd.nist.gov/vuln/detail/CVE-2026-65400</data><data key="edge_chunk_id">None</data><data key="edge_json_path">raw_json.vulnerabilities[0].cve.affected[0].affectedData[0].vendor</data><data key="edge_evidence">Apple</data><data key="edge_extraction_method">structured</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1e2793c0c7c0b61e" source="e_78a26605d5a1c1e0" target="e_5f853777413d01d0"><data key="edge_predicate_raw">has affected version bound</data><data key="edge_assertion_id">a_b8956613ef01d1d9</data><data key="edge_source_id">S05</data><data ke