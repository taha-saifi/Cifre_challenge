d731fd8b108" target="e_8ea2d5e84baadda6"><data key="edge_predicate_raw">are handled in Rapid7 PoC for</data><data key="edge_assertion_id">a_0621442128cd3d36</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">We did not include requests for the JWT bypass, which are already handled in the Rapid7 PoC for CVE-2026-55040</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_7768ec0f45a96b74" source="e_be74ffef073dc8d3" target="e_21abed731fd8b108"><data key="edge_predicate_raw">did include requests for</data><data key="edge_assertion_id">a_6350f7dd67a58ba9</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">We did not include requests for the JWT bypass, which are already handled in the Rapid7 PoC for CVE-2026-55040</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_95a252e5b50960c7" source="e_83efec4166b1027d" target="e_6cb4f87c50d4ad38"><data key="edge_predicate_raw">contains</data><data key="edge_assertion_id">a_f3d8cce0e40674bf</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C04</data><data key="edge_json_path">None</data><data key="edge_evidence">The next request shows where the evil happens: This second request is the BDCM model file that contains the gadget</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c7923179d935e764" source="e_218a3c77a2b65233" target="e_90cde5114c5028dc"><data key="edge_predicate_raw">makes</data><data key="edge_assertion_id">a_d83c408279f22db9</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">We’ll pause for a minute to talk about the concept that makes the Deserialize method run: the Finder</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_561fd10e9a260844" source="e_be74ffef073dc8d3" target="e_d72508b1b551ad60"><data key="edge_predicate_raw">pause for a minute to talk about concept</data><data key="edge_assertion_id">a_884077b89390bb17</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">We’ll pause for a minute to talk about the concept that makes the Deserialize method run: the Finder</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b51b17d64b790a88" source="e_be74ffef073dc8d3" target="e_d72508b1b551ad60"><data key="edge_predicate_raw">pause</data><data key="edge_assertion_id">a_9757e04c92521b8a</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">We’ll pause for a minute to talk about the concept that makes the Deserialize method run: the Finder</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_6448d3ac92b04155" source="e_d322780a4a3f2bc1" target="e_218a3c77a2b65233"><data key="edge_predicate_raw">be talk about</data><data key="edge_assertion_id">a_00d3ce4c03ada080</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">We’ll pause for a minute to talk about the concept that makes the Deserialize method run: the Finder</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fe1c0a6e3e5880d2" source="e_673011daa181069a" target="e_412e09614a52166e"><data key="edge_predicate_raw">be run method with</data><data key="edge_assertion_id">a_4ae42a1e3e9b3503</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">We weren’t able to simply say, “hey, run this method with these arguments.” We needed to bind some method from our .NET assembly to a method that SharePoint would expect to use to perform a CRUD operation, so we chose to bind it to one of the most common options: Finder</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8a61e6b174c49572" source="e_be74ffef073dc8d3" target="e_ad16450d4d7b98f8"><data key="edge_predicate_raw">chose to bind</data><data key="edge_assertion_id">a_e18c1db859ec1bb7</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">We weren’t able to simply say, “hey, run this method with these arguments.” We needed to bind some method from our .NET assembly to a method that SharePoint would expect to use to perform a CRUD operation, so we chose to bind it to one of the most common options: Finder</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_8f4c3b6d4b62ceec" source="e_791de43fccfd7f2f" target="e_3f3e6e2f2051ffbe"><data key="edge_predicate_raw">expect method to use to perform</data><data key="edge_assertion_id">a_8770c4fa5eeca024</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">We weren’t able to simply say, “hey, run this method with these arguments.” We needed to bind some method from our .NET assembly to a method that SharePoint would expect to use to perform a CRUD operation, so we chose to bind it to one of the most common options: Finder</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_750e8c836e112260" source="e_791de43fccfd7f2f" target="e_27db1066555565aa"><data key="edge_predicate_raw">calls to fetch</data><data key="edge_assertion_id">a_19900d9215a53d4a</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">A Finder is the method SharePoint calls to fetch an entity's rows, and it fires automatically the moment someone views the associated External List</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_6c8bd07e308ad8ad" source="e_ad16450d4d7b98f8" target="e_420d83e7a647c63c"><data key="edge_predicate_raw">fires</data><data key="edge_assertion_id">a_c68ac57c32b3f8c3</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">A Finder is the method SharePoint calls to fetch an entity's rows, and it fires automatically the moment someone views the associated External List</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_20fa39f867d318f1" source="e_aa82b47092bf3bff" target="e_7e30da1dff7161e8"><data key="edge_predicate_raw">views associated External List</data><data key="edge_assertion_id">a_11c370a60a0a4fa9</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">A Finder is the method SharePoint calls to fetch an entity's rows, and it fires automatically the moment someone views the associated External List</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c04df7ec21fe2c20" source="e_333716f10a881b90" target="e_61c59219f51b481d"><data key="edge_predicate_raw">needed</data><data key="edge_assertion_id">a_be26d6b67600a32f</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">Our method needed a return value, because by convention, it has to return a collection (type: IEnumerable)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_30e4426da1372e48" source="e_ad16450d4d7b98f8" target="e_a3f531ace96a3b4e"><data key="edge_predicate_raw">has to return collection by</data><data key="edge_assertion_id">a_c37dabda050adebd</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">Our method needed a return value, because by convention, it has to return a collection (type: IEnumerable)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b3e83df9bc749aa3" source="e_ad16450d4d7b98f8" target="e_7c9c1b4b7f88a6e8"><data key="edge_predicate_raw">has to return</data><data key="edge_assertion_id">a_0733143c695d850b</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">Our method needed a return value, because by convention, it has to return a collection (type: IEnumerable)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_43d71fa9c8738e9b" source="e_142989eed857e8d9" target="e_da5a25a5e9f92b5a"><data key="edge_predicate_raw">gets SharePoint to run</data><data key="edge_assertion_id">a_101eb5904570d25d</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">So binding our Deserialize method to the Finder type and giving it an IEnumerable return value is what gets SharePoint to run it for us, just by querying the list</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_94fdc98963b5ca07" source="e_142989eed857e8d9" target="e_a1dcdd289f57b065"><data key="edge_predicate_raw">gets SharePoint to run it for</data><data key="edge_assertion_id">a_c83254af428b7529</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">So binding our Deserialize method to the Finder type and giving it an IEnumerable return value is what gets SharePoint to run it for us, just by querying the list</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fa7308ef1a26ef8a" source="e_142989eed857e8d9" target="e_a1dcdd289f57b065"><data key="edge_predicate_raw">be run it for</data><data key="edge_assertion_id">a_1b8a9e2b7aca68bb</data><data key="edge_source_id">S10</data><data key="edge_source_url">https://www.vulncheck.com/blog/cve-2026-63520-sharepoint-unsafe-type-rce</data><data key="edge_chunk_id">S10_C05</data><data key="edge_json_path">None</data><data key="edge_evidence">So binding our Deserialize method to the Finder type and giving it an IEnumerable return value is what gets SharePoint to run it for us, just by querying the list</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_cd531735d997b1df" source="e_333716f10a881b90" targ