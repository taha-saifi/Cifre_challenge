/data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_1b1be2e63e0fa1fd" source="e_dfd2e098a96fa540" target="e_57598c70746601d2"><data key="edge_predicate_raw">refer to</data><data key="edge_assertion_id">a_6e215cb5f8db129e</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Confidentiality and Integrity metrics refer to impacts that affect the data used by the service</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_12c1c14ce9292560" source="e_3f8c346f07db1f59" target="e_57598c70746601d2"><data key="edge_predicate_raw">refer to</data><data key="edge_assertion_id">a_d11a0a7ea84c72c5</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Confidentiality and Integrity metrics refer to impacts that affect the data used by the service</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_0a19d6b8b8bce282" source="e_57598c70746601d2" target="e_9111a79bb0a0398b"><data key="edge_predicate_raw">affect data used by</data><data key="edge_assertion_id">a_979ffcb0cb74d897</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Confidentiality and Integrity metrics refer to impacts that affect the data used by the service</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ee964a8ad2747f27" source="e_61641163de7ce9bc" target="e_9111a79bb0a0398b"><data key="edge_predicate_raw">be used by</data><data key="edge_assertion_id">a_2febb7ecaf318bd6</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Confidentiality and Integrity metrics refer to impacts that affect the data used by the service</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_41ddb2614334c8ca" source="e_fecae7613e5ebaab" target="e_9111a79bb0a0398b"><data key="edge_predicate_raw">refers to operation of</data><data key="edge_assertion_id">a_2a69b03b5cb7ab00</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Availability impact metric refers to the operation of the service</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_67e17c33d4a63068" source="e_c6c243b79bc80405" target="e_f03b97bb33e12414"><data key="edge_predicate_raw">allows attacker</data><data key="edge_assertion_id">a_c406a8a9e9b63b0e</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Consider a vulnerability in an Internet service such as web, email, or DNS that allows an attacker to modify or delete all web files in a directory</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b6f338fa74dea7ae" source="e_19c30ef707578bc4" target="e_f03b97bb33e12414"><data key="edge_predicate_raw">allows attacker</data><data key="edge_assertion_id">a_e762b9fabb590539</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Consider a vulnerability in an Internet service such as web, email, or DNS that allows an attacker to modify or delete all web files in a directory</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f2093dfceea39cf5" source="e_04b7de39fd95b316" target="e_f03b97bb33e12414"><data key="edge_predicate_raw">allows attacker</data><data key="edge_assertion_id">a_89e4ceeb8154e154</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Consider a vulnerability in an Internet service such as web, email, or DNS that allows an attacker to modify or delete all web files in a directory</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_edd53c7286c79de5" source="e_934c1f7b91073d1f" target="e_7da13345d3785cd2"><data key="edge_predicate_raw">be concerning</data><data key="edge_assertion_id">a_7a792d73b8a62b23</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Guidance concerning Local attacks was improved by clarifying the definitions of the Network and Adjacent values of the Attack Vector metric</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_af3f0fe58ad70697" source="e_cb7a6a37c999b95c" target="e_5b720065be23b9d9"><data key="edge_predicate_raw">was improved by</data><data key="edge_assertion_id">a_0d1b028c77599df4</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Guidance concerning Local attacks was improved by clarifying the definitions of the Network and Adjacent values of the Attack Vector metric</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1b6383178d94bf7f" source="e_cb7a6a37c999b95c" target="e_ccf48776685d1e95"><data key="edge_predicate_raw">was improved by clarifying definitions of</data><data key="edge_assertion_id">a_a3dfcfee9d48223e</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Guidance concerning Local attacks was improved by clarifying the definitions of the Network and Adjacent values of the Attack Vector metric</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_850baa62b395f9c1" source="e_d4cff6070f136c90" target="e_571bc10d653316b8"><data key="edge_predicate_raw">assess</data><data key="edge_assertion_id">a_ffdfe917dd2e84d4</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Specifically, analysts should only assess Network or Adjacent when a vulnerability is bound to the network stack</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_cae8ed99dd303f02" source="e_d4cff6070f136c90" target="e_acf7de49bb06f2fb"><data key="edge_predicate_raw">assess</data><data key="edge_assertion_id">a_578aeea70cf80eec</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Specifically, analysts should only assess Network or Adjacent when a vulnerability is bound to the network stack</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_90856964c81abae3" source="e_dbd1ba0cc63988dc" target="e_571bc10d653316b8"><data key="edge_predicate_raw">is bound to</data><data key="edge_assertion_id">a_ea13594cca5fa317</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Specifically, analysts should only assess Network or Adjacent when a vulnerability is bound to the network stack</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1e95d6ddb7328b77" source="e_190e52843903e782" target="e_2b34be9a58dff842"><data key="edge_predicate_raw">used</data><data key="edge_assertion_id">a_c831ca77d872f1e4</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, a document parsing vulnerability, which does not rely on the network in order to be exploited, should typically be assessed as Local, regardless of the method used to distribute such a malicious document (e.g., it could be a link to a website)</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_aad3dc07797d608b" source="e_3cf72a85fc7edc64" target="e_f7aca997dbe27c40"><data key="edge_predicate_raw">is designed to</data><data key="edge_assertion_id">a_ea83ba31d2847af8</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">CVSS is designed to classify and rate individual vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_12f1a9e021d9c903" source="e_3cf72a85fc7edc64" target="e_98f6fd8bc159fbdb"><data key="edge_predicate_raw">is designed</data><data key="edge_assertion_id">a_8e481fa963584abf</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">CVSS is designed to classify and rate individual vulnerabilities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f9f16b9b58b732d3" source="e_4e5e7719d8de2720" target="e_db5858cf6e7acd99"><data key="edge_predicate_raw">are exploited in course of single attack to compromise host</data><data key="edge_assertion_id">a_9e7d12058b5036d2</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">However, it is important to support the needs of the vulnerability analysis community by accommodating situations where multiple vulnerabilities are exploited in the course of a single attack to compromise a host or application</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b52aac04ef848cd6" source="e_4e5e7719d8de2720" target="e_db5858cf6e7acd99"><data key="edge_predicate_raw">are exploited in course of single attack to compromise application</data><data key="edge_assertion_id">a_d9f127ee088d3396</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">However, it is important to support the needs of the vulnerability analysis community by accommodating situations where multiple vulnerabilities are exploited in the course of a single attack to compromise a host or application</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_41a12d59084af81d" source="e_4e5e7719d8de2720" target="e_db5858cf6e7acd99"><data key="edge_predicate_raw">are exploited</data><data key="edge_assertion_id">a_a6a798324d600512</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">However, it is important to support the needs of the vulnerability analysis community by accommodating situations where multiple vulnerabilities are exploited in the course of a single attack to compromise a host or application</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_d032b35a3bf05aa1" source="e_a3911e0180115c21" target="e_2467f35e4d907781"><data key="edge_predicate_raw">be compromise</data><data key="edge_assertion_id">a_b2e79ff2cf9c9b0f</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">However, it is important to support the needs of the vulnerability analysis community by accommodating situations where multiple vulnerabilities are exploited in the course of a single attack to compromise a host or application</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e6862ac7b6fba924" source="e_a3911e0180115c21" target="e_e9457e2b248d9c8e"><data key="edge_predicate_raw">be compromise</data><data key="edge_assertion_id">a_a6ec8bce436bbf6c</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">However, it is important to support the needs of the vulnerability analysis community by accommodating situations where multiple vulnerabilities are exploited in the course of a single attack to compromise a host or application</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_30406c8c41010a18" source="e_ad16450d4d7b98f8" target="e_9f4bc004f1ab89c0"><data key="edge_predicate_raw">is responsibility When assessing chain of</data><data key="edge_assertion_id">a_54852a2de5b0e998</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When assessing a chain of vulnerabilities, it is the responsibility of the analyst to identify which vulnerabilities are combined to form the chained resulting score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_044d32d783927b92" source="e_ad16450d4d7b98f8" target="e_f6498126c94c6f96"><data key="edge_predicate_raw">is responsibility of</data><data key="edge_assertion_id">a_767f3da6d742c877</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When assessing a chain of vulnerabilities, it is the responsibility of the analyst to identify which vulnerabilities are combined to form the chained resulting score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b39725bc1251d252" source="e_9f4bc004f1ab89c0" target="e_8b9b96e6b76b1b6d"><data key="edge_predicate_raw">are combined which to form</data><data key="edge_assertion_id">a_05f6e0d90d59f6c5</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">When assessing a chain of vulnerabilities, it is the responsibility of the analyst to identify which vulnerabilities are combined to form the chained resulting score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f7e11d94c6585961" source="e_f6498126c94c6f96" target="e_8b9b96e6b76b1b6d"><data key="edge_predicate_raw">list distinct vulnerabilities along with</data><data key="edge_assertion_id">a_8375fa67fa04ccea</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The analyst should list the distinct vulnerabilities and their resulting score along with the chained resulting score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_514bbf9a8f5f836c" source="e_f6498126c94c6f96" target="e_8b9b96e6b76b1b6d"><data key="edge_predicate_raw">list resulting score along with</data><data key="edge_assertion_id">a_827b5ff353454b2d</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The analyst should list the distinct vulnerabilities and their resulting score along with the chained resulting score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_b343e73861163e3d" source="e_f6498126c94c6f96" target="e_2419de04d3138527"><data key="edge_predicate_raw">list</data><data key="edge_assertion_id">a_dd9945aaceec41ef</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The analyst should list the distinct vulnerabilities and their resulting score along with the chained resulting score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9486ec89157d068c" source="e_f6498126c94c6f96" target="e_754fa75553fa09be"><data key="edge_predicate_raw">list</data><data key="edge_assertion_id">a_f5877346b96f7d67</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The analyst should list the distinct vulnerabilities and their resulting score along with the chained resulting score</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5bd8c3e8732103da" source="e_e163460c91338b08" target="e_5ad6c123e5abaf11"><data key="edge_predicate_raw">be communicated within vulnerability disclosure notice For</data><data key="edge_assertion_id">a_7c8a3723ad0142a0</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, this may be communicated within a vulnerability disclosure notice posted on a web page</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_7b52d9f5a26671c2" source="e_e163460c91338b08" target="e_55689288f78d350c"><data key="edge_predicate_raw">be communicated within</data><data key="edge_assertion_id">a_320cf404a749772f</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, this may be communicated within a vulnerability disclosure notice posted on a web page</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_c44baa1f6251b1e3" source="e_680f176a2da1971c" target="e_d1d1aff74360e50c"><data key="edge_predicate_raw">required</data><data key="edge_assertion_id">a_c814fecf0a84f580</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">Specifically, the analyst may list generic types (or classes) of related vulnerabilities that are often chained together, or provide further descriptions of required preconditions that must exist</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_e8d325e2b4b8db61" source="e_3caae72f8fe0ae59" target="e_1ba8d72821f0a209"><data key="edge_predicate_raw">are precursors to</data><data key="edge_assertion_id">a_b36a59df76e29b20</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, one might describe how certain kinds of SQL Injection vulnerabilities are precursors to a cross-site scripting (XSS) attack, or how a particular kind of buffer overflow would grant local privileges</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_b022352e7f2e58d2" source="e_3caae72f8fe0ae59" target="e_1ba8d72821f0a209"><data key="edge_predicate_raw">are how particular kind of buffer overflow to</data><data key="edge_assertion_id">a_67ce6d133e719147</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, one might describe how certain kinds of SQL Injection vulnerabilities are precursors to a cross-site scripting (XSS) attack, or how a particular kind of buffer overflow would grant local privileges</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_99e397444f87f01b" source="e_3caae72f8fe0ae59" target="e_1f655fbcd62346af"><data key="edge_predicate_raw">are how particular kind of</data><data key="edge_assertion_id">a_2d779c8bc9b41ce1</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, one might describe how certain kinds of SQL Injection vulnerabilities are precursors to a cross-site scripting (XSS) attack, or how a particular kind of buffer overflow would grant local privileges</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_05140b9bf1fb2540" source="e_43bf1b4e6e142651" target="e_6218148a08a551d2"><data key="edge_predicate_raw">describe how</data><data key="edge_assertion_id">a_98179806ac0c267f</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, one might describe how certain kinds of SQL Injection vulnerabilities are precursors to a cross-site scripting (XSS) attack, or how a particular kind of buffer overflow would grant local privileges</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_254e9965bb513f1a" source="e_43bf1b4e6e142651" target="e_9f028491fbdc94ee"><data key="edge_predicate_raw">describe how particular kind of</data><data key="edge_assertion_id">a_cc7240e56408f667</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">For example, one might describe how certain kinds of SQL Injection vulnerabilities are precursors to a cross-site scripting (XSS) attack, or how a particular kind of buffer overflow would grant local privileges</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_3593384330c4a9d9" source="e_74c3188d796f25e9" target="e_e03222260488bb2e"><data key="edge_predicate_raw">provides minimum information necessary to warn other users without informing attackers about</data><data key="edge_assertion_id">a_04c003d17b9ff5ce</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">Listing the generic types or classes of vulnerabilities provides the minimum information necessary to warn other users, without potentially informing attackers about new exploit opportunities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_59e4a303400a4dfe" source="e_42b22dca2111584e" target="e_e03222260488bb2e"><data key="edge_predicate_raw">provides minimum information necessary to warn other users without informing attackers about</data><data key="edge_assertion_id">a_64a692c528b4a997</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">Listing the generic types or classes of vulnerabilities provides the minimum information necessary to warn other users, without potentially informing attackers about new exploit opportunities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_4fd9fef5e6172691" source="e_74c3188d796f25e9" target="e_f0789276fe127207"><data key="edge_predicate_raw">provides</data><data key="edge_assertion_id">a_36aaf594b99e9f1b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">Listing the generic types or classes of vulnerabilities provides the minimum information necessary to warn other users, without potentially informing attackers about new exploit opportunities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_e62acdfe35c3d30d" source="e_42b22dca2111584e" target="e_f0789276fe127207"><data key="edge_predicate_raw">provides</data><data key="edge_assertion_id">a_8b6dce757672810b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">Listing the generic types or classes of vulnerabilities provides the minimum information necessary to warn other users, without potentially informing attackers about new exploit opportunities</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_fdad11330e7caada" source="e_f6498126c94c6f96" target="e_041da19d8be16ae9"><data key="edge_predicate_raw">identify complete list of</data><data key="edge_assertion_id">a_2d1efd5b73a4882f</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">Alternatively, the analyst may identify (in the form of a machine readable and parsable list of vulnerabilities as CVE IDs or CWEs), a complete list of specific related vulnerabilities that are known to be (or are very likely to be) chained to one or more of the chained vulnerabilities being assessed in order to exploit an IT system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_3223a885aab332f6" source="e_041da19d8be16ae9" target="e_f141d847a09876dc"><data key="edge_predicate_raw">are known to</data><data key="edge_assertion_id">a_903c46a51f257be1</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">Alternatively, the analyst may identify (in the form of a machine readable and parsable list of vulnerabilities as CVE IDs or CWEs), a complete list of specific related vulnerabilities that are known to be (or are very likely to be) chained to one or more of the chained vulnerabilities being assessed in order to exploit an IT system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_0616e7ebc3be0b40" source="e_165a4b38301b0178" target="e_93d8650fe6b85a54"><data key="edge_predicate_raw">be assessed in to exploit</data><data key="edge_assertion_id">a_782a075207a259ed</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">Alternatively, the analyst may identify (in the form of a machine readable and parsable list of vulnerabilities as CVE IDs or CWEs), a complete list of specific related vulnerabilities that are known to be (or are very likely to be) chained to one or more of the chained vulnerabilities being assessed in order to exploit an IT system</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_4812741a4c7cba42" source="e_2900ed95d90da3e0" target="e_29f374d3ae492bbc"><data key="edge_predicate_raw">are met such as</data><data key="edge_assertion_id">a_a31eac46831ad5df</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">In the event that a vulnerability can be exploited only after other preconditions are met (such as first exploiting another vulnerability), it is acceptable to combine two or more CVSS scores to describe the chain of vulnerabilities by assessing the least-restrictive Exploitability metrics and assessing the most-impactful Impact metrics</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_00ff173d0991d7a4" source="e_c9991551dd8b6f0d" target="e_df8fab3acbb5e0a1"><data key="edge_predicate_raw">uses Exploitability to describe</data><data key="edge_assertion_id">a_f82598adf347b21e</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">The following example uses the Exploitability and Impact assessment to describe the chain</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f9554cefd93e7f91" source="e_c9991551dd8b6f0d" target="e_df8fab3acbb5e0a1"><data key="edge_predicate_raw">uses Impact assessment to describe</data><data key="edge_assertion_id">a_cc397c783ec55cf1</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">The following example uses the Exploitability and Impact assessment to describe the chain</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_35acb50145b16ddb" source="e_c9991551dd8b6f0d" target="e_8deebfd1151914f5"><data key="edge_predicate_raw">uses</data><data key="edge_assertion_id">a_4a4a2bc3d8e22adb</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">The following example uses the Exploitability and Impact assessment to describe the chain</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f4b9ee701cb7cf2b" source="e_c9991551dd8b6f0d" target="e_b2128d83716c8506"><data key="edge_predicate_raw">uses</data><data key="edge_assertion_id">a_f3ca636a03b86475</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">The following example uses the Exploitability and Impact assessment to describe the chain</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a5c2b94e5918005d" source="e_c9991551dd8b6f0d" target="e_df8fab3acbb5e0a1"><data key="edge_predicate_raw">be describe</data><data key="edge_assertion_id">a_07b9de435ff941d0</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">The following example uses the Exploitability and Impact assessment to describe the chain</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a6d7b77e3d8f1efd" source="e_ad16450d4d7b98f8" target="e_2f2483ca9ac5ab40"><data key="edge_predicate_raw">requires local low-privileged user in to</data><data key="edge_assertion_id">a_072562a36cbd9c09</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">It requires a local, low-privileged user in order to exploit</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_7b454fde11d3e161" source="e_ad16450d4d7b98f8" target="e_5962be0a3867e263"><data key="edge_predicate_raw">requires</data><data key="edge_assertion_id">a_641e5cc3befb9437</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">It requires a local, low-privileged user in order to exploit</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_4d4560e0744fafd7" source="e_0be0f187414aeb1c" target="e_9bf6ead54114b2ce"><data key="edge_predicate_raw">interacts to complete</data><data key="edge_assertion_id">a_23356ed3221a54d6</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">system with Low impacts if a local user interacts to complete the attack</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_08c235c15137e39d" source="e_a4d84477b751e022" target="e_778b18f2472fba9c"><data key="edge_predicate_raw">be described as chain of</data><data key="edge_assertion_id">a_bd22a0864622ed50</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C11</data><data key="edge_json_path">None</data><data key="edge_evidence">Given A and B, Chain C could be described as the chain of B → A,</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_639fab72e869ffb3" source="e_0499ea7efbd55c2e" target="e_fd55184986b24d5e"><data key="edge_predicate_raw">enables attacker to read files on</data><data key="edge_assertion_id">a_feb8a504f87bb48d</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">A vulnerability in a virtual machine that enables an attacker to read and/or delete files on the host operating system (perhaps even its own virtual machine) demonstrates impact to a Subsequent System (the host operating system) as well as to the Vulnerable System (the virtual machine)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_9729670459924225" source="e_0499ea7efbd55c2e" target="e_f03b97bb33e12414"><data key="edge_predicate_raw">enables attacker</data><data key="edge_assertion_id">a_21758cec48e35c0b</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">A vulnerability in a virtual machine that enables an attacker to read and/or delete files on the host operating system (perhaps even its own virtual machine) demonstrates impact to a Subsequent System (the host operating system) as well as to the Vulnerable System (the virtual machine)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_f406b43bcacc7a19" source="e_00599b254832855a" target="e_546996a8b2a435a8"><data key="edge_predicate_raw">demonstrates impact to</data><data key="edge_assertion_id">a_3b4f2a2acd71b979</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">A vulnerability in a virtual machine that enables an attacker to read and/or delete files on the host operating system (perhaps even its own virtual machine) demonstrates impact to a Subsequent System (the host operating system) as well as to the Vulnerable System (the virtual machine)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fd0270feac657f4b" source="e_ea8513731f05fb4c" target="e_10f6e726960a586b"><data key="edge_predicate_raw">be considered when</data><data key="edge_assertion_id">a_27f4387178c7c05a</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">A violation of a security boundary between microprocessor privilege levels should be considered when assessing vulnerabilities using CVSS</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_421dd89915569491" source="e_d123419ce4e3beaa" target="e_eace4ea9596e9c99"><data key="edge_predicate_raw">be running in</data><data key="edge_assertion_id">a_823a13dc41bbad76</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">User space programs’ capabilities running in lower privilege levels are typically limited in what instructions they can run and what registers they can write to even when running under operating system administrator privileges</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_a3f74ddb6be29abc" source="e_290d8da624d84fb0" target="e_599881853d4e5366"><data key="edge_predicate_raw">run</data><data key="edge_assertion_id">a_3785239d43c69e91</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">User space programs’ capabilities running in lower privilege levels are typically limited in what instructions they can run and what registers they can write to even when running under operating system administrator privileges</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_a25e1e96a62fcf9d" source="e_290d8da624d84fb0" target="e_8549d517bbb68320"><data key="edge_predicate_raw">write to even when running under</data><data key="edge_assertion_id">a_b8f7637f211430eb</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">User space programs’ capabilities running in lower privilege levels are typically limited in what instructions they can run and what registers they can write to even when running under operating system administrator privileges</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_26c505dd514efbfc" source="e_4b79c449a95384a7" target="e_7986fbdafbf03b65"><data key="edge_predicate_raw">allows</data><data key="edge_assertion_id">a_b6c5e716bf2db526</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">A vulnerability that allows a program running in a lower privilege level to break out and run arbitrary code in a higher privilege level should be considered an impact to the Vulnerable System (the microprocessor)</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_c2154080596a2d42" source="e_9aacc9fe19981b67" target="e_29c2497965656aed"><data key="edge_predicate_raw">be integrated in</data><data key="edge_assertion_id">a_aa90ac4f3d477926</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">The security boundary between secure enclaves integrated in microprocessors and the rest of operating system processes, including the operating system kernel itself, should be considered when assessing vulnerabilities using CVSS</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_19adaaf19409c04c" source="e_f29a5673e5e23112" target="e_10f6e726960a586b"><data key="edge_predicate_raw">be considered when</data><data key="edge_assertion_id">a_0ab14846fd280189</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">The security boundary between secure enclaves integrated in microprocessors and the rest of operating system processes, including the operating system kernel itself, should be considered when assessing vulnerabilities using CVSS</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_cabb2475688e62b3" source="e_dbd1ba0cc63988dc" target="e_13934297bee899c3"><data key="edge_predicate_raw">allows other processes to impact</data><data key="edge_assertion_id">a_f2ed598f3b501a65</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">A vulnerability that allows other processes to impact the confidentiality, integrity or availability of data or code in a secure enclave has impact to the Vulnerable System (the secure enclave where the exploit occurs) as well as a Subsequent System (a secure enclave impacted by the exploit outside the security boundary of the Vulnerable System)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e845e12fd3440668" source="e_dbd1ba0cc63988dc" target="e_ea2100d2276757fa"><data key="edge_predicate_raw">allows other processes to impact integrity in</data><data key="edge_assertion_id">a_48b56f5eeb8fca99</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">A vulnerability that allows other processes to impact the confidentiality, integrity or availability of data or code in a secure enclave has impact to the Vulnerable System (the secure enclave where the exploit occurs) as well as a Subsequent System (a secure enclave impacted by the exploit outside the security boundary of the Vulnerable System)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_5e59e61b65a452ae" source="e_dbd1ba0cc63988dc" target="e_ea2100d2276757fa"><data key="edge_predicate_raw">allows other processes to impact availability in</data><data key="edge_assertion_id">a_8e19b7cd1ea22cb7</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.first.org/cvss/v4.0/user-guide</data><data key="edge_chunk_id">S51_C12</data><data key="edge_json_path">None</data><data key="edge_evidence">A vulnerability that allows other processes to impact the confidentiality, integrity or availability of data or code in a secure enclave has impact to the Vulnerable System (the secure enclave where the exploit occurs) as well as a Subsequent System (a secure enclave impacted by the exploit outside the security boundary of the Vulnerable System)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_84aefcc753b27fe7" source="e_dbd1ba0cc63988dc" target="e_d139b94029983a6a"><data key="edge_predicate_raw">allows other processes to impact</data><data key="edge_assertion_id">a_305cebca33df8828</data><data key="edge_source_id">S51</data><data key="edge_source_url">https://www.