n_id">a_fefcb2f620f0f9d6</data><data key="edge_source_id">S47</data><data key="edge_source_url">https://www.first.org/epss/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Scores are generated by Empirical Security and published freely to the community</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_d5eba8656ac5cb64" source="e_930949999a48f4fc" target="e_f57a2e740d90a4cc"><data key="edge_predicate_raw">published to</data><data key="edge_assertion_id">a_d988918ebefb478b</data><data key="edge_source_id">S47</data><data key="edge_source_url">https://www.first.org/epss/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Scores are generated by Empirical Security and published freely to the community</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fd0eb2df0871b9bc" source="e_930949999a48f4fc" target="e_6b755af6ba88c7b8"><data key="edge_predicate_raw">published</data><data key="edge_assertion_id">a_6e04302d68c16ef2</data><data key="edge_source_id">S47</data><data key="edge_source_url">https://www.first.org/epss/</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">Scores are generated by Empirical Security and published freely to the community</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_45a081c1601cac73" source="e_f3927b885a9d69ec" target="e_f8af3876fc5a7264"><data key="edge_predicate_raw">are published</data><data key="edge_assertion_id">a_ef691e5828e2a7e9</data><data key="edge_source_id">S48</data><data key="edge_source_url">https://www.first.org/epss/data.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">EPSS scores are published daily, free of charge, with no registration required</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_d13d28db0cbee3f2" source="e_0b620ff3264b960b" target="e_cb39605b8d80b009"><data key="edge_predicate_raw">is designed for lookup</data><data key="edge_assertion_id">a_f8de9ca6edc41412</data><data key="edge_source_id">S48</data><data key="edge_source_url">https://www.first.org/epss/data.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">The EPSS API is designed for lookup, not bulk access</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_3cf7e5e2347369be" source="e_0b620ff3264b960b" target="e_cb39605b8d80b009"><data key="edge_predicate_raw">is designed</data><data key="edge_assertion_id">a_cb62787185565e35</data><data key="edge_source_id">S48</data><data key="edge_source_url">https://www.first.org/epss/data.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">The EPSS API is designed for lookup, not bulk access</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_c4da990cd6feb51e" source="e_57c96397bf174883" target="e_7206ad3e6be8c733"><data key="edge_predicate_raw">is querying current score for</data><data key="edge_assertion_id">a_46be37d481e6b224</data><data key="edge_source_id">S48</data><data key="edge_source_url">https://www.first.org/epss/data.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">The intended use case is querying the current score for one CVE or a small batch (e.g. enriching an incoming ticket, checking a specific vulnerability's score from a script, or integrating EPSS into a tool that surfaces scores on demand)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e20c7bf7b22c7344" source="e_57c96397bf174883" target="e_90fd5cff3a5f8213"><data key="edge_predicate_raw">is querying</data><data key="edge_assertion_id">a_f5a730872b570316</data><data key="edge_source_id">S48</data><data key="edge_source_url">https://www.first.org/epss/data.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">The intended use case is querying the current score for one CVE or a small batch (e.g. enriching an incoming ticket, checking a specific vulnerability's score from a script, or integrating EPSS into a tool that surfaces scores on demand)</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_e7f1b822d01abf7c" source="e_ad16450d4d7b98f8" target="e_1582bf11e3cea95e"><data key="edge_predicate_raw">be used for</data><data key="edge_assertion_id">a_a07a771e62c732ca</data><data key="edge_source_id">S48</data><data key="edge_source_url">https://www.first.org/epss/data.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">It should not be used for bulk downloads or to keep a local copy of all scores in sync; the daily CSV or the GitHub repository is the right mechanism for that</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_95c2ee22194720b3" source="e_6bbebf7e5c9e7b98" target="e_0dd1994901856e68"><data key="edge_predicate_raw">is right mechanism for</data><data key="edge_assertion_id">a_c28379ab7db1b4f1</data><data key="edge_source_id">S48</data><data key="edge_source_url">https://www.first.org/epss/data.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">It should not be used for bulk downloads or to keep a local copy of all scores in sync; the daily CSV or the GitHub repository is the right mechanism for that</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_fb52b08981c664fb" source="e_18a874cf00218e47" target="e_0dd1994901856e68"><data key="edge_predicate_raw">is right mechanism for</data><data key="edge_assertion_id">a_9354062165683db1</data><data key="edge_source_id">S48</data><data key="edge_source_url">https://www.first.org/epss/data.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">It should not be used for bulk downloads or to keep a local copy of all scores in sync; the daily CSV or the GitHub repository is the right mechanism for that</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">asserted</data></edge><edge id="oe_b8c4abfc26fe05be" source="e_5c980ac08d8e06db" target="e_a851f99c3690c818"><data key="edge_predicate_raw">pin request to</data><data key="edge_assertion_id">a_e087ed5207a1ff7c</data><data key="edge_source_id">S48</data><data key="edge_source_url">https://www.first.org/epss/data.html</data><data key="edge_chunk_id">None</data><data key="edge_json_path">None</data><data key="edge_evidence">You can pin a request to a past date to retrieve what the score was on that day, which is useful when reconstructing a prioritization decision</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_ae8e8a4cd0d71b08" source="e_5c980ac08d8e06db" target="e_76a5b17823bcf140"><data key="ed