_id">S52_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_ac368b210e6e63af" source="e_22e800482ee5b5fd" target="e_4058f076b2d4719d"><data key="edge_predicate_raw">consume</data><data key="edge_assertion_id">a_e72c45d3fc5bb67c</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C09</data><data key="edge_json_path">None</data><data key="edge_evidence">Since availability refers to the accessibility of information resources, attacks that consume network bandwidth, processor cycles, or disk space all impact the availability of an impacted component</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_382b2e34b3dac53d" source="e_d8d9b706557f592e" target="e_fbbdf1417a7b6e3e"><data key="edge_predicate_raw">be deny</data><data key="edge_assertion_id">a_630d46f99936028b</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Even if repeated exploitation of the vulnerability is possible, the attacker does not have the ability to completely deny service to legitimate users</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_036cdc8d56ff2d29" source="e_d8d9b706557f592e" target="e_9111a79bb0a0398b"><data key="edge_predicate_raw">be deny</data><data key="edge_assertion_id">a_47c81901c04a1c33</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Even if repeated exploitation of the vulnerability is possible, the attacker does not have the ability to completely deny service to legitimate users</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">negative</data><data key="edge_modality">possible</data></edge><edge id="oe_8cae3239446a9ea2" source="e_d558a240751fca46" target="e_eebb7de3e9bfb149"><data key="edge_predicate_raw">measure current state of</data><data key="edge_assertion_id">a_bffb8bdc6765d1be</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Temporal metrics measure the current state of exploit techniques or code availability, the existence of any patches or workarounds, or the confidence in the description of a vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_fac47aafe0c9148a" source="e_d558a240751fca46" target="e_1d5201ae87cbebb9"><data key="edge_predicate_raw">measure current state of</data><data key="edge_assertion_id">a_e2126c6987047ddc</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Temporal metrics measure the current state of exploit techniques or code availability, the existence of any patches or workarounds, or the confidence in the description of a vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_a8a2c03c5b59d6c1" source="e_0792436df44881c1" target="e_8bb9c813c88e6e71"><data key="edge_predicate_raw">is existence of</data><data key="edge_assertion_id">a_d063bb06f7dd25e1</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Temporal metrics measure the current state of exploit techniques or code availability, the existence of any patches or workarounds, or the confidence in the description of a vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_d1f5017b4406fb61" source="e_bbdc6115823dda0c" target="e_8bb9c813c88e6e71"><data key="edge_predicate_raw">is existence of</data><data key="edge_assertion_id">a_d14068075ebb63f2</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">The Temporal metrics measure the current state of exploit techniques or code availability, the existence of any patches or workarounds, or the confidence in the description of a vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_00ea374abab8d614" source="e_dd256f5f1485834f" target="e_571b5980f79720dc"><data key="edge_predicate_raw">exploit</data><data key="edge_assertion_id">a_32ce2196430393c8</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">This metric measures the likelihood of the vulnerability being attacked, and is typically based on the current state of exploit techniques, exploit code availability, or active, “in-the-wild” exploitation</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_55f7b74661748825" source="e_0a74ab6b8c124112" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">be increasing severity of</data><data key="edge_assertion_id">a_9f1686fdad94f651</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Public availability of easy-to-use exploit code increases the number of potential attackers by including those who are unskilled, thereby increasing the severity of the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_1ef133cf9028b45c" source="e_0a74ab6b8c124112" target="e_921422646cf15ec9"><data key="edge_predicate_raw">increases number of potential attackers by</data><data key="edge_assertion_id">a_3cc7d14073e58f6f</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Public availability of easy-to-use exploit code increases the number of potential attackers by including those who are unskilled, thereby increasing the severity of the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_64acb5f05acfec1e" source="e_0a74ab6b8c124112" target="e_dbd1ba0cc63988dc"><data key="edge_predicate_raw">increases number of potential attackers increasing severity of</data><data key="edge_assertion_id">a_85f05814f368e872</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Public availability of easy-to-use exploit code increases the number of potential attackers by including those who are unskilled, thereby increasing the severity of the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_04a59f384bb54cdc" source="e_0a74ab6b8c124112" target="e_b4e364ab91d013d5"><data key="edge_predicate_raw">increases number of</data><data key="edge_assertion_id">a_8eef478f17ff4717</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Public availability of easy-to-use exploit code increases the number of potential attackers by including those who are unskilled, thereby increasing the severity of the vulnerability</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">asserted</data></edge><edge id="oe_357518761b704e8f" source="e_28d1d590a1acc2e8" target="e_b513ffdf8d3f9061"><data key="edge_predicate_raw">exploit</data><data key="edge_assertion_id">a_8f277b6c403eb485</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Publication of proof-of-concept code, functional exploit code, or sufficient technical details necessary to exploit the vulnerability may follow</data><data key="edge_extraction_method">heuristic</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_1f1427b4c97c4463" source="e_a0e85d60baf1bcae" target="e_0f0dfafa6203250d"><data key="edge_predicate_raw">progress from</data><data key="edge_assertion_id">a_a3710bd770c12e78</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Furthermore, the exploit code available may progress from a proof-of-concept demonstration to exploit code that is successful in exploiting the vulnerability consistently</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_deb615de7dec0400" source="e_0aec54be8e4026b7" target="e_0a74ab6b8c124112"><data key="edge_predicate_raw">be exploit</data><data key="edge_assertion_id">a_31afd403e75139df</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document</data><data key="edge_chunk_id">S52_C10</data><data key="edge_json_path">None</data><data key="edge_evidence">Furthermore, the exploit code available may progress from a proof-of-concept demonstration to exploit code that is successful in exploiting the vulnerability consistently</data><data key="edge_extraction_method">minie</data><data key="edge_polarity">positive</data><data key="edge_modality">possible</data></edge><edge id="oe_ea7abeb7f3d8eec1" source="e_0a74ab6b8c124112" target="e_f2fffb64b360fd9e"><data key="edge_predicate_raw">is successful in</data><data key="edge_assertion_id">a_f41d7e2b7ec8194c</data><data key="edge_source_id">S52</data><data key="edge_source_url">https://www.first.org/cvss/v3.1/specification-document